const bzUsagePeriodText=function usagePeriodText(data){
 const count=Number(data?.grants||0);
 if(!count)return 'Nenhum crédito de uso vigente nesta consulta. Confira seu plano e os limites de uso.';
 const trial=Number(data.trial_grants||0),paid=Number(data.paid_grants||0);
 const label=trial===count?'Crédito de teste':paid===count?'Crédito de uso':'Créditos de uso';
 const date=value=>{const time=Date.parse(value);return Number.isFinite(time)?new Date(time).toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo'}):null};
 const start=date(data.started_at),end=date(data.ends_at);
 return label+(start?' disponível desde '+start:'.')+(end?'. Validade dos créditos com vencimento: até '+end:'.')+(data.open_ended?' Há também crédito sem vencimento definido.':'')+' Uso sujeito ao limite disponível; estas datas não confirmam plano liberado pelo admin nem ativação da operação Foto com IA.';
};(()=>{'use strict';if(window.__bzExperience1017)return;window.__bzExperience1017=true;
const $=(s,r=document)=>r.querySelector(s),all=(s,r=document)=>Array.from(r.querySelectorAll(s));
let queued=false,lastFocus=null,activeModal=null;
const text=(e,s)=>{if(e&&e.textContent!==s)e.textContent=s};
function menuClose(){all('details.public-menu[open],.site-header details[open]').forEach(d=>{d.open=false;$('summary',d)?.focus()})}
function visibleTab(){all('.fn-tabs,.rd-tabs,[role=tablist],.bz-adm-tabs').forEach(n=>{const b=$('[aria-selected=true],.on,.active,[aria-current=page]',n);if(b){const r=b.getBoundingClientRect(),p=n.getBoundingClientRect();if(r.left<p.left||r.right>p.right)n.scrollLeft+=r.left-p.left-12}})}
function modal(){const m=$('.modal-overlay .modal');if(m!==activeModal){if(!m){activeModal=null;if(lastFocus?.isConnected)lastFocus.focus();lastFocus=null;return}activeModal=m;lastFocus=document.activeElement;m.setAttribute('role','dialog');m.setAttribute('aria-modal','true');const h=$('h2,h3',m);if(h){h.id=h.id||'bz-dialog-title';m.setAttribute('aria-labelledby',h.id)}($('input:not([type=hidden]),textarea,select',m)||$('button',m)||m).focus()}}
document.addEventListener('keydown',e=>{const m=activeModal;if(e.key==='Escape'){if(m){const b=$('button[aria-label=Fechar],.modal-title button',m);if(b){e.preventDefault();b.click()}}else menuClose()}if(e.key==='Tab'&&m){const a=all('button,input,select,textarea,a[href],[tabindex="0"]',m).filter(x=>!x.disabled&&x.getClientRects().length);if(a.length){const first=a[0],last=a.at(-1);if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}}},true);
document.addEventListener('click',e=>{if(e.target.closest?.('#workspace-context-sidebar [data-view=recebimentos]')){e.preventDefault();e.stopImmediatePropagation();location.assign('/app?view=recebimento');return}const s=e.target.closest?.('.site-header summary');if(s)setTimeout(()=>{s.setAttribute('aria-label',s.parentElement.open?'Fechar menu':'Abrir menu')},0);if(e.target.closest?.('#workspace-context-sidebar button:not(.nav-group-toggle):not(.contextual-close),#workspace-context-sidebar a'))setTimeout(()=>{if(matchMedia('(max-width: 900px)').matches){const close=$('.contextual-close')||$('button[aria-label="Fechar menu"]');close?.click()}},0);setTimeout(visibleTab,0)},true);
function duration(){all('.workspace-content label').forEach(l=>{if(!/minutos|min\)/i.test(l.textContent)||l.dataset.durationHint)return;const i=$('input[type=number]',l);if(!i)return;l.dataset.durationHint='1';const hint=document.createElement('small');hint.className='bz-duration-hint';l.append(hint);const update=()=>{const n=Number(i.value);text(hint,n>0?(n%1440===0?`${n/1440} dia(s)`:n%60===0?`${n/60} hora(s)`:`${n} minutos`):'Informe o intervalo')};i.addEventListener('input',update);update()})}
function tables(){all('#bz-adm table,#bz-inshell table').forEach(t=>{if(t.closest('.bz-table-wrap,.tw'))return;const w=document.createElement('div');w.className='bz-table-wrap';w.tabIndex=0;w.setAttribute('role','region');const heading=t.closest('section,.settings-card')?.querySelector('h2,h3');w.setAttribute('aria-label',heading?.textContent||'Tabela de dados');t.before(w);w.append(t)});all('#bz-adm table').forEach(t=>{if(t.dataset.auditFilter||t.rows.length<8)return;t.dataset.auditFilter='1';const input=document.createElement('input');input.type='search';input.placeholder='Filtrar esta tabela';input.className='bz-audit-search';input.setAttribute('aria-label','Filtrar registros desta tabela');input.oninput=()=>{const q=input.value.normalize('NFD').replace(/\p{Diacritic}/gu,'').toLowerCase();Array.from(t.rows).slice(1).forEach(r=>{r.hidden=!r.textContent.normalize('NFD').replace(/\p{Diacritic}/gu,'').toLowerCase().includes(q)})};t.parentElement.before(input)})}
function publicPages(){const path=location.pathname;
 if(path==='/seguranca'){
  all('h2').filter(e=>/O que ainda não oferecemos/.test(e.textContent)).forEach(e=>text(e,'Disponibilidade e limites'));
  all('p').forEach(e=>{if(/Plus e Pro/.test(e.textContent)&&!e.children.length)text(e,e.textContent.replace('Plus e Pro','A assinatura da Biziva'))});
 }
 if(['/privacidade','/termos'].includes(path)&&!$('#bz-policy-update')){const main=$('main')||$('article')||$('body>div');if(main){const s=document.createElement('section');s.id='bz-policy-update';const h=document.createElement('h2');h.textContent='Recursos de IA e serviços conectados';const p=document.createElement('p');p.textContent='Atualizado em 17/10/2026. Pedidos de texto, imagem, áudio, vídeo, documentos e agentes podem ser processados pelos fornecedores necessários à execução. Confira o conteúdo antes de enviar e compartilhe somente dados que pode usar. A conta da API tem sessão e carteira próprias. Salvar telefone não confirma o número nem inscreve automaticamente em avisos; a confirmação ocorre pelo WhatsApp. As permissões e os limites definidos na conta continuam valendo.';s.append(h,p);main.append(s)}}
 if(path==='/pricing'){document.title='Planos e assinatura — Biziva';all('section,div').forEach(e=>{if(!/grid/.test(e.className)||e.children.length!==1)return;if(e.querySelector('button,a')&&/89,90/.test(e.textContent)){e.style.gridTemplateColumns='minmax(0, 560px)';e.style.justifyContent='center'}})}
 if(path==='/tutoriais'){all('[id]').filter(e=>e.matches('article,section,details')).forEach(e=>{if(e.dataset.auditGuide)return;e.dataset.auditGuide='1';const title=$('h2,h3,summary',e)?.textContent||'';const routes=[[/plano|uso/i,'settings'],[/equipe|aprova/i,'approvals'],[/arquivo/i,'files'],[/documento/i,'library'],[/criativo|estúdio/i,'creatives'],[/funil/i,'funil'],[/WhatsApp/i,'whatsapp'],[/produto/i,'products']];const view=routes.find(([r])=>r.test(title))?.[1];if(view){const a=document.createElement('a');a.className='bz-use-prompt';a.href='/app?view='+view;a.textContent='Abrir na Biziva';e.append(a)}})}
 if(/^\/solucoes\//.test(path)){all('article,.prompt-card').forEach(e=>{if(!/prompts/i.test(e.closest('section')?.querySelector('h2')?.textContent||'')||e.querySelector('.bz-use-prompt'))return;const body=$('p',e)?.textContent||'';if(body.length<20)return;const a=document.createElement('a');a.className='bz-use-prompt';a.href='/app?prompt='+encodeURIComponent(body.slice(0,4000));a.textContent='Usar no chat';e.append(a)})}
 all('img').filter(i=>/preview|prévia|ilustra/i.test(i.alt||'')).forEach(i=>{if(path==='/'&&matchMedia('(max-width:700px)').matches)i.style.maxHeight='120px'});
}
function agendaNav(){const sidebar=document.getElementById('workspace-context-sidebar');if(!sidebar)return;const group=Array.from(sidebar.querySelectorAll('.nav-group')).find(g=>g.querySelector('.nav-group-toggle')?.textContent.trim()==='Negócios');const items=group?.querySelector('.nav-group-items');if(!items)return;let a=sidebar.querySelector('[data-bz-agenda-nav]');if(a&&a.tagName!=='BUTTON'){a.remove();a=null}if(!a){const ref=items.querySelector('button[data-view]');a=document.createElement('button');a.type='button';a.dataset.bzAgendaNav='1';a.className=(ref?.className||'').replace(/\bactive\b/g,'').trim()+' bz-agenda';a.innerHTML='<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg><span>Agenda</span>';}const ref=items.querySelector('[data-view="funil"]');if(ref){if(ref.nextElementSibling!==a)items.insertBefore(a,ref.nextSibling)}else if(a.parentElement!==items)items.append(a);const active=['agenda','agenda-suits'].includes(new URLSearchParams(location.search).get('view'));a.classList.toggle('active',active);if(active&&a.getAttribute('aria-current')!=='page')a.setAttribute('aria-current','page');if(!active&&a.hasAttribute('aria-current'))a.removeAttribute('aria-current');}
function sync(){agendaNav();queued=false;const account=new URLSearchParams(location.search).get('view')==='settings'?$('.workspace-content'):null;if(!account)$('#bz-account-index')?.remove();if(account&&!$('#bz-account-index')){const h=$('h1',account);if(h){const nav=document.createElement('nav');nav.id='bz-account-index';nav.className='rd-tabs';nav.setAttribute('aria-label','Seções da conta');h.closest('.page-title')?.after(nav)}}if(account){const meter=$('.usage-meter',account);if(meter&&!meter.querySelector('.bz-usage-period')){const p=document.createElement('p');p.className='bz-usage-period';p.setAttribute('role','status');p.textContent='Consultando validade do uso…';meter.append(p);fetch('/api/platform-account/usage-period',{credentials:'same-origin'}).then(r=>{if(!r.ok)throw Error();return r.json()}).then(d=>{if(!p.isConnected)return;p.textContent=bzUsagePeriodText(d)}).catch(()=>{if(p.isConnected)p.textContent='Validade indisponível nesta consulta. Atualize para tentar novamente.'})}const nav=$('#bz-account-index');all('section.settings-card',account).forEach((section,i)=>{if(section.classList.contains('first-steps-resume'))return;const title=$('h2',section)?.textContent||($('input',section)?'Perfil':'');if(!title)return;section.id=section.id||'bz-account-section-'+i;if(nav&&!nav.querySelector('a[href="#'+section.id+'"]')){const a=document.createElement('a');a.href='#'+section.id;a.textContent=title;nav.append(a)}})}const current=new URLSearchParams(location.search).get('view');const titles={admin:'Painel Admin',financeiro:'Financeiro',recebimento:'Dados para recebimento',api:'API empresarial',prospectar:'Prospectar'};if(titles[current]&&document.title!==titles[current]+' — Biziva')document.title=titles[current]+' — Biziva';all('#bz-adm td,#bz-inshell td').forEach(e=>{if(e.dataset.bzReadable)return;const raw=e.textContent.trim();if(raw.length>80&&/^[{[]/.test(raw)){try{JSON.parse(raw);const d=document.createElement('details'),summary=document.createElement('summary'),pre=document.createElement('pre');summary.textContent='Ver detalhes técnicos';pre.textContent=raw;d.append(summary,pre);e.replaceChildren(d);e.dataset.bzReadable='1';return}catch{}}const head=e.closest('table')?.rows[0]?.cells[e.cellIndex]?.textContent||'';const labels={started:'Iniciada',completed:'Concluída',failed:'Falhou',registration:'Em análise',active:'Ativo',warning:'Atenção'};if(/status|situa/i.test(head)&&labels[raw]){e.title=raw;e.textContent=labels[raw];e.dataset.bzReadable='1'}});all('#bz-adm td,#bz-adm strong').forEach(e=>{if(e.children.length||e.dataset.bzMoney)return;const raw=e.textContent.trim();if(!/^R\$\s*-?[\d.,]+$/.test(raw))return;const n=Number(raw.replace(/[^\d,.-]/g,'').replace(/\./g,'').replace(',','.'));if(!Number.isFinite(n))return;e.title='Precisão contábil: '+raw;e.dataset.bzMoney='1';text(e,n!==0&&Math.abs(n)<.01?(n<0?'−':'')+'Menos de R$ 0,01':n.toLocaleString('pt-BR',{style:'currency',currency:'BRL',maximumFractionDigits:2}))});all('.resource-card h3,.resource-card strong,.history-title').forEach(e=>{if(!e.title)e.title=e.textContent});modal();duration();tables();publicPages();visibleTab();all('.site-header summary').forEach(s=>{const label=s.parentElement.open?'Fechar menu':'Abrir menu';if(s.getAttribute('aria-label')!==label)s.setAttribute('aria-label',label)});all('.workspace-content button').forEach(b=>{if(!b.textContent.trim()&&!b.getAttribute('aria-label')&&b.title)b.setAttribute('aria-label',b.title)})}
function schedule(){if(!queued){queued=true;requestAnimationFrame(sync)}}
new MutationObserver(schedule).observe(document.documentElement,{childList:true,subtree:true});addEventListener('resize',schedule);addEventListener('popstate',schedule);sync();
})();
