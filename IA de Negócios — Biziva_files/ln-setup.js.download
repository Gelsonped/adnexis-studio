(()=>{if(window.__bzLnSetup)return;window.__bzLnSetup=1;
/* UIFIN (t289u/t291u/t292u): página separada /app/ln-licenca removida (redireciona para cá); status de cada passo num selo compacto (sem avisos empilhados); checkbox dos chips não esmaga o texto no celular.
   LNLIC8: painel genérico de operação de licença, cópia fiel do "Configurar operação" do Foto com IA (BzPhotoOperation).
   Mesmas classes (bz-photo-operation, bz-photo-head, bzpo-grid, bzpo-card, bzpo-check, bzpo-chip, bzpo-notice, bzpo-status, bzpo-muted),
   mesmo CSS, abre na própria tela Produtos (mesma aba). Reuso: window.__bzLicenseOp(cfg) para qualquer licença. */
const PHOTO_CSS='.bz-photo-operation{grid-column:1/-1;width:100%;min-width:0;margin-bottom:12px;color:#f2e9dc}.bz-photo-head{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 24px;border:1px solid #d4b88c30;border-radius:18px;background:radial-gradient(ellipse at 0 0,#57442b44,transparent 70%),#171513}.bz-photo-head h2{font-size:25px;letter-spacing:-.035em;margin:5px 0}.bz-photo-head p{margin:5px 0;color:#b6aa9a;line-height:1.5;font-size:14px}.bz-photo-head small{color:#d4b88c;font-size:10px;letter-spacing:.16em;text-transform:uppercase}.bz-photo-head button{min-height:44px}.bzpo-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;margin-top:20px}.bzpo-card{min-width:0;padding:24px;border:1px solid #d4b88c2b;border-radius:18px;background:linear-gradient(145deg,#211d19,#141211);box-shadow:0 12px 32px #0002}.bzpo-card h3{font-size:21px;margin:0 0 10px;letter-spacing:-.03em}.bzpo-card p{font-size:14px;line-height:1.65;color:#b6aa9a}.bzpo-card label{display:block;font-size:14px;margin:15px 0 7px}.bzpo-card input:not([type=checkbox]),.bzpo-card select{box-sizing:border-box;width:100%;min-height:48px;padding:12px 14px;background:#100e0d;color:#f5ecdf;border:1px solid #d4b88c33;border-radius:10px;font:inherit}.bzpo-card .bzpo-check{display:flex;gap:12px;align-items:flex-start;line-height:1.6}.bzpo-check input{width:18px;height:18px;flex-shrink:0;margin-top:3px;accent-color:#cc1432}.bzpo-check>input[type=checkbox]{width:18px!important;min-width:18px!important;max-width:18px!important;height:18px!important;flex:0 0 18px!important;padding:0!important;margin:3px 0 0!important;display:inline-block!important}.bzpo-check>span{flex:1 1 auto;min-width:0}.bzpo-chip{padding:15px;border:1px solid #d4b88c2b;border-radius:12px;background:#ffffff03;overflow-wrap:anywhere}.bzpo-chip span{display:grid;gap:3px}.bzpo-check.bzpo-chip{display:grid!important;grid-template-columns:18px minmax(0,1fr)!important;column-gap:12px!important;align-items:start!important;overflow-wrap:normal!important;word-break:normal!important}.bzpo-check.bzpo-chip>span{display:flex!important;flex-direction:column!important;gap:3px!important;min-width:0!important;width:auto!important;max-width:100%!important}.bzpo-chip .bzpo-chip-num{display:block!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;word-break:keep-all!important;overflow-wrap:normal!important;font-weight:600;min-width:0;max-width:100%}.bzpo-chip small{display:block;overflow-wrap:anywhere}.bzpo-chip small{color:#b6aa9a}.bzpo-card button{min-height:48px;width:100%;margin-top:12px}.bzpo-card small{font-size:12px;line-height:1.6;color:#b6aa9a}.bzpo-notice{padding:13px 15px;margin-top:14px;border:1px solid #d4b88c40;border-radius:11px;font-size:14px;line-height:1.6;overflow-wrap:anywhere}.bzpo-notice.success{color:#a5e7bd;background:#214a3438;border-color:#65c99155}.bzpo-notice.success:before{content:"✓ ";font-weight:700}.bzpo-notice.error{color:#ffb5ba;background:#70263438;border-color:#f1717959}.bzpo-notice.error:before{content:"! ";font-weight:700}.bzpo-status{display:inline-block;font-size:12px;color:#a5e7bd;border:1px solid #65c99155;border-radius:20px;padding:5px 10px}.bzpo-orders{grid-column:1/-1}.bzpo-muted{color:#b6aa9a;font-size:14px;padding:16px 0}.bzpo-card a{color:#e4c49a}.bzpo-card button:disabled{opacity:.45;cursor:wait}@media(max-width:750px){.bz-photo-head{align-items:flex-start;flex-direction:column;padding:20px 18px;gap:14px}.bz-photo-head h2{font-size:23px}.bz-photo-head button{width:100%}.bzpo-grid{grid-template-columns:minmax(0,1fr);gap:16px;margin-top:16px}.bzpo-card{padding:20px 18px}}';
const EXTRA='.bz-lic-operation .bzpo-status{margin:0 0 6px}.bz-lic-operation .bzpo-status.pending{color:#f3c98b;border-color:#d4b88c66;background:#57442b2e}.bz-lic-operation .bzpo-hint{margin:6px 0 0;font-size:13px;line-height:1.5;color:#d9c6a6}.bz-lic-operation .bzpo-card>a{display:inline-block;margin:10px 0 4px}.bz-lic-operation .bzpo-chip small{display:block}.bz-lic-operation .bzpo-actions{display:grid;gap:10px}.bz-lic-operation .bzpo-actions .button{margin-top:0}.bz-lic-operation .bzpo-notice p{margin:0 0 10px}';
const h=(tag,props,...kids)=>{const e=document.createElement(tag);for(const [k,v] of Object.entries(props||{})){if(v==null||v===false)continue;if(k==='className')e.className=v;else if(k==='text')e.textContent=v;else if(k.startsWith('on'))e.addEventListener(k.slice(2).toLowerCase(),v);else if(k in e&&typeof v!=='string')e[k]=v;else e.setAttribute(k,v===true?'':v)}for(const c of kids.flat())if(c!=null&&c!==false)e.append(c);return e};
const mkOp=cfg=>{let open=false,data=null,busy=false,pending=false,uncertain=false,error='',fb={},sel=null,ack=false,pix={type:'cpf',key:'',beneficiary:''},robot=null,el=null;
 const isReq=()=>new URLSearchParams(location.search).get('license')===cfg.param;
 const request=async body=>{const ctl=new AbortController(),t=setTimeout(()=>ctl.abort(),25000);try{const r=await fetch(cfg.api,{method:body?'POST':'GET',credentials:'same-origin',cache:'no-store',signal:ctl.signal,headers:body?{'content-type':'application/json'}:{},body:body?JSON.stringify(body):undefined});let d;try{d=await r.json()}catch{throw Error('A resposta não pôde ser lida. Recarregue esta configuração para conferir.')}if(!r.ok)throw Error(d.error||'Não foi possível concluir esta ação.');return d}catch(e){if(e.name==='AbortError'||e instanceof TypeError){if(body)uncertain=true;throw Error('A conexão não confirmou o resultado. Recarregue esta configuração antes de repetir.')}throw e}finally{clearTimeout(t)}};
 const apply=d=>{data=d;sel=(d.chips||[]).filter(c=>c.selected).map(c=>c.id);robot=!!d.robot;if(d.pix){pix={type:d.pix.type||'cpf',key:'',beneficiary:d.pix.beneficiary||''}}};
 const load=async()=>{error='';busy=true;render();try{apply(await request());uncertain=false}catch(e){error=e.message}finally{busy=false;render()}};
 const mutate=async(body,scope,msg)=>{if(pending||uncertain)return;pending=true;busy=true;fb={scope,tone:'info',text:'Salvando…'};render();try{apply(await request(body));fb={scope,tone:'success',text:msg};if(scope==='pix'){pix.key='';ack=false}}catch(e){fb={scope,tone:'error',text:e.message}}finally{pending=false;busy=false;render()}};
 const notice=s=>fb.scope===s?h('div',{className:'bzpo-notice '+fb.tone,role:fb.tone==='error'?'alert':'status',text:fb.text}):null;
 const setOpen=v=>{open=v;const u=new URL(location.href);if(v)u.searchParams.set('license',cfg.param);else u.searchParams.delete('license');history.replaceState(history.state,'',u);if(v){if(!data&&!busy)load();else render()}else{render();scrollTo({top:0,behavior:'smooth'})}};
 const head=()=>h('header',{className:'bz-photo-head'},h('div',null,h('small',{text:'Sua operação · '+cfg.label}),h('h2',{text:open?'Configure e comece a vender':cfg.title}),h('p',{text:cfg.sub||'Pix → WhatsApp → ativação. Tudo aqui em Produtos.'})),h('button',{type:'button',className:open?'button secondary':'button primary',onClick:()=>setOpen(!open),text:open?'← Voltar aos produtos':'Configurar operação'}));
 const field=(k,label,max)=>h('label',null,label,h('input',{value:pix[k],required:true,maxLength:max,autocomplete:'off',disabled:busy,name:k,onInput:e=>{pix[k]=e.target.value;ack=false;fb={}}}));
 const body=()=>{const d=data,out=[];
  if(error||uncertain)out.push(h('div',{className:'bzpo-notice error',role:'alert'},h('p',{text:error||'Consulte o resultado antes de repetir a ação.'}),h('button',{type:'button',className:'button secondary',disabled:busy,onClick:load,text:'Recarregar configuração'})));
  if(!d){out.push(h('p',{className:'bzpo-muted',role:'status',text:busy?'Carregando sua configuração…':'Recarregue para consultar sua configuração.'}));return out}
  if(!d.enrolled){out.push(h('div',{className:'bzpo-card'},h('h3',{text:'Licença não encontrada'}),h('p',{text:cfg.notEnrolled})));return out}
  const active=d.state==='active'&&d.operationEnabled;
  const chips=d.chips||[],pixSaved=!!d.pix,chipsReady=sel.length>0&&sel.some(id=>chips.some(c=>c.id===id&&c.connected)),ready=pixSaved&&chipsReady;
  const W={pix:[],whatsapp:[],activation:[]};for(const w of d.warnings||[]){const t=String(w||'');if(!t)continue;(/\bpix\b/i.test(t)?W.pix:/chip|whatsapp/i.test(t)?W.whatsapp:W.activation).push(t)}
  const badge=(ok,okText,pendText)=>h('span',{className:'bzpo-status'+(ok?'':' pending'),'data-step-status':ok?'ok':'pending',text:ok?okText:pendText});
  const hints=k=>W[k].map(t=>h('p',{className:'bzpo-hint',role:'status',text:t}));
  const pixForm=h('form',{className:'bzpo-card',onSubmit:e=>{e.preventDefault();mutate({action:'pix',type:pix.type,key:pix.key,beneficiary:pix.beneficiary,acknowledged:ack},'pix','Pix salvo para esta operação. Selecione o WhatsApp e ative ao lado.')}},
   h('h3',{text:'1. Seu Pix'}),badge(pixSaved,'Pix salvo','Pix pendente'),...hints('pix'),h('p',{text:'Esta chave será usada somente no seu funil deste produto. Ela não altera outras vendas nem é copiada de outro produtor.'}),
   pixSaved?h('p',{className:'bzpo-hint',text:'Chave salva: '+d.pix.type+' '+d.pix.key+' — '+d.pix.beneficiary}):null,
   h('label',null,'Tipo de chave',h('select',{name:'type',disabled:busy,onChange:e=>{pix.type=e.target.value;ack=false}},...[['cpf','CPF'],['cnpj','CNPJ'],['email','E-mail'],['phone','Telefone (+55)'],['random','Chave aleatória']].map(([v,l])=>h('option',{value:v,selected:pix.type===v,text:l})))),
   field('key','Chave Pix',254),field('beneficiary','Nome do favorecido',128),
   h('label',{className:'bzpo-check'},h('input',{type:'checkbox',name:'ack',required:true,checked:ack,disabled:busy,onChange:e=>{ack=e.target.checked}}),'Confirmo que a chave está correta e pertence ao titular que receberá minhas vendas.'),
   h('small',{text:'Salvar não verifica titularidade no banco. Um comprovante será analisado como evidência e não confirma sozinho que o dinheiro entrou.'}),
   h('button',{className:'button primary',disabled:busy||uncertain,text:'Salvar Pix'}),notice('pix'));
  const waForm=h('form',{className:'bzpo-card',onSubmit:e=>{e.preventDefault();if(!pixSaved){fb={scope:'whatsapp',tone:'error',text:'Salve seu Pix antes de ativar no WhatsApp.'};render();return}mutate({action:'connect_activate',connectionIds:sel},'whatsapp','Operação ativada no WhatsApp.')}},
   h('h3',{text:'2. Seu WhatsApp'}),badge(active,'Configuração ativada',chipsReady?'Pronto para ativar':'WhatsApp pendente'),...hints('whatsapp'),!ready&&!active?h('p',{role:'status',text:!pixSaved?'Salve seu Pix para continuar.':'Conecte e selecione um WhatsApp disponível para ativar.'}):null,
   h('p',{text:'Selecione os chips que atenderão este produto.'}),
   chips.length?chips.map(c=>h('label',{className:'bzpo-check bzpo-chip'},h('input',{type:'checkbox',value:c.id,checked:sel.includes(c.id),disabled:busy,onChange:e=>{sel=e.target.checked?[...sel,c.id]:sel.filter(x=>x!==c.id);render()}}),h('span',null,h('b',{className:'bzpo-chip-num',title:c.label||c.phone||'Chip',text:c.label||c.phone||'Chip'}),c.phone&&c.label&&String(c.label)!==String(c.phone)?h('b',{className:'bzpo-chip-num',text:c.phone}):null,h('small',{text:(c.connected?'Conectado':'Precisa conectar pelo QR Code')+(c.otherFunnel?' · hoje atende: '+c.otherFunnel:'')})))):h('p',{text:'Nenhum chip na sua conta. Conecte um chip pelo QR Code primeiro.'}),
   h('a',{href:'/app?view=whatsapp',text:'Conectar ou gerenciar WhatsApp'}),
   h('p',null,h('small',{text:'Cada chip atende apenas um produto e um funil. Chips vinculados a outro funil podem ser trocados para este; chips de outra conta não podem ser usados.'})),
   h('div',{className:'bzpo-actions'},h('button',{type:'button',className:'button secondary',disabled:busy||uncertain||!sel.length,onClick:()=>mutate({action:'connect',connectionIds:sel},'whatsapp','Chips salvos.'),text:'Salvar chips'}),h('button',{className:'button primary',disabled:busy||uncertain||!ready,text:'Ativar no WhatsApp'})),notice('whatsapp'));
  const actCard=h('div',{className:'bzpo-card'},h('h3',{text:'3. Ativação'}),badge(active,'Operação ativa','Aguardando ativação'),...hints('activation'),h('p',{role:'status',text:active?'Operação ativa: o funil está publicado e atendendo.':'Operação aguardando configuração.'}),
   h('label',{className:'bzpo-check'},h('input',{type:'checkbox',name:'robot',checked:!!robot,disabled:busy||uncertain,onChange:e=>{const on=e.target.checked;mutate({action:'robot',on},'robot',on?'Robô ligado.':'Robô desligado.')}}),'Robô ligado'),
   h('a',{href:'/app?view=funil',text:'Abrir meus funis'}),notice('robot'));
  out.push(h('div',{className:'bzpo-grid'},pixForm,waForm,actCard));return out};
 const render=()=>{if(!el)return;const focus=document.activeElement&&el.contains(document.activeElement)?document.activeElement.name:null;el.className='bz-photo-operation bz-lic-operation '+cfg.cls+(open?' is-open':'');el.replaceChildren(h('style',{text:PHOTO_CSS+EXTRA}),head(),...(open?body():[]));for(const x of document.querySelectorAll('section.bz-photo-operation:not(.bz-lic-operation)'))x.style.display=open?'none':'';if(focus){const f=el.querySelector('[name="'+focus+'"]');if(f)f.focus()}};
 const build=()=>{el=h('section',{id:cfg.id});render();return el};
 return {build,get el(){return el},get open(){return open},setOpen,isReq};
};
window.__bzLicenseOp=mkOp;
const LN=mkOp({id:'bzLnSetup',cls:'bz-ln-operation',param:'ln',label:'Serviços Financeiros',title:'Seu atendimento de serviços financeiros com IA',api:'/api/ln-license/setup',notEnrolled:'Ative a licença Serviços Financeiros pelo link recebido antes de configurar a operação.'});
let st=null,busy=false,next=0,tries=0;
const anchor=()=>{const inNav=x=>x.closest('#workspace-context-sidebar, nav, aside, [role="navigation"]');const ph=[...document.querySelectorAll('section.bz-photo-operation')].find(x=>!x.classList.contains('bz-lic-operation')&&!inNav(x));if(ph)return {after:ph};const hs=[...document.querySelectorAll('h1,h2,h3,h4,p,span,div,small,strong')].filter(x=>x.children.length===0&&/^\s*meus produtos\s*$/i.test(x.textContent||'')&&!inNav(x));if(hs[0])return {before:hs[0]};return null};
const retry=()=>{if(st&&st.failed){st=null;tries=0;next=0}};
const loadSt=async()=>{if(busy||Date.now()<next)return;busy=true;try{const r=await fetch('/api/ln-license',{credentials:'same-origin',cache:'no-store'});if(r.ok){st=await r.json();tries=0}else if(r.status===404){st={final:true}}else{tries++;if(tries>=8){st={failed:true}}else next=Date.now()+Math.min(30000,1500*2**tries)}}catch{tries++;if(tries>=8)st={failed:true};else next=Date.now()+Math.min(30000,1500*2**tries)}finally{busy=false}};
let autoOpened=false;
const tick=async()=>{try{const q=new URLSearchParams(location.search);if(location.pathname!=='/app'||q.get('view')!=='products'){document.getElementById('bzLnSetup')?.remove();return}if(st===null)await loadSt();if(!st||!st.licenseOwned)return;/*UIFIN2 (dono 3x): página antiga do produto da licença não existe mais => painel inline*/if(st.productId&&(q.get('productId')===st.productId||q.get('product')===st.productId)){location.replace('/app?view=products&license=ln');return}const a=anchor();if(!a){document.getElementById('bzLnSetup')?.remove();return}let el=document.getElementById('bzLnSetup');if(a.after&&a.after.classList.contains('is-open')&&!LN.open){el?.remove();return}if(!el)el=LN.el||LN.build();if(a.after){if(a.after.nextElementSibling!==el)a.after.after(el)}else if(a.before.previousElementSibling!==el)a.before.before(el);if(!autoOpened&&LN.isReq()){autoOpened=true;LN.setOpen(true);try{const r=el.getBoundingClientRect();if(r.top<0||r.top>innerHeight*.6){el.style.scrollMarginTop='200px';el.scrollIntoView({block:'start'})}}catch{}}}catch{}};
addEventListener('pageshow',e=>{if(e.persisted)retry()});document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible')retry()});setInterval(tick,1500);tick()})();