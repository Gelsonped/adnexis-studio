(()=>{let queued=false;function mount(){queued=false;if(new URL(location.href).searchParams.get('view')!=='dashboard')return;const panel=document.querySelector('.rd-dashboard');if(!panel||panel.querySelector('[data-sales-tracking-link]'))return;const a=document.createElement('a');a.dataset.salesTrackingLink='1';a.href='/app?view=sales';a.textContent='Rastreamento de vendas · Pix e Meta →';a.style.cssText='display:block;padding:16px 20px;margin:12px 0;border:1px solid #a83a46;border-radius:14px;color:inherit;text-decoration:none;font-weight:600;background:rgba(165,35,60,.08)';panel.prepend(a)}new MutationObserver(()=>{if(!queued){queued=true;requestAnimationFrame(mount)}}).observe(document.documentElement,{childList:true,subtree:true});mount()})();