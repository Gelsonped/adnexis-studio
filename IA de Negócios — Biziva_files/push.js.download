(()=>{
let mounted=false,busy=false,config=null,device=null,registration=null;
const $=id=>document.getElementById(id),status=t=>{if($('bz-push-status'))$('bz-push-status').textContent=t};
const ios=()=>/iPad|iPhone|iPod/.test(navigator.userAgent)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1),standalone=()=>matchMedia('(display-mode: standalone)').matches||navigator.standalone===true;
async function api(path,data){const c=new AbortController(),t=setTimeout(()=>c.abort(),12000);try{const r=await fetch('/api/push/'+path,{method:data?'POST':'GET',credentials:'same-origin',cache:'no-store',signal:c.signal,headers:data?{'content-type':'application/json'}:{},body:data?JSON.stringify(data):undefined});const b=await r.json();if(!r.ok)throw Error(b.error||'Não foi possível concluir.');return b}catch(e){if(c.signal.aborted)throw Error('A conexão demorou para confirmar. Confira sua conexão e atualize a página; nenhum teste será reenviado automaticamente.');throw e}finally{clearTimeout(t)}}
function b64(s){return Uint8Array.from(atob(s.replace(/-/g,'+').replace(/_/g,'/')),c=>c.charCodeAt(0))}
async function refresh(){config=await api('config');const old=await navigator.serviceWorker.getRegistration('/');if(old&&new URL(old.active?.scriptURL||location.href).pathname==='/biziva-push-sw.js'){registration=old;const sub=await old.pushManager.getSubscription();if(sub){const bytes=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(sub.endpoint));const id=Array.from(new Uint8Array(bytes),n=>n.toString(16).padStart(2,'0')).join('');device=config.devices.find(d=>d.id===id)||null}}draw()}
function draw(){const on=!!device;$('bz-push-enable').hidden=on;$('bz-push-disable').hidden=!on;$('bz-push-test').hidden=!on;$('bz-push-amount').checked=!!device?.show_amount;status(on?'Avisos ativos neste dispositivo.':'Ative para receber avisos de novas vendas confirmadas.');if(ios()&&!standalone())status('No iPhone: toque em Compartilhar → Adicionar à Tela de Início. Abra a Biziva pelo ícone e toque em Ativar avisos.');else if(!('Notification'in window)||!('PushManager'in window))status('Este navegador não suporta os avisos. Abra a Biziva em um navegador compatível.');else if(Notification.permission==='denied')status('As notificações estão bloqueadas. Libere a Biziva nas configurações do navegador/celular.')}
async function run(fn){if(busy)return;busy=true;document.querySelectorAll('#bz-push-card button').forEach(b=>b.disabled=true);try{await fn()}catch(e){status(e.message)}finally{busy=false;document.querySelectorAll('#bz-push-card button').forEach(b=>b.disabled=false)}}
async function testNotification(){const q=await api('test',{id:device.id});status('Teste solicitado. Aguardando confirmação do navegador deste dispositivo…');for(let n=0;n<12;n++){await new Promise(r=>setTimeout(r,2000));if(!$('bz-push-card')?.isConnected)return;const s=await api('status?id='+encodeURIComponent(q.id));if(s.openedAt){status('Notificação aberta neste dispositivo.');return}if(s.shownAt){status('O navegador confirmou a exibição do teste. Confira a central de notificações do celular.');return}if(['expired','failed','cancelled'].includes(s.state)){status(s.state==='expired'?'A inscrição expirou. Ative os avisos novamente neste dispositivo.':'O teste não foi aceito. Confira a conexão e tente um novo teste quando estiver pronto.');return}}status('Ainda sem confirmação de exibição. Confira as permissões, a conexão e a central de notificações. O teste não será reenviado automaticamente.')}
async function enable(){if(ios()&&!standalone()){draw();return}if(!('serviceWorker'in navigator)||!('PushManager'in window)||!('Notification'in window))throw Error('Navegador sem suporte a notificações.');const permission=await Notification.requestPermission();if(permission!=='granted')throw Error('Permita as notificações para ativar os avisos.');if(!config)config=await api('config');const existing=await navigator.serviceWorker.getRegistration('/');if(existing&&new URL(existing.active?.scriptURL||location.href).pathname!=='/biziva-push-sw.js')throw Error('Este navegador já tem outra instalação da Biziva. Atualize a página ou fale com o suporte.');registration=await navigator.serviceWorker.register('/biziva-push-sw.js',{scope:'/',updateViaCache:'none'});registration=await navigator.serviceWorker.ready;let sub=await registration.pushManager.getSubscription();if(!sub)sub=await registration.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:b64(config.publicKey)});device=await api('subscribe',{subscription:sub.toJSON(),acknowledged:true,showAmount:$('bz-push-amount').checked});device.show_amount=device.showAmount?1:0;draw()}
function mount(){if(!document.querySelector('.rd-dashboard')){mounted=false;return}if($('bz-push-card'))return;const card=document.createElement('section');card.id='bz-push-card';card.setAttribute('aria-label','Avisos de vendas');card.style.cssText='padding:18px 20px;margin:12px 0;border:1px solid #67434a;border-radius:14px;color:inherit;background:rgba(165,35,60,.06)';card.innerHTML='<div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap"><strong>🔔 Avisos de vendas no celular</strong><span style="font-size:12px;opacity:.7">Sem baixar aplicativo</span></div><p id="bz-push-status" role="status" style="font-size:14px;line-height:1.6;margin:10px 0">Carregando…</p><label style="display:block;font-size:13px;margin:10px 0"><input type="checkbox" id="bz-push-amount"> Mostrar o valor na tela de bloqueio</label><div style="display:flex;gap:8px;flex-wrap:wrap"><button id="bz-push-enable" type="button">Ativar avisos</button><button id="bz-push-test" type="button" hidden>Enviar notificação de teste</button><button id="bz-push-disable" type="button" hidden>Desativar neste dispositivo</button></div><small style="display:block;margin-top:10px;opacity:.65">Somente vendas confirmadas. Comprovantes lidos pela IA aguardam confirmação do responsável. Os avisos dependem da conexão e das configurações do celular.</small>';card.querySelectorAll('button').forEach(b=>b.style.cssText='padding:10px 14px;border:1px solid #a83a46;border-radius:9px;background:transparent;color:inherit;cursor:pointer;font:inherit;font-size:13px');$('bz-push-enable');document.querySelector('.rd-dashboard').prepend(card);$('bz-push-enable').onclick=()=>run(enable);$('bz-push-test').onclick=()=>run(testNotification);$('bz-push-disable').onclick=()=>run(async()=>{await api('disable',{id:device.id});const s=await registration?.pushManager.getSubscription();await s?.unsubscribe();device=null;draw()});$('bz-push-amount').onchange=()=>{if(device)run(async()=>{const s=await registration.pushManager.getSubscription();await api('subscribe',{subscription:s.toJSON(),acknowledged:true,showAmount:$('bz-push-amount').checked});device.show_amount=$('bz-push-amount').checked?1:0})};mounted=true;if('serviceWorker'in navigator)refresh().catch(e=>status(e.message));else draw()}
if('serviceWorker'in navigator)navigator.serviceWorker.getRegistration('/').then(r=>{if(r&&new URL(r.active?.scriptURL||location.href).pathname==='/biziva-push-sw.js')return r.update()}).catch(()=>{});
let queued=false;new MutationObserver(()=>{if(!queued){queued=true;requestAnimationFrame(()=>{queued=false;mount()})}}).observe(document.documentElement,{childList:true,subtree:true});mount();
})();