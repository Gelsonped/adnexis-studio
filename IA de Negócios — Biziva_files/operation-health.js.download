(()=>{if(window.__bzHealth)return;window.__bzHealth=1;let busy=false,last=null,stale=false,goal='sales';
const style=document.createElement('style');style.textContent=`.bz-health{box-sizing:border-box;min-width:0;border:1px solid #d7bc8e35;background:#171513;color:#f4ebdd;border-radius:18px;padding:22px;margin:0 0 24px;font:14px/1.55 system-ui}.bz-health *{box-sizing:border-box}.bz-health h2{font-size:22px;line-height:1.25;margin:0}.bz-health h3{font-size:16px;margin:4px 0 8px}.bz-health summary{cursor:pointer;min-height:44px;padding:12px 0;color:#efce9a;font-weight:600}.bz-health details{margin-top:8px}.bz-health p{margin:8px 0;color:#c8bfb2;overflow-wrap:anywhere}.bz-health-head{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}.bz-health button,.bz-health a.bz-health-action{font:600 14px system-ui;min-height:44px;padding:10px 15px;border-radius:10px;border:1px solid #d7bc8e45;background:#24201c;color:#f4ebdd;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}.bz-health button:disabled{opacity:.55;cursor:wait}.bz-health button:focus-visible,.bz-health a:focus-visible{outline:2px solid #edc98d;outline-offset:3px}.bz-health-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:16px}.bz-health-card{padding:14px;border:1px solid #d7bc8e25;border-radius:12px;background:#100f0e;min-width:0}.bz-health small{color:#b6aa99}.bz-health-badge{display:inline-block;padding:3px 8px;border-radius:6px;font-size:12px;background:#a7833825;color:#eac37b;margin-bottom:6px}.bz-health-badge[data-tone=ok]{color:#a2e0ba;background:#254f333d}.bz-health-badge[data-tone=blocked]{color:#ffb5bc;background:#7c263335}.bz-health-badge[data-tone=unknown]{color:#d6d1ca;background:#8882}.bz-health-link{color:#efce9a;text-underline-offset:3px}.bz-health-steps{list-style:none;margin:12px 0;padding:0;display:grid;gap:8px}.bz-health-steps li{display:flex;gap:12px;align-items:flex-start;padding:11px 12px;border:1px solid #d7bc8e25;border-radius:10px;min-width:0}.bz-health-stepnum{flex:none;display:grid;place-items:center;width:26px;height:26px;border-radius:50%;border:1px solid #d7bc8e55;color:#edc98d}.bz-health-steps li[data-done=true] .bz-health-stepnum{color:#a2e0ba;border-color:#65c99166}.bz-health-steps a{color:#efce9a;min-height:28px;display:inline-block}.bz-health-alert{border-left:3px solid #e4b56e;padding:10px 13px;background:#e4b56e0c;margin-top:14px}.bz-health-order{padding:12px 0;border-bottom:1px solid #d7bc8e25}.bz-health-goals{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.bz-health-goals [aria-pressed=true]{background:#46252b;border-color:#dc3654}.bz-health button.bz-health-refresh{white-space:nowrap}@media(max-width:650px){.bz-health{padding:18px 14px;border-radius:14px}.bz-health-grid{grid-template-columns:minmax(0,1fr)}.bz-health h2{font-size:21px}.bz-health-head{align-items:flex-start}.bz-health-goals button{flex:1;min-width:130px}}`;document.head.append(style);
const el=(tag,text,cls)=>{const n=document.createElement(tag);if(text!==undefined)n.textContent=text;if(cls)n.className=cls;return n};
const link=(label,url)=>{const n=el('a',label,'bz-health-link');n.href=url;return n};
const badge=(text,tone)=>{const n=el('span',text,'bz-health-badge');n.dataset.tone=tone;return n};
const statusText={ready:'Configuração operacional',setup_required:'Configuração pendente',attention:'Precisa de atenção',unknown:'Consulta incompleta'};
function stepsFor(d){if(goal==='photos'){return d.photo?.steps?d.photo.steps.concat([{label:'Fazer uma conversa de teste',manual:true,href:'/app?view=whatsapp'},{label:'Gerar o criativo dentro do produto',manual:true,href:'/app?view=products&studio=photo'}]):[{id:'product',label:'Receber o produto Foto com IA',done:false,href:'/app?view=products&studio=photo'}]}
return [{label:'Conectar seu WhatsApp',done:d.checks.find(c=>c.id==='whatsapp')?.state==='ok',href:'/app?view=whatsapp'},{label:'Revisar e publicar seu funil de vendas',done:d.checks.find(c=>c.id==='funnel')?.state==='ok',href:'/app?view=funil'},{label:'Conferir o saldo de API para os recursos pagos',done:d.balanceCents!==null&&d.balanceCents>0,href:'/app?view=api'},{label:'Testar uma conversa no seu WhatsApp',manual:true,href:'/app?view=whatsapp'}]}
function render(box,d){const frag=document.createDocumentFragment(),head=el('div',undefined,'bz-health-head'),t=el('div');t.append(el('h2','Saúde da operação'),el('p','Confira o que está pronto e o próximo passo para começar a vender.'));const refresh=el('button','Atualizar','bz-health-refresh');refresh.type='button';refresh.disabled=busy;refresh.onclick=()=>load();head.append(t,refresh);frag.append(head);const state=el('div');state.setAttribute('role','status');state.setAttribute('aria-live','polite');state.append(badge(stale?'Status desatualizado':statusText[d.status]||'Em conferência',stale?'unknown':d.status==='ready'?'ok':'attention'));state.append(el('small',' Atualizado às '+new Date(d.checkedAt).toLocaleTimeString('pt-BR')+'.'));if(stale)state.append(el('p','Não foi possível atualizar. Os dados abaixo são da última consulta; confira novamente antes de ativar.'));frag.append(state);
const detail=el('details');detail.open=box.querySelector('details')?.open||new URLSearchParams(location.search).get('health')==='1';detail.append(el('summary','Ver saúde e configurar'));const grid=el('div',undefined,'bz-health-grid');for(const c of d.checks){const card=el('div',undefined,'bz-health-card');card.append(badge({ok:'Disponível',attention:'Conferir',blocked:'Ação necessária',unknown:'Não confirmado'}[c.state],c.state),el('h3',c.label));if(c.id==='wallet'&&d.balanceCents!==null)card.append(el('strong',(d.balanceCents/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'})));card.append(el('p',c.detail),link('Abrir '+c.label,c.href));grid.append(card)}detail.append(grid);
detail.append(el('h3','Configuração guiada'));const choices=el('div',undefined,'bz-health-goals');for(const [value,label]of [['sales','Vender pelo WhatsApp'],['photos','Vender fotos com IA']]){const b=el('button',label);b.type='button';b.setAttribute('aria-pressed',String(goal===value));b.onclick=()=>{goal=value;render(box,d)};choices.append(b)}detail.append(choices);
const steps=el('ol',undefined,'bz-health-steps');steps.setAttribute('aria-label','Etapas da configuração');stepsFor(d).forEach((s,i)=>{const item=el('li');item.dataset.done=String(!!s.done);const body=el('div');body.append(el('strong',s.label),el('br'),s.done?el('small','Concluído conforme a última consulta.'):link(s.manual?'Abrir e testar':'Continuar esta etapa',s.href));item.append(el('span',s.done?'✓':String(i+1),'bz-health-stepnum'),body);steps.append(item)});detail.append(steps);detail.append(el('p','Conectado não significa teste concluído. O teste de conversa é manual: envie uma mensagem de outro número sem conversa anterior com este WhatsApp, confira apresentação, oferta e próximos passos. O painel não envia mensagens nem consome API ao atualizar.'));
const a=d.attention;if(a.items||a.uncertain||a.delayed||a.events){const warn=el('div',undefined,'bz-health-alert');warn.setAttribute('role','status');warn.append(el('strong','Há pendências para conferir'),el('p',a.items+' item(ns) de produção · '+a.uncertain+' entrega(s) sem confirmação · '+a.delayed+' pedido(s) com mais de 15 minutos · '+a.events+' evento(s) para revisão. As contagens podem se referir ao mesmo pedido.'),el('p','Não gere, pague ou envie novamente uma operação incerta. Confira o pedido original.'));detail.append(warn)}
if(d.orders.length){detail.append(el('h3','Pedidos em andamento'));for(const o of d.orders.slice(0,8)){const row=el('div',undefined,'bz-health-order');row.append(el('strong',o.label+' · '+o.quantity+' foto(s)'),el('p',o.next),el('small','Pedido '+o.id.slice(-8)+(o.delayed?' · Tempo acima de 15 minutos; conferir.':'')));detail.append(row)}detail.append(link('Ver a operação Foto com IA','/app?view=products&studio=photo'))}
detail.append(el('p',d.scope));frag.append(detail);box.replaceChildren(frag);}
async function load(){const box=document.getElementById('bz-operation-health');if(!box||busy||document.hidden)return;busy=true;const ctrl=new AbortController(),timer=setTimeout(()=>ctrl.abort(),12000);try{const r=await fetch('/api/operation-health',{credentials:'same-origin',cache:'no-store',signal:ctrl.signal});if(r.status===401||r.status===403){last=null;throw Error('health_auth')}if(!r.ok)throw Error('health_unavailable');const d=await r.json();if(d.version!==1||!Array.isArray(d.checks))throw Error('health_contract');last=d;stale=false}catch{stale=true}finally{clearTimeout(timer);busy=false;if(!box.isConnected)return;if(last)render(box,last);else{box.replaceChildren(el('h2','Saúde da operação'),el('p','Não foi possível consultar agora. Atualize para conferir a configuração.'));const b=el('button','Tentar novamente');b.type='button';b.onclick=load;box.append(b)}}}
function mount(){if(location.pathname!=='/app')return;const view=new URLSearchParams(location.search).get('view'),content=document.querySelector('.workspace-content');if(view!=='products'){document.getElementById('bz-operation-health')?.remove();return}if(!content||document.getElementById('bz-operation-health'))return;const box=el('section',undefined,'bz-health');box.id='bz-operation-health';box.setAttribute('aria-label','Saúde e configuração da operação');box.append(el('h2','Saúde da operação'),el('p','Consultando sua configuração…'));content.prepend(box);if(last)render(box,last);load();}
let scheduled=false;new MutationObserver(()=>{if(scheduled)return;scheduled=true;requestAnimationFrame(()=>{scheduled=false;mount()})}).observe(document.documentElement,{childList:true,subtree:true});addEventListener('popstate',mount);document.addEventListener('visibilitychange',()=>{if(!document.hidden)load()});setInterval(load,60000);mount();})();
;(()=>{if(window.__bzOpNotice)return;window.__bzOpNotice=1;let st=null,busy=false;const css=document.createElement('style');css.textContent='.bz-opnotice{box-sizing:border-box;display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;border:1px solid #e4b56e;background:#2a1f10;color:#f4ebdd;border-radius:14px;padding:14px 16px;margin:0 0 18px;font:14px/1.5 system-ui}.bz-opnotice strong{color:#efce9a}.bz-opnotice a{font:600 14px system-ui;min-height:44px;padding:10px 15px;border-radius:10px;background:#efce9a;color:#171513;text-decoration:none;display:inline-flex;align-items:center}.bz-opnotice button{min-height:44px;background:none;border:0;color:#c8bfb2;cursor:pointer}';document.head.appendChild(css);function skip(){if(location.pathname!=='/app')return true;const q=new URLSearchParams(location.search);return q.get('view')==='products'&&q.get('studio')==='photo'||sessionStorage.getItem('bzOpNoticeHide')==='1'}function draw(){const old=document.getElementById('bz-opnotice');if(!st||!st.show||skip()){old&&old.remove();return}const c=document.querySelector('.workspace-content');if(!c||old)return;const b=document.createElement('div');b.id='bz-opnotice';b.className='bz-opnotice';b.setAttribute('role','alert');const t=document.createElement('div');const s=document.createElement('strong');s.textContent='Sua operação Foto com IA ainda não foi ativada. ';t.append(s,document.createTextNode('Falta concluir a configuração e aceitar as condições. Enquanto isso, a IA não responde seus clientes.'));const a=document.createElement('a');a.href=st.href||'/app?view=products&studio=photo';a.textContent='Concluir ativação';const x=document.createElement('button');x.type='button';x.textContent='Agora não';x.onclick=()=>{sessionStorage.setItem('bzOpNoticeHide','1');b.remove()};const r=document.createElement('div');r.append(a,x);b.append(t,r);c.prepend(b)}async function load(){if(busy||location.pathname!=='/app')return;busy=true;try{const r=await fetch('/api/operation-notice',{credentials:'same-origin',cache:'no-store'});st=r.ok?await r.json():null}catch{st=null}finally{busy=false;draw()}}let sch=false;new MutationObserver(()=>{if(sch)return;sch=true;requestAnimationFrame(()=>{sch=false;draw()})}).observe(document.documentElement,{childList:true,subtree:true});addEventListener('popstate',draw);setInterval(()=>{if(!document.hidden)load()},600000);load();})();