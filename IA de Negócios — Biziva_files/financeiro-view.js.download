(function(){if(window.__bzFin)return;window.__bzFin=1;var on=false,finTab="overview";
var E=function(s){return String(s==null?"":s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})};
var R=function(c){return(Number(c||0)/100).toLocaleString("pt-BR",{style:"currency",currency:"BRL"})};
var D=function(s){return s?new Date(s).toLocaleDateString("pt-BR"):"—"};
var ST={paid:["Pago","ok"],refunded:["Estornado","bad"],chargeback:["Chargeback","bad"],processing:["Em processamento","w"],requested:["Em análise","w"],rejected:["Recusado","bad"],active:["Aprovado","ok"],draft:["Em análise","w"],pending:["Em análise","w"],registration:["Em análise","w"],affiliation:["Em análise","w"],refused:["Rejeitado","bad"],error:["Rejeitado","bad"],suspended:["Rejeitado","bad"],blocked:["Rejeitado","bad"]};
var PL=function(s){var x=ST[s]||[s,""];return'<span class="pill '+x[1]+'">'+E(x[0])+'</span>'};
var css='.bz-fin-on .workspace-content{display:none!important}#bz-inshell{flex:1;min-height:0;overflow:auto}#bz-fin table{width:100%;border-collapse:collapse;font-size:13px}#bz-fin th{text-align:left;color:var(--bv-muted);font-weight:500;font-size:12px;padding:8px 10px;border-bottom:1px solid var(--bv-line)}#bz-fin td{padding:9px 10px;border-bottom:1px solid var(--bv-line)}#bz-fin .n{text-align:right}#bz-fin .sub{color:var(--bv-muted);font-size:12px}#bz-fin .tw{overflow-x:auto}#bz-fin .rd-kpis{grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}#bz-fin .rd-split{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(320px,1fr))}#bz-fin .pill{display:inline-block;padding:2px 8px;border-radius:999px;font-size:11px;background:#f5efdf14;color:var(--bv-muted)}#bz-fin .pill.ok{background:#5fd08a1f;color:#5fd08a}#bz-fin .pill.w{background:#f0b35a1f;color:#f0b35a}#bz-fin .pill.bad{background:#ff6b801f;color:#ff6b80}#bz-fin input{background:transparent;color:var(--bv-text);border:1px solid var(--bv-line);border-radius:8px;padding:8px 10px;font:inherit;width:160px}#bz-fin .row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:10px}';
var K=function(k,v,s){return'<div class="rd-kpi"><article class="biziva-stat resource-card"><small>'+k+'</small><strong>'+v+'</strong></article>'+(s?'<small class="sub">'+s+'</small>':'')+'</div>'};
var T=function(h,rows,num){num=num||[];return rows===null?'<p class="sub" role="status">Seção indisponível. Atualize a página para tentar novamente.</p>':rows.length?'<div class="tw"><table><tr>'+h.map(function(x,i){return'<th'+(num.indexOf(i)>=0?' class="n"':'')+'>'+x+'</th>'}).join("")+'</tr>'+rows.map(function(r){return'<tr>'+r.map(function(x,i){return'<td'+(num.indexOf(i)>=0?' class="n"':'')+'>'+x+'</td>'}).join("")+'</tr>'}).join("")+'</table></div>':'<p class="sub">Nada por aqui ainda.</p>'};
function moneyCents(input){var s=String(input||'').trim().replace(/^R\$\s*/, '').replace(/\s/g,'');if(/^[0-9]{1,3}(\.[0-9]{3})+(,[0-9]{1,2})?$/.test(s))s=s.replace(/\./g,'');else if(!/^[0-9]+([.,][0-9]{1,2})?$/.test(s))return null;var p=s.replace(',','.').split('.'),v=Number(p[0])*100+Number((p[1]||'').padEnd(2,'0'));return Number.isSafeInteger(v)&&v>0?v:null;}
css += "\n#bz-fin{max-width:1480px;width:100%;box-sizing:border-box;margin-inline:auto}#bz-fin .page-title h1{font-size:clamp(26px,3vw,34px);line-height:1.15;margin:6px 0 8px}#bz-fin .rd-kpi{padding:18px;border-radius:12px}#bz-fin .rd-kpi>.biziva-stat.resource-card{padding:0;border:0;border-radius:0;box-shadow:none;background:transparent;min-height:0}#bz-fin .biziva-stat strong{font-size:28px;font-variant-numeric:tabular-nums}#bz-fin .rd-split{grid-template-columns:repeat(2,minmax(0,1fr))}#bz-fin .bz-fin-embedded{width:100%;min-height:820px;border:0;border-radius:12px;background:transparent}#bz-fin .tw{max-width:100%;overflow-x:auto}#bz-fin .tw table{min-width:620px}#bz-fin .row input{max-width:100%;min-height:44px}#bz-fin .row button{min-height:44px}#bz-fin .row label{width:100%}@media(max-width:700px){#bz-fin .rd-split{grid-template-columns:minmax(0,1fr)}#bz-fin .rd-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}#bz-fin .rd-kpi{padding:14px}}@media(max-width:390px){#bz-fin .rd-kpis{grid-template-columns:minmax(0,1fr)}}";
function host(){var h=document.getElementById("bz-inshell");if(h)return h;var m=document.querySelector(".workspace-main");if(!m)return null;h=document.createElement("div");h.id="bz-inshell";m.appendChild(h);return h}
function loadCommissions(){var holder=document.getElementById('bz-fin-commissions-content');if(!holder||holder.dataset.loading||holder.shadowRoot)return;holder.dataset.loading='1';holder.textContent='Consultando comissões…';fetch('/app/saldo?embed=1',{credentials:'same-origin'}).then(function(r){if(!r.ok)throw Error('Não foi possível consultar as comissões.');return r.text()}).then(function(html){if(!holder.isConnected)return;var parsed=new DOMParser().parseFromString(html,'text/html');var scripts=Array.from(parsed.querySelectorAll('script')).map(function(x){return x.textContent}).join('\n');parsed.querySelectorAll('script').forEach(function(x){x.remove()});var sr=holder.attachShadow({mode:'open'});holder.textContent='';var style=document.createElement('style');style.textContent=Array.from(parsed.querySelectorAll('style')).map(function(x){return x.textContent}).join('\n')+' :host{display:block;color:#f5ecdc;font:14px/1.6 system-ui}main{max-width:none!important;padding:0!important}main>h1:first-of-type,main>p:first-of-type{display:none}input,select,button{font:inherit;min-height:44px;max-width:100%;box-sizing:border-box}.card{border-radius:12px!important}body{background:transparent!important}table{font-size:13px}';var box=document.createElement('div');var main=parsed.querySelector('main');if(!main)throw Error('Conteúdo indisponível.');box.append(document.importNode(main,true));sr.append(style,box);var realDoc=document;window.__bzBalanceDocument={getElementById:function(id){return sr.getElementById(id)},querySelector:function(q){return sr.querySelector(q)},querySelectorAll:function(q){return sr.querySelectorAll(q)},createElement:function(t){return realDoc.createElement(t)},body:box};var sc=document.createElement('script');var bindings='var '+Array.from(sr.querySelectorAll('[id]')).map(function(n){return n.id}).filter(function(id){return /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(id)}).map(function(id){return id+'=document.getElementById('+JSON.stringify(id)+')'}).join(',')+';';sc.textContent='(function(document){'+bindings+scripts+'\n})(window.__bzBalanceDocument);';document.head.append(sc);sc.remove()}).catch(function(e){if(holder.isConnected){holder.textContent=e.message;delete holder.dataset.loading}})}
function setFinTab(value){finTab=value;if(value==='commissions')loadCommissions();var root=document.getElementById('bz-fin');if(!root)return;root.querySelectorAll('[data-fin-tab]').forEach(function(b){var selected=b.dataset.finTab===value;b.setAttribute('aria-selected',String(selected));b.tabIndex=selected?0:-1});root.querySelectorAll('[data-fin-panel]').forEach(function(p){p.hidden=p.dataset.finPanel!==value});}function bindFinTabs(){var root=document.getElementById('bz-fin');root.querySelectorAll('[data-fin-tab]').forEach(function(b){b.onclick=function(){setFinTab(b.dataset.finTab)};b.onkeydown=function(e){if(['ArrowRight','ArrowLeft','Home','End'].indexOf(e.key)<0)return;e.preventDefault();var all=Array.from(root.querySelectorAll('[data-fin-tab]')),i=all.indexOf(b);i=e.key==='Home'?0:e.key==='End'?all.length-1:(i+(e.key==='ArrowRight'?1:-1)+all.length)%all.length;setFinTab(all[i].dataset.finTab);all[i].focus()}});var jump=root.querySelector('[data-fin-withdraw]');if(jump)jump.onclick=function(){setFinTab('withdrawals');document.getElementById('bzfin-v').focus()};setFinTab(finTab);}
function render(d){var m=document.getElementById("bzfin-m");if(!m)return;var rc=d.recipient,pgb=d.pagarme,c=d.central||{},split=rc&&rc.split;
var avail=split?(pgb?pgb.availableCents:null):(c.available_cents!=null?c.available_cents:c.availableCents!=null?c.availableCents:c.available);var wait=split?(pgb?pgb.waitingCents:null):(c.pending_cents!=null?c.pending_cents:c.pendingCents!=null?c.pendingCents:d.central?(c.blocked||0)+(c.waiting||0):null);
var h='<div class="bz-fin-tabs" role="tablist" aria-label="Seções do financeiro">'+[['overview','Visão geral'],['statement','Extrato'],['withdrawals','Saques'],['commissions','Comissões e Pix']].map(function(t){return '<button type="button" role="tab" id="bzfin-tab-'+t[0]+'" aria-controls="bzfin-panel-'+t[0]+'" data-fin-tab="'+t[0]+'">'+t[1]+'</button>'}).join('')+'</div>';
h+='<section class="bz-fin-hero" role="tabpanel" id="bzfin-panel-overview" aria-labelledby="bzfin-tab-overview" data-fin-panel="overview"><div><small>Disponível para saque</small><strong>'+ (avail==null?'—':R(avail)) +'</strong><p class="sub">'+(split?(d.dual?'Saldo na sua conta de recebimento (Pagar.me).':'Saldo na sua conta de recebimento.'):'Saldo BIZIVA para saque por Pix.')+'</p><div class="bz-fin-meta"><span>A receber <b>'+(wait==null?'—':R(wait))+'</b></span></div></div><button type="button" class="primary-button" data-fin-withdraw>Solicitar saque</button></section>'+(split&&d.dual&&(Number(c.available||0)+Number(c.blocked||0)+Number(c.waiting||0)+Number(c.requested||0))>0?'<section class="bz-fin-hero bz-fin-central" data-fin-panel="overview"><div><small>Saldo BIZIVA · disponível para saque</small><strong>'+R(c.available||0)+'</strong><p class="sub">Vendas recebidas pela BIZIVA (Mercado Pago), sacadas por Pix na aba Comissões e Pix.</p><div class="bz-fin-meta"><span>A liberar <b>'+R(Number(c.blocked||0)+Number(c.waiting||0))+'</b></span>'+(c.requested?'<span>Em saque <b>'+R(c.requested)+'</b></span>':'')+'</div></div><button type="button" class="ghost-button" data-fin-central>Ver Comissões e Pix</button></section>':'')+'<div class="kpi-grid rd-kpis bz-fin-counts" data-fin-panel="overview">'+K('Vendas (últimas 100)',d.extrato.filter(function(x){return x.status==='paid'}).length)+K('Estornos e chargebacks',d.extrato.filter(function(x){return x.status!=='paid'}).length)+'</div>';
h+='<section class="settings-card" role="tabpanel" id="bzfin-panel-withdrawals" aria-labelledby="bzfin-tab-withdrawals" data-fin-panel="withdrawals"><h2>Solicitar saque</h2><p class="sub">'+(split?"O valor vai para a conta bancária cadastrada em Dados para recebimento.":"O saque sai do saldo BIZIVA por Pix.")+'</p><div class="row"><label for="bzfin-v" class="sub">Valor do saque · mínimo R$ 10,00</label><input id="bzfin-v" inputmode="decimal" placeholder="R$ 0,00"><button type="button" class="primary-button" id="bzfin-s">Solicitar saque</button><span class="sub" id="bzfin-msg" role="status" aria-live="polite"></span></div></section>';
h+='<section class="settings-card bz-fin-recipient" data-fin-panel="overview"><h2>Dados para recebimento</h2><p>'+(rc?PL(rc.status)+' '+E(rc.name||""):'<span class="sub">Dados ainda não enviados.</span>')+'</p><div class="row"><button type="button" class="ghost-button" id="bzfin-rc">'+(rc?"Ver situação":"Enviar dados e documentos")+'</button></div></section>';
h+='<section class="settings-card" role="tabpanel" id="bzfin-panel-statement" aria-labelledby="bzfin-tab-statement" data-fin-panel="statement"><h2>Extrato <small class="sub">vendas, taxas, estornos e chargebacks</small></h2>'+T(["Data","Descrição","Situação","Bruto","Taxa BIZIVA","Afiliado","Líquido"],d.extrato===null?null:d.extrato.map(function(x){return[D(x.date),E(x.label),PL(x.status),R(x.grossCents),R(x.feeCents),R(x.affiliateCents),(x.status==="paid"?"":"−")+R(x.netCents)]}),[3,4,5,6])+'</section>';
h+='<section class="settings-card" data-fin-panel="withdrawals"><h2>Histórico de saques</h2>'+T(["Data","Valor","Via","Situação","Decidido em"],d.withdrawals===null?null:d.withdrawals.map(function(x){return[D(x.created_at),R(x.amount_cents),x.key_type==="pagarme"?"Conta bancária":"Pix",PL(x.status),D(x.decided_at)]}),[1])+'</section>';
h+='<div class="page-title" data-fin-panel="overview"><div><span class="eyebrow">API</span><h2 style="margin:4px 0">Gastos da API</h2></div></div><div id="bzfin-api" data-fin-panel="overview"><p class="sub">Carregando…</p></div>';
if(d.sections&&d.sections.licensee&&d.sections.licensee.state==='unavailable')h+='<p class="sub" data-fin-panel="overview" role="status">Não foi possível consultar os planos agora. Atualize a página para tentar novamente.</p>';
if(d.licensee)h+='<section class="settings-card" data-fin-panel="overview"><h2>Planos do Kloel Suits</h2><p class="sub">Cadastre preços, dias grátis e veja seus links de venda.</p><div class="row"><a class="primary-button" href="/app?view=licenca">Abrir planos do Kloel Suits</a></div></section>';
h+='<section class="settings-card" role="tabpanel" id="bzfin-panel-commissions" aria-labelledby="bzfin-tab-commissions" data-fin-panel="commissions"><h2>Comissões e Pix</h2><p class="sub">Saldo das indicações, chave Pix e solicitações de saque.</p><div id="bz-fin-commissions-content" class="bz-fin-embedded"><p class="sub">Abra esta aba para consultar suas comissões e a chave Pix.</p></div></section>';m.innerHTML=h;bindFinTabs();var cj=document.querySelector('#bz-fin [data-fin-central]');if(cj)cj.onclick=function(){setFinTab('commissions')};if(!split){var panel=document.querySelector('#bz-fin [data-fin-panel=withdrawals]');if(panel){panel.innerHTML='<h2>Saque de comissões por Pix</h2><p>O saque por Pix solicita o saldo integral disponível, a partir de R$ 1,00. Confira sua chave e o valor na aba Comissões e Pix.</p><button type=button class=primary-button id=bzfin-pix-jump>Abrir Comissões e Pix</button>';document.getElementById('bzfin-pix-jump').onclick=function(){setFinTab('commissions')}}var jump=document.querySelector('#bz-fin [data-fin-withdraw]');if(jump){jump.textContent='Gerenciar Pix e comissões';jump.onclick=function(){setFinTab('commissions')}}}var rcb=document.getElementById("bzfin-rc");if(rcb)rcb.onclick=function(){hide();if(window.__bzRcbShow)window.__bzRcbShow(true);else location.href="/app?view=recebimento"};
if(split){var amountInput=document.getElementById("bzfin-v"),withdrawButton=document.getElementById("bzfin-s");function checkAmount(){var v=moneyCents(amountInput.value);withdrawButton.disabled=v==null||v<1000;document.getElementById("bzfin-msg").textContent=withdrawButton.disabled?"Informe no mínimo R$ 10,00. O saldo e os dados de recebimento serão conferidos pelo servidor.":"Confira o valor e a conta de recebimento antes de solicitar."}amountInput.addEventListener("input",checkAmount);checkAmount();var withdrawing=false;document.getElementById("bzfin-s").onclick=function(){if(withdrawing)return;var button=this,msg=document.getElementById("bzfin-msg"),v=moneyCents(document.getElementById("bzfin-v").value);if(v==null||v<1000){msg.textContent="Informe um valor válido de pelo menos R$ 10,00.";return}withdrawing=true;button.disabled=true;msg.textContent="Enviando…";fetch("/api/financeiro/saque",{method:"POST",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({amount_cents:v})}).then(function(r){return r.json().then(function(j){if(!r.ok||j.ok===false)throw new Error(j.error||j.message||r.status);return j})}).then(function(j){msg.textContent=j.message||"Saque solicitado.";load()}).catch(function(e){msg.textContent=e.message}).finally(function(){withdrawing=false;if(button.isConnected)checkAmount()})};
}fetch("/api/financeiro/api-gastos",{credentials:"same-origin"}).then(function(r){return r.ok?r.json():null}).then(function(a){var el=document.getElementById("bzfin-api");if(!el)return;if(!a){el.innerHTML='<p class="sub" role="status">Gastos da API indisponíveis. Atualize a página para tentar novamente.</p>';return}el.innerHTML='<div class="kpi-grid rd-kpis">'+K("Consumo cobrado (30 dias)",R(a.costBrl*100))+K("Chamadas",(a.calls||0).toLocaleString("pt-BR"))+K("Saldo da carteira",R(a.balanceBrl*100))+'</div><p class="sub">API desta conta na plataforma Biziva · últimos 30 dias. A conta do console independente tem consumo próprio.</p>'}).catch(function(){var el=document.getElementById("bzfin-api");if(el)el.innerHTML='<p class="sub" role="status">Não foi possível consultar os gastos da API agora.</p>'})}
function load(){fetch("/api/financeiro",{credentials:"same-origin"}).then(function(r){if(!r.ok)throw new Error("Falha ao consultar o financeiro");return r.json()}).then(render).catch(function(){var m=document.getElementById("bzfin-m");if(m)m.innerHTML='<p class="sub">Não foi possível carregar.</p>'})}
function mark(){var b=document.querySelector(".bz-fin-item");if(!b)return;if(on){document.querySelectorAll("#workspace-context-sidebar .active").forEach(function(o){if(o!==b){o.classList.remove("active");o.removeAttribute("aria-current")}});b.classList.add("active");b.setAttribute("aria-current","page")}else{b.classList.remove("active");b.removeAttribute("aria-current")}}
function show(push){var h=host();if(!h||!document.querySelector(".workspace-shell"))return setTimeout(function(){show(push)},300);if(push)history.pushState({bzView:"financeiro"},"","/app?view=financeiro");on=true;document.documentElement.classList.add("bz-inshell-on","bz-fin-on");document.title="Financeiro — Biziva";var wc=document.querySelector(".workspace-content"),pad=wc?getComputedStyle(wc).padding:"";
h.innerHTML='<style>'+css+'</style><div id="bz-fin" class="page-stack" style="padding:'+(pad&&pad!=="0px"?pad:"28px 32px 64px")+'"><div class="page-title"><div><span class="eyebrow">Financeiro</span><h1>Financeiro</h1><p>Saldo, extrato, saques e dados para recebimento em um só lugar.</p></div></div><div id="bzfin-m" class="page-stack"><p class="sub">Carregando…</p></div></div>';mark();load()}
function hide(){if(!on)return;on=false;document.documentElement.classList.remove("bz-fin-on");var h=document.getElementById("bz-inshell");if(h&&h.querySelector("#bz-fin")){h.innerHTML="";document.documentElement.classList.remove("bz-inshell-on")}mark()}
function build(){var ref=document.querySelector('#workspace-context-sidebar [data-view="recebimentos"]')||document.querySelector('#workspace-context-sidebar [data-view="orders"]')||document.querySelector('#workspace-context-sidebar [data-view="products"]');if(!ref||document.querySelector(".bz-fin-item"))return;var b=ref.cloneNode(true);b.removeAttribute("data-view");b.removeAttribute("aria-current");b.classList.remove("active");b.classList.add("bz-fin-item");[].forEach.call(b.querySelectorAll("small"),function(s){s.remove()});var g=b.querySelector("svg");if(g){g.setAttribute("viewBox","0 0 24 24");g.setAttribute("fill","none");g.setAttribute("stroke","currentColor");g.innerHTML='<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/>'}var n=[].slice.call(b.querySelectorAll("span")).filter(function(s){return!s.children.length})[0];if(n)n.textContent="Financeiro";b.addEventListener("click",function(e){e.preventDefault();e.stopImmediatePropagation();show(true)},true);var top=document.querySelector('#workspace-context-sidebar .nav-direct-block');if(top)top.appendChild(b);else ref.parentNode.insertBefore(b,ref.nextSibling);mark()}
document.addEventListener("click",function(e){if(!on)return;var b=e.target.closest&&e.target.closest("#workspace-context-sidebar button,#workspace-context-sidebar a");if(!b||b.classList.contains("bz-fin-item")||b.classList.contains("contextual-close")||b.classList.contains("nav-group-toggle"))return;hide()},true);
window.addEventListener("popstate",function(){if(new URLSearchParams(location.search).get("view")==="financeiro")show(false);else hide()});
build();new MutationObserver(build).observe(document.documentElement,{childList:true,subtree:true});
if(new URLSearchParams(location.search).get("view")==="financeiro")show(false);})();