(()=>{let allowed=false;fetch('/api/product-reviews',{credentials:'same-origin'}).then(r=>r.ok?r.json():null).then(b=>{allowed=b?.admin===true;add()}).catch(()=>{});function add(){const h=document.getElementById('bz-adm');if(!allowed||!h||h.querySelector('[data-review-link]'))return;const a=document.createElement('a');a.href='/app/revisao-produtos';a.dataset.reviewLink='1';a.textContent='Revisão de produtos';a.className='button secondary';a.style.cssText='display:inline-flex;margin:12px 0;padding:12px 18px;border:1px solid #ffffff30;border-radius:12px;color:inherit;text-decoration:none';h.prepend(a)}new MutationObserver(add).observe(document.documentElement,{childList:true,subtree:true})})();