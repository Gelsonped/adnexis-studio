(function(){if(window.__bzDead)return;window.__bzDead=1;function run(){fetch('/api/wa-dead',{credentials:'same-origin'}).then(function(r){return r.ok?r.json():null}).then(function(j){fw(j);var old=document.getElementById('bz-dead');if(!j||!j.chips||!j.chips.length){if(old)old.remove();return}if(old)return;var n=j.chips.length>1?' ('+j.chips.map(function(c){return c.label}).join(', ')+')':'';var d=document.createElement('div');d.id='bz-dead';d.setAttribute('role','alert');d.style.cssText='position:fixed;left:50%;transform:translateX(-50%);top:12px;z-index:2147483000;width:min(680px,calc(100vw - 24px));box-sizing:border-box;display:flex;flex-wrap:wrap;gap:10px 12px;align-items:center;padding:12px 16px;border-radius:14px;background:#2a0d12;border:1px solid #c8122a;color:#fff4e4;font:500 14px/1.4 inherit;box-shadow:0 10px 30px rgba(0,0,0,.35)';d.innerHTML='<span style="flex:1 1 220px"><b>Reconecte seu WhatsApp (QR)'+n+'</b><br><span style="opacity:.85">Ele parou de receber e enviar mensagens. A IA e o funil continuam ligados.</span></span><a href="/app?view=whatsapp" style="background:#c8122a;color:#fff;border-radius:10px;padding:8px 12px;text-decoration:none;white-space:nowrap;font-weight:600">Reconectar</a><button type="button" aria-label="Fechar" style="background:none;border:0;color:#fff4e4;font-size:18px;cursor:pointer;padding:0 4px">\u00d7</button>';d.querySelector('button').onclick=function(){d.remove()};document.body.appendChild(d)}).catch(function(){})}function rc(j){try{var o=document.getElementById('bz-rcptwarn');if(!j||!j.receipts||!j.receipts.length){if(o)o.remove();return}if(o)return;var it=j.receipts.map(function(r){return '<li>cliente final '+String(r.phone).replace(/[^0-9]/g,'')+' — R$ '+Number(r.value).toFixed(2).replace('.',',')+'</li>'}).join('');var d=document.createElement('div');d.id='bz-rcptwarn';d.setAttribute('role','alert');d.style.cssText='position:fixed;right:12px;top:84px;z-index:2147482998;width:min(360px,calc(100vw - 24px));box-sizing:border-box;padding:12px 16px;border-radius:14px;background:#2a2108;border:1px solid #e0a10b;color:#fff4e4;font:500 14px/1.4 inherit;box-shadow:0 10px 30px rgba(0,0,0,.35)';d.innerHTML='<b>Comprovante aguardando sua aprovação</b><ul style="margin:6px 0 6px 18px;padding:0">'+it+'</ul><span style="opacity:.85">Confira se o valor caiu na sua conta e aprove no painel de pedidos.</span> <button type="button" aria-label="Fechar" style="background:none;border:0;color:#fff4e4;font-size:18px;cursor:pointer;float:right">×</button>';d.querySelector('button').onclick=function(){d.remove()};document.body.appendChild(d)}catch(e){}}function fw(j){rc(j);try{var o=document.getElementById('bz-funnelwarn');if(!j||!j.funnel||!j.funnel.length){if(o)o.remove();return}if(o)return;var it=j.funnel.map(function(f){var e=function(s){return String(s).replace(/[&<>"]/g,'')};return '<li><b>'+e(f.label)+'</b>: funil “'+e(f.funnel)+'” com '+e(f.reason)+'</li>'}).join('');var d=document.createElement('div');d.id='bz-funnelwarn';d.setAttribute('role','alert');d.style.cssText='position:fixed;left:50%;transform:translateX(-50%);bottom:12px;z-index:2147482999;width:min(680px,calc(100vw - 24px));box-sizing:border-box;padding:12px 16px;border-radius:14px;background:#2a2108;border:1px solid #e0a10b;color:#fff4e4;font:500 14px/1.4 inherit;box-shadow:0 10px 30px rgba(0,0,0,.35)';d.innerHTML='<b>A IA não está respondendo clientes novos</b><ul style="margin:6px 0 6px 18px;padding:0">'+it+'</ul><span style="opacity:.85">Abra o funil, ligue o robô e publique (ou ligue o chip a um funil publicado com robô ligado).</span> <button type="button" aria-label="Fechar" style="background:none;border:0;color:#fff4e4;font-size:18px;cursor:pointer;float:right">×</button>';d.querySelector('button').onclick=function(){d.remove()};document.body.appendChild(d)}catch(e){}}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',run);else run();/* 03/11 POLL10 (Kloel D1 etapa 3): 2min->10min e so com aba visivel; reduz carga no D1 */setInterval(function(){if(!document.hidden)run()},600000)})();