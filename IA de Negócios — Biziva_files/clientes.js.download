(function(){if(window.__bzClients)return;window.__bzClients=1;var on=false,admin=false;
var css="#bz-cli{max-width:1180px;margin:0 auto;padding:26px 22px 70px;color:#f5ecdc;font:14px system-ui}#bz-cli h1{font-size:26px;margin:0 0 4px}#bz-cli .m{color:rgba(245,236,220,.65)}#bz-cli .k{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0}#bz-cli .k div{background:#14100e;border:1px solid rgba(245,236,220,.14);border-radius:12px;padding:10px 14px;min-width:110px}#bz-cli .k b{display:block;font-size:20px}#bz-cli .f{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}#bz-cli input,#bz-cli select{padding:9px 11px;border-radius:10px;border:1px solid rgba(245,236,220,.2);background:#14100e;color:#f5ecdc;font:inherit}#bz-cli input{flex:1 1 260px;min-width:200px;width:auto!important}#bz-cli select{flex:0 0 auto;width:auto!important;margin:0!important}#bz-cli .w{overflow:auto;border:1px solid rgba(245,236,220,.12);border-radius:14px}#bz-cli table{width:100%;border-collapse:collapse;min-width:980px}#bz-cli th,#bz-cli td{padding:9px 10px;border-bottom:1px solid rgba(245,236,220,.08);text-align:left;vertical-align:top}#bz-cli th{background:#14100e;font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:rgba(245,236,220,.7);position:sticky;top:0}#bz-cli .p{display:inline-block;padding:2px 8px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(245,236,220,.12)}#bz-cli .p.vip{background:#cc1432;color:#fff}#bz-cli .p.pro{background:rgba(204,20,50,.25);color:#ff8a9a}#bz-cli .ok{color:#7fd69a}#bz-cli .no{color:#ff8a9a}#bz-cli .bar{height:6px;border-radius:9px;background:rgba(245,236,220,.12);margin-top:4px;width:110px}#bz-cli .bar i{display:block;height:100%;border-radius:9px;background:#cc1432}";
function E(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return"&#"+c.charCodeAt(0)+";"})}function D(s){return s?new Date(s).toLocaleDateString("pt-BR",{timeZone:"America/Sao_Paulo"}):"—"}function DT(s){return s?new Date(s).toLocaleString("pt-BR",{timeZone:"America/Sao_Paulo",day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}):""}function R(m){return"R$ "+(m/1e6).toFixed(2).replace(".",",")}
var data=null;function host(){var h=document.getElementById("bz-inshell");if(h)return h;var m=document.querySelector(".workspace-main");if(!m)return null;h=document.createElement("div");h.id="bz-inshell";m.appendChild(h);return h}
function btn(){return document.querySelector(".bz-clientes")}
function mark(x){var b=btn();if(!b)return;if(x){document.querySelectorAll("#workspace-context-sidebar .active,#workspace-context-sidebar [aria-current]").forEach(function(o){if(o!==b){o.classList.remove("active");o.removeAttribute("aria-current")}});b.classList.add("active");b.setAttribute("aria-current","page")}else{b.classList.remove("active");b.removeAttribute("aria-current")}}
function show(){var h=host(),s=document.querySelector(".workspace-shell");if(!h||!s)return setTimeout(show,300);on=true;document.documentElement.classList.add("bz-inshell-on");document.title="Clientes — Biziva";mark(1);
h.innerHTML='<style>'+css+'</style><div id="bz-cli"><h1>Clientes do lançamento</h1><div class="m">Compras pelo checkout e liberações manuais. Somente leitura.</div><div class="k" id="bzk"></div><div class="f"><input id="bzq" placeholder="Buscar nome, e-mail ou WhatsApp"><select id="bzp"><option value="">Todos os planos</option><option value="start">START</option><option value="pro">PRO</option><option value="vip">VIP</option></select><select id="bzs"><option value="">Todos os status</option><option value="ativo">Ativo</option><option value="expirado">Expirado</option><option value="sem-senha">Ainda não criou senha</option><option value="nunca">Nunca entrou</option></select><select id="bzo"><option value="">Todas as origens</option><option value="checkout">Checkout</option><option value="manual">Manual</option></select></div><div class="w"><table><thead><tr><th>Nome</th><th>E-mail</th><th>WhatsApp</th><th>Plano</th><th>Origem</th><th>Liberado em</th><th>Expira em</th><th>Acesso</th><th>Uso da cota IA</th></tr></thead><tbody id="bzt"><tr><td colspan=9 class=m>Carregando…</td></tr></tbody></table></div></div>';
["bzq","bzp","bzs","bzo"].forEach(function(i){document.getElementById(i).addEventListener("input",draw)});
fetch("/api/admin/clientes",{credentials:"same-origin"}).then(function(r){return r.json()}).then(function(j){if(!j.rows){document.getElementById("bzt").innerHTML='<tr><td colspan=9 class=no>Acesso só para admin.</td></tr>';return}data=j;draw()}).catch(function(){})}
function st(r,now){return{ativo:r.access_until&&r.access_until>now,senha:!!r.has_login,entrou:!!r.last_seen}}
function draw(){if(!data||!document.getElementById("bzt"))return;var q=document.getElementById("bzq").value.trim().toLowerCase(),p=document.getElementById("bzp").value,s=document.getElementById("bzs").value,o=document.getElementById("bzo").value,now=data.now;
var rows=data.rows.filter(function(r){var x=st(r,now);if(p&&r.plan!==p)return false;if(o&&r.origem!==o)return false;if(s==="ativo"&&!x.ativo)return false;if(s==="expirado"&&x.ativo)return false;if(s==="sem-senha"&&x.senha)return false;if(s==="nunca"&&x.entrou)return false;if(q&&((r.name||"")+" "+r.email+" "+(r.phone||"")).toLowerCase().indexOf(q)<0)return false;return true});
var all=data.rows,c=function(f){return all.filter(f).length};document.getElementById("bzk").innerHTML=[["Clientes",all.length],["Ativos",c(function(r){return st(r,now).ativo})],["START",c(function(r){return r.plan==="start"})],["PRO",c(function(r){return r.plan==="pro"})],["VIP",c(function(r){return r.plan==="vip"})],["Manuais",c(function(r){return r.origem==="manual"})],["Já entraram",c(function(r){return!!r.last_seen})]].map(function(k){return"<div><span class=m>"+k[0]+"</span><b>"+k[1]+"</b></div>"}).join("")+'<div><span class=m>Mostrando</span><b>'+rows.length+'</b></div>';
document.getElementById("bzt").innerHTML=rows.map(function(r){var x=st(r,now),pc=r.cap?Math.min(100,Math.round(r.used/r.cap*100)):0;return"<tr><td>"+E(r.name)+"</td><td>"+E(r.email)+"</td><td>"+E(r.phone)+"</td><td><span class='p "+E(r.plan)+"'>"+E(String(r.plan).toUpperCase())+"</span></td><td>"+(r.origem==="manual"?"Manual":"Checkout")+"</td><td>"+D(r.paid_at)+"</td><td class="+(x.ativo?"ok":"no")+">"+D(r.access_until)+"</td><td>"+(x.entrou?"<span class=ok>Entrou "+DT(r.last_seen)+"</span>":x.senha?"<span class=m>Criou senha, não entrou</span>":"<span class=no>Ainda não criou senha</span>")+"</td><td>"+R(r.used)+" de "+R(r.cap)+" ("+pc+"%)<div class=bar><i style='width:"+pc+"%'></i></div></td></tr>"}).join("")||"<tr><td colspan=9 class=m>Nenhum cliente com esses filtros.</td></tr>"}
function hide(){if(!on)return;on=false;mark(0);var h=document.getElementById("bz-inshell");if(h&&h.querySelector("#bz-cli")){h.innerHTML="";document.documentElement.classList.remove("bz-inshell-on")}}
function add(){if(!admin||btn())return;var ref=document.querySelector('#workspace-context-sidebar [data-view="dashboard"]')||document.querySelector('#workspace-context-sidebar [data-view="orders"]');if(!ref)return;var a=ref.cloneNode(true);a.className=(a.className||"").replace(/\bactive\b/,"")+" bz-clientes";a.removeAttribute("data-view");a.removeAttribute("aria-current");var g=a.querySelector("svg");if(g){g.setAttribute("viewBox","0 0 24 24");g.setAttribute("fill","none");g.setAttribute("stroke","currentColor");g.innerHTML='<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>'}var t=[].slice.call(a.querySelectorAll("*")).concat([a]).filter(function(x){return x.childNodes.length===1&&x.firstChild.nodeType===3});if(t.length)t[0].textContent="Clientes";else a.textContent="Clientes";ref.parentNode.insertBefore(a,ref.nextSibling);if(on)mark(1)}
document.addEventListener("click",function(e){var b=e.target.closest&&e.target.closest("#workspace-context-sidebar button,#workspace-context-sidebar a");if(!b)return;if(b.classList.contains("bz-clientes")){e.preventDefault();e.stopImmediatePropagation();if(new URLSearchParams(location.search).get("view")!=="clientes")history.pushState({bzView:"clientes"},"","/app?view=clientes");show();var s=document.getElementById("workspace-context-sidebar"),x=s&&s.querySelector(".contextual-close");if(window.innerWidth<900&&x&&getComputedStyle(x).display!=="none")x.click();return}if(on&&!b.classList.contains("contextual-close")&&!b.classList.contains("nav-group-toggle"))hide()},true);
window.addEventListener("popstate",function(){if(new URLSearchParams(location.search).get("view")==="clientes"){if(admin)show()}else hide()});
new MutationObserver(function(){add();if(on&&!document.getElementById("bz-cli"))show()}).observe(document.documentElement,{childList:true,subtree:true});
fetch("/api/admin/clientes?peek=1",{credentials:"same-origin"}).then(function(r){admin=r.ok;if(!admin)return;add();if(new URLSearchParams(location.search).get("view")==="clientes")show()}).catch(function(){});
})();