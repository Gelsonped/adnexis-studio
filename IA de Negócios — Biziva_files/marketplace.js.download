(()=>{
 if(window.__bzMarketplace)return;window.__bzMarketplace=1;
 const $=(s,r=document)=>r.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const money=n=>new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(n/100);
 const view=()=>new URLSearchParams(location.search).get('view');let serial=0,rendered='',query='',page=1;
 const api=async(path,method='GET',body)=>{const r=await fetch('/api/marketplace/'+path,{method,credentials:'same-origin',headers:body?{'content-type':'application/json'}:{},body:body?JSON.stringify(body):undefined});let j;try{j=await r.json()}catch{throw Error('A resposta não pôde ser lida. Atualize a página.')}if(!r.ok)throw Object.assign(Error(j.error||'Não foi possível concluir.'),{code:j.code,eligibility:j.eligibility});return j};
 const icon='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 10h18v11H3zM2 10l3-7h14l3 7M8 21v-7h8v7"/></svg>';
 function navigation(){const nav=$('#bz-menu-2026');if(!nav)return;
  for(const [key,label,target,where]of [['vitrine','Vitrine','.bz-menu-heading','before'],['licenca-ia','Licença de IA','.bz-menu-api','after']]){
   if(nav.querySelector('[data-market-nav="'+key+'"]'))continue;
   const ref=key==='vitrine'?[...nav.querySelectorAll(target)].find(e=>e.textContent.trim()==='Produtos')?.closest('.bz-menu-group'):nav.querySelector(target);if(!ref)continue;
   const a=document.createElement('a');a.href='/app?view='+key;a.dataset.marketNav=key;a.innerHTML=icon+'<span>'+label+'</span>';a.setAttribute('aria-current',view()===key?'page':'false');ref[where](a);
  }
 }
 function host(){let h=$('#bz-marketplace');if(h)return h;const main=$('.workspace-main');if(!main)return null;h=document.createElement('main');h.id='bz-marketplace';main.append(h);return h}
 function top(title,line,eyebrow){return '<header class="mp-heading"><div><span class="mp-eyebrow">'+eyebrow+'</span><h1>'+title+'</h1><p>'+line+'</p></div><a class="mp-button mp-quiet" href="/app?view=products">Meus produtos <span aria-hidden="true">↗</span></a></header>'}
 function notice(message){const n=$('#mp-notice');if(n){n.textContent=message;n.hidden=false;n.focus()}else alert(message)}
 function frame(html){const h=host();if(!h)return;h.innerHTML='<div class="mp-wrap"><div id="mp-notice" role="status" tabindex="-1" hidden></div>'+html+'</div>'}
 function buttons(p,license){if(!license&&(p.status==='approved'||p.own)&&p.productUrl)return '<a class="mp-button mp-primary" href="'+esc(p.productUrl)+'">Ver Produto <span>↗</span></a>';return '<button class="mp-button mp-primary" data-detail="'+esc(p.id)+'">'+(license?(p.licenseOwned?'Ver Licença':'Obter Licença'):'Agenciar-se')+' <span>↗</span></button>'}
 function productCard(p,license,i){return '<article class="mp-card"><div class="mp-art'+(p.logo?' mp-logo':'')+'">'+(p.image?'<img src="'+esc(p.image)+'" alt="'+esc(p.name)+'" loading="lazy" referrerpolicy="no-referrer">':'<div class="mp-placeholder">'+icon+'<span>Biziva</span></div>')+'<span class="mp-tag">'+(p.published?'Publicado':p.preview?'Em preparação':p.recurring?'Comissão recorrente':license?'Operação pronta':i===0&&page===1&&!query&&p.sales>0?'Mais vendido':'Afiliação')+'</span></div><div class="mp-card-content"><h2>'+esc(p.name)+'</h2><p class="mp-description">'+esc(p.description)+'</p>'+(license?'':'<div class="mp-numbers"><div><small>Comissão por venda</small><strong>'+esc(p.commissionBps/100)+'<em>%</em></strong></div><div><small>Planos a partir de</small><b>'+money(p.priceCents)+'</b></div></div>')+buttons(p,license)+'</div></article>'}
 async function copy(text,b){try{await navigator.clipboard.writeText(new URL(text,location.origin).href);b.textContent='Copiado'}catch{notice('Não foi possível copiar automaticamente. Abra o link e copie o endereço.')}}
 function details(p,license){
 const back=()=>{const u=new URL(location.href);u.searchParams.delete('item');history.pushState({},'',u);rendered='';load();};
 frame('<nav class="mp-breadcrumb" aria-label="Navegação do produto"><button class="mp-button mp-quiet" id="mp-detail-back">← '+(license?'Licença de IA':'Vitrine')+'</button><span>/</span><span>'+esc(p.name)+'</span></nav><section class="mp-product-hero"><div class="mp-product-cover">'+(p.image?'<img src="'+esc(p.image)+'" alt="'+esc(p.name)+'">':'')+'</div><div class="mp-product-summary"><span class="mp-eyebrow">'+(license?'Licença de IA':'Programa de afiliação')+'</span><h1 tabindex="-1">'+esc(p.name)+'</h1><p>'+esc(p.description)+'</p>'+(license?'':'<div class="mp-product-metric"><strong>'+esc(p.commissionBps/100)+'%</strong><span>Comissão por venda'+(p.recurring?' e renovação paga':'')+'</span></div>')+'</div></section><div class="mp-product-layout"><section class="mp-panel mp-product-actions"><span class="mp-eyebrow">'+(license?'Sua operação':'Comece por aqui')+'</span><h2>'+(license?'Configure seu produto':p.preview?'Sobre a disponibilidade':'Começar a vender')+'</h2><div class="mp-detail-actions"></div><p class="mp-dialog-error" role="alert"></p></section><aside class="mp-panel mp-product-conditions"><h2>Condições do produto</h2><div class="mp-terms">'+esc(p.terms)+'</div></aside></div>');
 const d=host(),a=$('.mp-detail-actions',d),close=back;$('#mp-detail-back',d).onclick=back;

 if(!license&&p.productUrl){a.innerHTML='<a class="mp-button mp-primary" href="'+esc(p.productUrl)+'">Ver Produto</a>'; }else if(license&&p.setupUrl){a.innerHTML='<a class="mp-button mp-primary" href="'+esc(p.setupUrl)+'">Ver Produto</a>';}else if(p.preview){a.innerHTML='<p>Publicado no catálogo. A venda e a ativação automática desta operação permanecem desativadas.</p>';}else if(!license&&p.status==='approved'){
  a.innerHTML='<h3>Links dos planos</h3>'+(p.links||[]).map((l,i)=>'<div class="mp-plan"><a href="'+esc(l.url)+'">'+esc(l.name)+' ↗</a><button class="mp-button" data-copy="'+i+'">Copiar link</button></div>').join('')+'<a class="mp-button" href="/app?view=funil">Abrir meus funis</a>';
  a.querySelectorAll('[data-copy]').forEach(b=>b.onclick=()=>copy(p.links[+b.dataset.copy].url,b));
 }else if(!license&&p.status){a.textContent=p.status==='pending'?'Seu pedido está aguardando a aprovação do produtor.':'Sua afiliação está '+p.status+'. Consulte o produtor.';
 }else{
  a.innerHTML='<label class="mp-check"><input type="checkbox"> Li e aceito as condições deste produto.</label><button class="mp-button mp-primary" disabled>'+(license?'Aceitar e obter licença':'Aceitar e agenciar-se')+'</button>';
  const b=$('button',a),check=$('input',a);check.onchange=()=>b.disabled=!check.checked;
  b.onclick=async()=>{b.disabled=true;try{const result=await api(license?'licenses/'+p.id:'products/'+p.id+'/join','POST',{accepted:true,revision:p.revision});if((license&&result.setupUrl)||(!license&&result.status==='approved'&&result.productUrl)){a.innerHTML='<p class="mp-success" role="status">✅ '+(license?'Licença obtida. Seu produto está disponível em Produtos.':'Agenciamento aprovado. Seu produto está disponível em Produtos.')+'</p><a class="mp-button mp-primary" href="'+esc(result.setupUrl||result.productUrl)+'">Ver Produto</a>';return}close();notice(result.status==='approved'?'Afiliação aprovada. Seus links de venda estão disponíveis.':'Pedido enviado. Aguarde a aprovação do produtor.')}catch(e){if(e.code==='RECEIPT_REQUIRED'){receiptGate(e.eligibility);return}$('.mp-dialog-error',d).textContent=e.message;b.disabled=!check.checked}};
 }
 $('.mp-product-summary h1',d).focus({preventScroll:true});d.scrollTop=0;let parent=d.parentElement;while(parent&&parent!==document.body){if(parent.scrollHeight>parent.clientHeight)parent.scrollTop=0;parent=parent.parentElement}window.scrollTo(0,0);
 }
 function receiptGate(e){
 const review=e?.state==='review';
 frame(top('Vitrine','Encontre seu próximo produto e comece a vender.','Seu próximo passo')+'<dialog class="mp-receipt-gate" aria-labelledby="mp-receipt-title" aria-describedby="mp-receipt-description"><section class="mp-receipt-card"><div class="mp-receipt-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="15" rx="3"/><path d="M3 10h18M7 15h4M8 5V3m8 2V3"/></svg></div><p class="mp-receipt-eyebrow">SEU PRÓXIMO PASSO</p><h2 id="mp-receipt-title">'+(review?'Seu cadastro está em análise':'Prepare sua conta<br>para receber comissões')+'</h2><p id="mp-receipt-description">'+(review?'Confira se existe alguma etapa pendente. A Vitrine será liberada quando seu recebimento estiver habilitado.':'Conclua seus dados pessoais e bancários para acessar a Vitrine e se agenciar aos produtos.')+'</p><div class="mp-receipt-note"><span aria-hidden="true">✓</span><span>Suas comissões serão enviadas para a conta bancária cadastrada.</span></div><a class="mp-receipt-cta" href="/app?view=recebimento"><span>'+(review?'Acompanhar cadastro':'Concluir meu cadastro')+'</span><span aria-hidden="true">→</span></a><a class="mp-receipt-back" href="/app">Voltar ao início</a></section></dialog>');
 const dialog=$('.mp-receipt-gate');dialog.showModal();dialog.addEventListener('cancel',event=>{event.preventDefault();location.assign('/app')});
 $('.mp-receipt-cta').focus();
 }
 async function catalog(license,ticket){
 const data=await api(license?'licenses':'catalog?page='+page+'&q='+encodeURIComponent(query));if(ticket!==serial)return;
 if(!license&&data.eligibility&&!data.eligibility.allowed){receiptGate(data.eligibility);return}
 page=data.page||1;
 frame(top(license?'Licença de IA':'Vitrine',license?'Sua operação de IA, pronta para receber a sua marca e vender.':'Escolha um produto. Receba seus links. Transforme boas ofertas em novas vendas.',license?'Seu próximo negócio':'Conecte-se a novas oportunidades')+
 (data.preview?'<div class="mp-intro" role="status"><span>Prévia da área</span><span>Vendas e ativações não liberadas</span></div>':'')+(license?'':'<form class="mp-search"><label class="mp-sr" for="mp-search">Buscar produtos</label><input id="mp-search" placeholder="Encontre seu próximo produto" maxlength="120" value="'+esc(query)+'"><button class="mp-button">Buscar</button><span>Mais vendidos primeiro · '+data.total+' produtos</span></form>')+
 '<div class="mp-grid">'+data.items.filter(p=>!p.listHidden/*LNLIC2*/).map((p,i)=>productCard(p,license,i)).join('')+'</div>'+(!data.items.length?'<div class="mp-empty"><h2>'+(license?'Novas operações em preparação':'Nenhum produto encontrado')+'</h2><p>'+(license?'As licenças aparecem aqui depois da liberação da Biziva.':'Experimente outro nome ou prepare seu produto para a vitrine.')+'</p><a class="mp-button" href="/app?view=config-afiliados">Configuração Afiliados</a></div>':'')+
 (!license?'<nav class="mp-pagination" aria-label="Páginas da vitrine"><span>Página '+page+' de '+data.pages+'</span>'+pagination(page,data.pages)+'</nav>':'')+
 (license&&data.admin?'<section class="mp-admin"><h2>Liberação de licenças</h2><p>Somente você pode disponibilizar uma operação. O instalador precisa preservar produto, funil e recebimento independente.</p><form id="mp-license-form"><label>Produto<select name="product">'+data.adminProducts.map(p=>'<option value="'+esc(p.id)+'">'+esc(p.name)+'</option>').join('')+'</select></label><label>Condições da licença<textarea name="terms" maxlength="4000" required></textarea></label><label class="mp-check"><input type="checkbox" name="enabled"> Disponibilizar para os usuários</label><button class="mp-button mp-primary">Salvar liberação</button></form></section>':'')
 );
 const selected=new URLSearchParams(location.search).get('item');if(selected){const found=data.items.find(p=>p.id===selected);if(found){details(found,license);return}}
 host().querySelectorAll('[data-detail]').forEach(b=>b.onclick=()=>{const u=new URL(location.href);u.searchParams.set('item',b.dataset.detail);history.pushState({},'',u);rendered='';load()});
 host().querySelectorAll('[data-page]').forEach(b=>b.onclick=()=>{page=+b.dataset.page;load()});
 const s=$('.mp-search');if(s)s.onsubmit=e=>{e.preventDefault();query=$('#mp-search').value.trim();page=1;load()};
 const f=$('#mp-license-form');if(f){const populate=()=>{const old=data.items.find(p=>p.id===f.elements.product.value);f.elements.terms.value=old?.terms||'';f.elements.enabled.checked=!!old};f.elements.product.onchange=populate;populate();f.onsubmit=async e=>{e.preventDefault();const b=$('button',f);b.disabled=true;try{const old=data.items.find(p=>p.id===f.elements.product.value);await api('licenses/'+f.elements.product.value,'PUT',{terms:f.elements.terms.value,enabled:f.elements.enabled.checked,revision:old?.revision||0});await load();notice('Liberação salva.')}catch(err){notice(err.message)}finally{b.disabled=false}}}
 }
 function pagination(current,total){const nums=[...new Set([1,total,...Array.from({length:5},(_,i)=>current+i-2).filter(n=>n>=1&&n<=total)])].sort((a,b)=>a-b);let last=0;return '<button class="mp-button" data-page="'+(current-1)+'" '+(current===1?'disabled':'')+' aria-label="Página anterior">‹</button>'+nums.map(n=>{const gap=last&&n-last>1?'<span>…</span>':'';last=n;return gap+'<button class="mp-button" data-page="'+n+'" '+(n===current?'aria-current="page"':'')+'>'+n+'</button>'}).join('')+'<button class="mp-button" data-page="'+(current+1)+'" '+(current===total?'disabled':'')+' aria-label="Próxima página">›</button>'}
 async function config(ticket){const {products}=await api('products');if(ticket!==serial)return;const selected=new URLSearchParams(location.search).get('product')||products[0]?.id;
 frame(top('Configuração Afiliados','Prepare a oferta, escolha a comissão e organize quem pode vender com você.','Produtos / Sua rede de vendas')+'<label class="mp-select">Produto<select id="mp-product">'+products.map(p=>'<option value="'+esc(p.id)+'" '+(p.id===selected?'selected':'')+'>'+esc(p.name)+'</option>').join('')+'</select></label><section id="mp-settings">'+(!products.length?'<p>Crie seu primeiro produto para configurar afiliados.</p>':'Carregando configuração…')+'</section>');if(!products.length)return;
 $('#mp-product').onchange=e=>{location.href='/app?view=config-afiliados&product='+encodeURIComponent(e.target.value)};
 const d=await api('products/'+selected+'/settings');if(ticket!==serial)return;
 $('#mp-settings').innerHTML='<div class="mp-config-grid"><form id="mp-settings-form" class="mp-panel"><h2>Programa de afiliação</h2><label class="mp-check"><input name="enabled" type="checkbox" '+(d.enabled?'checked':'')+'> Aceitar afiliados</label><div class="mp-fields"><label>Comissão por venda (%)<input name="commission" type="number" min="0" max="100" step="0.01" required value="'+d.commissionBps/100+'"></label><label>Aprovação<select name="auto"><option value="1" '+(d.auto?'selected':'')+'>Automática</option><option value="0" '+(!d.auto?'selected':'')+'>Manual</option></select></label></div><p class="mp-help">A comissão definida vale para novas afiliações. Os acordos já existentes são preservados.</p><label>Funil entregue ao afiliado<select name="funnel"><option value="">Selecione o funil completo</option>'+d.templates.map(f=>'<option value="'+esc(f.id)+'" '+(f.id===d.funnelId?'selected':'')+'>'+esc(f.name)+'</option>').join('')+'</select></label><label>Condições de afiliação<textarea name="terms" maxlength="4000" placeholder="Público, regras de divulgação, suporte e condições de venda">'+esc(d.terms)+'</textarea></label><label class="mp-check"><input name="listed" type="checkbox" '+(d.listed?'checked':'')+'> Exibir na Vitrine</label><button class="mp-button mp-primary">Salvar configuração</button></form><aside class="mp-panel"><span class="mp-eyebrow">Antes de publicar</span><h2>Seu produto está pronto?</h2><p>Complete os itens abaixo. Alterações na oferta ou no funil exigem uma nova revisão da publicação.</p><ul class="mp-checklist">'+d.checks.map(c=>'<li class="'+(c.ok?'mp-ok':'')+'"><span aria-hidden="true">'+(c.ok?'✓':'○')+'</span>'+esc(c.label)+'</li>').join('')+'</ul>'+(d.stale?'<p class="mp-warning">A oferta mudou desde a última publicação. Revise e salve novamente.</p>':'')+'<a class="mp-button" href="/app?view=products">Editar produto</a><a class="mp-button" href="/app?view=funil">Revisar funil</a><h3>Convite direto</h3><button class="mp-button" id="mp-copy-invite">Copiar convite</button></aside></div>';
 $('#mp-copy-invite').onclick=e=>copy(d.invite,e.target);
 $('#mp-settings-form').onsubmit=async e=>{e.preventDefault();const f=e.target,b=$('button',f);b.disabled=true;try{await api('products/'+selected+'/settings','PUT',{revision:d.revision,enabled:f.elements.enabled.checked,auto:f.elements.auto.value==='1',commissionBps:Math.round(Number(f.elements.commission.value)*100),funnelId:f.elements.funnel.value,terms:f.elements.terms.value,listed:f.elements.listed.checked});await load();notice('Configuração salva.')}catch(err){notice(err.message)}finally{b.disabled=false}};
 }
 async function load(){const v=view(),h=host();if(!h)return;document.title=(v==='licenca-ia'?'Licença de IA':v==='vitrine'?'Vitrine':'Configuração Afiliados')+' — Biziva';const ticket=++serial;document.documentElement.classList.add('bz-market-on');h.innerHTML='<div class="mp-wrap" role="status">Carregando…</div>';try{if(v==='config-afiliados')await config(ticket);else await catalog(v==='licenca-ia',ticket)}catch(e){if(ticket===serial){frame('<div class="mp-empty"><h1>Não foi possível carregar</h1><p>'+esc(e.message)+'</p><button class="mp-button" id="mp-retry">Tentar novamente</button></div>');$('#mp-retry').onclick=load}}}
 function sync(){navigation();const v=view(),active=['vitrine','licenca-ia','config-afiliados'].includes(v);if(active&&$('.workspace-main')){const key=v+':'+new URLSearchParams(location.search).get('product')+':'+new URLSearchParams(location.search).get('item');if(rendered!==key||!$('#bz-marketplace')){rendered=key;load()}}else if(!active){if(rendered)serial++;rendered='';document.documentElement.classList.remove('bz-market-on');$('#bz-marketplace')?.remove()}}
 let pending=false;const schedule=()=>{if(!pending){pending=true;requestAnimationFrame(()=>{pending=false;sync()})}};
 new MutationObserver(changes=>{if(changes.every(c=>c.target.closest?.('#bz-marketplace,.mp-dialog')))return;schedule()}).observe(document.documentElement,{childList:true,subtree:true});window.addEventListener('popstate',schedule);schedule();
})();
