(function(){if(window.__bzSub)return;window.__bzSub=2;
var LP_ON=1,D=document,L='Minha Assinatura',SUB=null,LIM=null,SUBINFO=null,loaded=false;
function q(s,r){return (r||D).querySelector(s)}
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function dt(x){if(!x)return '';var d=new Date(x.length<=10?x+'T12:00:00Z':x);return isNaN(d)?'':d.toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo'})}
var css='#bz-assinatura{--a-red:#e32636;--a-red2:#ff5a66;--a-bg:#15161b;--a-raised:#1c1d23;--a-line:#303139;--a-text:#f5efdf;--a-muted:#aba9b3;margin:0 0 28px;color:var(--a-text)}'
+'#bz-assinatura *{box-sizing:border-box}'
+'.bza-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px;margin:0 0 22px}.bza-eyebrow{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--a-red2)}.bza-head h1{font-size:40px;line-height:1.05;margin:6px 0 6px;letter-spacing:-.02em}.bza-head p{margin:0;color:var(--a-muted);font-size:15px}'
+'.bza-all{color:var(--a-muted);font-size:14px;text-decoration:none;border:1px solid var(--a-line);border-radius:12px;padding:10px 14px;min-height:44px;display:inline-flex;align-items:center}.bza-all:hover{color:var(--a-text);border-color:#4a4b55}'
+'.bza-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:18px}'
+'.bza-card{background:var(--a-bg);border:1px solid var(--a-line);border-radius:22px;padding:24px}'
+'.bza-status{display:flex;flex-direction:column;gap:18px}.bza-row{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}'
+'.bza-plan{font-size:13px;color:var(--a-muted)}.bza-plan b{display:block;font-size:22px;color:var(--a-text);margin-top:2px}'
+'.bza-pill{display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:6px 12px;font-size:13px;font-weight:700}.bza-pill i{width:8px;height:8px;border-radius:50%;background:currentColor}.bza-ok{color:#4ade80;background:rgba(74,222,128,.1);border:1px solid rgba(74,222,128,.3)}.bza-warn{color:#fbbf24;background:rgba(251,191,36,.1);border:1px solid rgba(251,191,36,.3)}.bza-bad{color:var(--a-red2);background:rgba(227,38,54,.12);border:1px solid rgba(227,38,54,.4)}'
+'.bza-usage-top{display:flex;justify-content:space-between;align-items:baseline;font-size:14px;color:var(--a-muted)}.bza-usage-top b{font-size:28px;color:var(--a-text)}.bza-track{height:10px;border-radius:999px;background:#26272e;overflow:hidden;margin-top:10px}.bza-track span{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,#e32636,#ff5a66);transition:width .6s}'
+'.bza-facts{display:grid;grid-template-columns:1fr 1fr;gap:10px}.bza-fact{background:var(--a-raised);border:1px solid var(--a-line);border-radius:14px;padding:12px 14px;font-size:12px;color:var(--a-muted)}.bza-fact b{display:block;color:var(--a-text);font-size:15px;margin-top:2px}'
+'.bza-note{font-size:13px;color:var(--a-muted);line-height:1.5;margin:0}'
+'.bza-pay{position:relative;overflow:hidden;border-color:rgba(227,38,54,.55);background:radial-gradient(120% 80% at 100% 0,rgba(227,38,54,.22),transparent 60%),var(--a-bg);box-shadow:0 24px 70px rgba(227,38,54,.12)}'
+'.bza-tag{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#fff;background:var(--a-red);padding:5px 10px;border-radius:999px}'
+'.bza-pay h2{font-size:20px;margin:14px 0 4px}.bza-price{font-size:48px;font-weight:800;letter-spacing:-.03em;line-height:1;margin:10px 0 4px}.bza-price small{font-size:18px;color:var(--a-muted);font-weight:600;letter-spacing:0}'
+'.bza-list{list-style:none;padding:0;margin:16px 0 4px}.bza-list li{display:flex;gap:10px;padding:7px 0;font-size:14.5px}.bza-list li:before{content:"\\2713";color:var(--a-red2);font-weight:800}'
+'.bza-cta{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:56px;margin-top:18px;border:0;border-radius:16px;font:700 18px inherit;font-family:inherit;color:#fff;background:var(--a-red);cursor:pointer;box-shadow:0 14px 34px rgba(227,38,54,.4);transition:transform .15s,background .15s}.bza-cta:hover{background:#f0303f;transform:translateY(-1px)}.bza-cta:disabled{opacity:.6;cursor:wait;transform:none}'
+'.bza-methods{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.bza-m{display:flex;align-items:center;gap:10px;background:var(--a-raised);border:1px solid var(--a-line);border-radius:14px;padding:11px 12px;font-size:13px;color:var(--a-muted)}.bza-m b{display:block;color:var(--a-text);font-size:14px}.bza-m svg{flex:none}'
+'.bza-trust{display:flex;flex-wrap:wrap;gap:8px 16px;margin-top:16px;font-size:12.5px;color:var(--a-muted)}.bza-trust span{display:inline-flex;align-items:center;gap:6px}.bza-trust svg{color:#4ade80}'
+'.bza-manage{display:block;text-align:center;margin-top:12px;color:var(--a-muted);font-size:14px}'
+'.bza-err{color:#ff6b75;font-size:14px;margin-top:10px;min-height:1px}'
+'body.bz-sub-mode .rd-view-settings>*:not(#bz-assinatura){display:none!important}'
+'@media (max-width:860px){.bza-grid{grid-template-columns:minmax(0,1fr)}.bza-status{order:-1}.bza-head h1{font-size:32px}}'
+'@media (max-width:480px){.bza-card{padding:20px 16px;border-radius:18px}.bza-price{font-size:42px}.bza-methods,.bza-facts{grid-template-columns:1fr 1fr}.bza-all{width:100%;justify-content:center}}';
function ic(p){return '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+p+'</svg>'}
var I_PIX=ic('<path d="M12 2l4 4-4 4-4-4z"/><path d="M12 14l4 4-4 4-4-4z"/><path d="M2 12l4-4 4 4-4 4z"/><path d="M14 12l4-4 4 4-4 4z"/>'),I_CARD=ic('<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>'),I_LOCK=ic('<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>'),I_BOLT=ic('<path d="M13 2L3 14h9l-1 8 10-12h-9z"/>'),I_SHIELD=ic('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>');
function addCss(){if(D.getElementById('bza-css'))return;var s=D.createElement('style');s.id='bza-css';s.textContent=css;D.head.appendChild(s)}
function isSubView(){return new URLSearchParams(location.search).get('view')==='settings'&&location.hash==='#assinatura'}
function fixLink(){var sb=D.getElementById('workspace-context-sidebar')||D;[].forEach.call(sb.querySelectorAll('a.bz-sub-fallback,#bz-sub-link'),function(a){a.removeAttribute('target');a.removeAttribute('rel');if(a.getAttribute('href')!=='/app?view=settings#assinatura')a.setAttribute('href','/app?view=settings#assinatura');var t=[].slice.call(a.childNodes).filter(function(x){return x.nodeType===3&&/assinatura/i.test(x.textContent)})[0];if(t&&t.textContent!==L)t.textContent=L;if(isSubView())a.setAttribute('aria-current','page');else a.removeAttribute('aria-current');if(!a.__bza){a.__bza=1;a.addEventListener('click',function(e){if(e.metaKey||e.ctrlKey||e.shiftKey||e.button)return;if(new URLSearchParams(location.search).get('view')==='settings'){e.preventDefault();e.stopPropagation();if(location.hash!=='#assinatura')history.pushState(null,'','/app?view=settings#assinatura');sync();window.scrollTo(0,0)}},true)}})}
function subscriptionDisplay(data,sub){
 var l=data&&data.limits||{},s=data&&data.subscription||{},known=!!data,free=s.plan==='free',trial=l.period==='trial'||l.mode==='trial',paid=s.plan==='pro'||s.plan==='plus'||l.subscribed===true;
 var label=!known?'Consulta indisponível':sub&&sub.status==='past_due'?'Pagamento pendente':sub&&sub.status==='suspended'?'Suspensa':free?'Plano Grátis':paid?'Ativa':trial?'Acesso de teste':'Sem assinatura ativa';
 return {free:free,known:known,label:label,plan:free?'Plano Grátis':s.planName||(paid?'BIZIVA':'Acesso à Biziva'),usage:free?'Uso da franquia gratuita':trial&&!paid?'Uso do acesso de teste':'Uso de IA do período',note:free?'Você está no Plano Grátis. O acesso segue a franquia gratuita; não há renovação automática de assinatura.':!known?'Não foi possível consultar seu plano. Atualize a página para tentar novamente.':null};
}
function render(host){var l=LIM&&LIM.limits||{},s=LIM&&LIM.subscription||{},pct=typeof l.usagePercent==='number'?Math.max(0,Math.min(100,Math.round(l.usagePercent))):null;
var display=subscriptionDisplay(LIM,SUB),st=[display.label==='Ativa'?'bza-ok':'bza-warn',display.label];
var warn=l.exhausted||l.atLimit?'Seu uso do mês acabou. Pague agora para liberar chat, criativos e WhatsApp na hora.':l.warn?'Você já passou de 80% do uso. Garanta mais 30 dias antes de pausar.':'Cada pagamento libera 30 dias de uso. O que sobra não acumula.';
var renew=s.renewsOn||l.resetsOn||(SUB&&SUB.next_charge_at);if(display.note)warn=display.note;
host.innerHTML='<div class="bza-head"><div><span class="bza-eyebrow">Pagamento</span><h1>'+L+'</h1><p>Seu plano, seu uso e o pagamento em um só lugar.</p></div><a class="bza-all" href="/app?view=settings" data-bza-all>Ver todas as configurações</a></div>'
+'<div class="bza-grid"><section class="bza-card bza-status" aria-label="Plano atual"><div class="bza-row"><div class="bza-plan">Plano atual<b>'+esc(display.plan)+'</b></div><span class="bza-pill '+st[0]+'"><i></i>'+st[1]+'</span></div>'
+'<div><div class="bza-usage-top"><span>'+esc(display.usage)+'</span><b>'+(pct==null?'--':pct+'%')+'</b></div><div class="bza-track" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="'+(pct||0)+'" aria-label="'+esc(display.usage)+'"><span style="width:'+(pct||0)+'%"></span></div></div>'
+(!display.known||display.free?'':'<div class="bza-facts"><div class="bza-fact">Saldo disponível<b>'+(pct==null?'--':(100-pct)+'%')+'</b></div><div class="bza-fact">'+(SUB&&SUB.status==='active'?'Próxima cobrança':LP_ON===1&&(s.source==='launch_order'||s.source==='entitlement')?'Acesso válido até':'Uso renova em')+'<b>'+esc(dt(renew)||'Não informada')+'</b></div></div>')
+'<p class="bza-note">'+esc(warn)+(!display.free&&s.line?' '+esc(s.line):'')+'</p>'
+(SUB?'<a class="bza-manage" href="/lancamento/minha-assinatura">Gerenciar assinatura no cartão</a>':'')+'</section>'
+'<section class="bza-card bza-pay" aria-label="Pagar"><span class="bza-tag">Plano BIZIVA</span><h2>BIZIVA, 30 dias de uso</h2><div class="bza-price">R$ 89,90<small> / 30 dias</small></div>'
+'<ul class="bza-list"><li>IA de negócios, criativos e WhatsApp liberados</li><li>Liberação na hora após a aprovação</li><li>Sem fidelidade</li></ul>'
+'<button type="button" class="bza-cta" data-bza-pay>'+I_LOCK+'Pagar R$ 89,90</button><div class="bza-err" role="alert" data-bza-err></div>'
+'<div class="bza-methods"><div class="bza-m">'+I_PIX+'<span><b>Pix</b>aprovação na hora</span></div><div class="bza-m">'+I_CARD+'<span><b>Cartão</b>de crédito</span></div></div>'
+'<div class="bza-trust"><span>'+I_SHIELD+'Pagamento seguro</span><span>'+I_LOCK+'Dados criptografados</span><span>'+I_BOLT+'Acesso imediato</span></div></section></div>';
var LP=LP_ON===1&&(s.source==='launch_order'||s.source==='entitlement')&&!(SUB&&SUB.status==='active'),dl=LP&&s.renewsOn?Math.ceil((new Date(s.renewsOn)-Date.now())/864e5):null;if(LP&&(dl==null||dl>7)){var ps=host.querySelector('.bza-pay');if(ps)ps.innerHTML='<span class=bza-tag>Plano ativo</span><h2>Seu acesso está ativo</h2><div class=bza-price style=font-size:32px>Válido até '+esc(dt(s.renewsOn)||'a confirmar')+'</div><ul class=bza-list><li>IA de negócios, criativos e WhatsApp liberados</li><li>Sem cobrança automática</li><li>Nenhum pagamento é necessário agora</li></ul>'}
var pay=host.querySelector('[data-bza-pay]')||{addEventListener:function(){}};pay.addEventListener('click',function(){var er=host.querySelector('[data-bza-err]');er.textContent='';if(pay.disabled)return;pay.disabled=true;pay.lastChild.textContent='Abrindo o pagamento…';function fail(m){er.textContent=m||'Não foi possível abrir o pagamento. Tente de novo.';pay.disabled=false;pay.lastChild.textContent='Pagar R$ 89,90'}fetch('/api/lancamento/assinatura/pagar',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:'{}'}).then(function(r){return r.json().catch(function(){return {}}).then(function(j){if(r.ok&&j.url&&/^\/lancamento\/pagar\?/.test(j.url)){location.assign(j.url);return}fail(j.error)})}).catch(function(){fail('Sem conexão. Tente de novo.')})});
host.querySelector('[data-bza-all]').addEventListener('click',function(e){e.preventDefault();history.pushState(null,'','/app?view=settings');sync()})}
function sync(){addCss();fixLink();var c=q('.rd-view-settings'),on=isSubView();D.body.classList.toggle('bz-sub-mode',on&&!!c);var h=D.getElementById('bz-assinatura');if(!on||!c){if(h)h.remove();return}
if(!loaded){loaded=true;Promise.all([fetch('/api/usage/limits',{credentials:'same-origin'}).then(function(r){return r.ok?r.json():null}).catch(function(){return null}),fetch('/api/lancamento/minha-assinatura',{credentials:'same-origin'}).then(function(r){return r.ok?r.json():null}).catch(function(){return null})]).then(function(r){LIM=r[0];SUB=r[1]&&r[1].sub||null;var x=D.getElementById('bz-assinatura');if(x)render(x)})}
if(!h||h.parentNode!==c||c.firstElementChild!==h){if(!h){h=D.createElement('div');h.id='bz-assinatura';render(h)}c.insertBefore(h,c.firstElementChild)}}
var qd=false;function sched(){if(qd)return;qd=true;requestAnimationFrame(function(){qd=false;sync()})}
addEventListener('popstate',sched);addEventListener('hashchange',sched);
function start(){sync();new MutationObserver(sched).observe(D.body,{childList:true,subtree:true})}
if(D.body)start();else D.addEventListener('DOMContentLoaded',start)})();
