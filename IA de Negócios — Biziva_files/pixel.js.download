;(()=>{'use strict';if(window.__bzPixelAccess)return;window.__bzPixelAccess=1;
const css=document.createElement('style');css.textContent=`
.bz-pixel-entry{display:inline-flex;align-items:center;gap:9px;min-height:44px;padding:11px 17px!important;border:1px solid #63434d!important;border-radius:12px!important;background:#261d25!important;color:#f5efdf!important;font-family:inherit;font-size:14px;font-weight:600;line-height:1.3;cursor:pointer;margin:12px 0}.bz-pixel-entry:hover{background:#38232d!important}.bz-pixel-panel{position:static;box-sizing:border-box;width:100%;max-width:100%;margin:20px 0!important;max-height:none;overflow:visible;scroll-margin-top:85px;min-width:0;background:#121014;color:#f5efdf;border:0;border-radius:0;padding:0;font:15px/1.5 system-ui,-apple-system,sans-serif;box-shadow:none}.bz-pixel-panel *{box-sizing:border-box}.bz-pixel-head{display:flex;align-items:start;justify-content:space-between;gap:20px;padding:8px 0 22px;border-bottom:1px solid #362932}.bz-pixel-panel h2{margin:5px 0 8px;font-size:clamp(24px,4vw,32px);font-weight:600;letter-spacing:-1px}.bz-pixel-panel h3{margin:0 0 10px;font-size:18px}.bz-pixel-eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:2px;color:#c6a878}.bz-pixel-panel p{margin:6px 0 14px;color:#bdb2be;font-size:14px;line-height:1.6}.bz-pixel-body{padding:24px 0 30px;display:grid;grid-template-columns:minmax(0,1.4fr) minmax(240px,1fr);gap:22px}.bz-pixel-card{padding:22px;border:1px solid #3b2d37;border-radius:18px;background:#1b161e}.bz-pixel-card+.bz-pixel-card{margin-top:16px}.bz-pixel-panel button,.bz-pixel-panel input,.bz-pixel-panel select{font:inherit;max-width:100%}.bz-pixel-panel button{min-height:44px;padding:10px 16px;background:#30222d;border:1px solid #5a3b49;border-radius:11px;color:#f5efdf;cursor:pointer}.bz-pixel-panel .primary{background:#e1193c;border-color:#ed3554;color:white;font-weight:650}.bz-pixel-panel .primary:hover{background:#f12348}.bz-pixel-panel button:disabled{opacity:.5;cursor:wait}.bz-pixel-panel label{display:block;font-size:13px;font-weight:600;margin:15px 0 7px}.bz-pixel-panel input:not([type=checkbox]),.bz-pixel-panel select{display:block;width:100%;min-height:46px;padding:11px 13px;border:1px solid #66505e;border-radius:10px;background:#121015;color:#f5efdf}.bz-pixel-panel input::placeholder{color:#8f8190}.bz-pixel-panel .check{display:flex;gap:10px;font-weight:400;font-size:13px;align-items:start;line-height:1.55}.bz-pixel-panel .check input{flex:none;margin:4px 0;width:17px;height:17px;accent-color:#e1193c}.bz-pixel-panel .actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.bz-pixel-panel .actions button{flex:1}.bz-pixel-panel details{margin-top:18px;border-top:1px solid #3b2d37;padding-top:15px}.bz-pixel-panel summary{cursor:pointer;font-weight:600;font-size:14px}.bz-pixel-panel a{color:#efb5c4;overflow-wrap:anywhere}.bz-pixel-status{display:block;border:1px solid #51414b;border-radius:10px;padding:10px 12px;color:#d6ccd4;font-size:13px;margin:12px 0}.bz-pixel-status[data-ok=true]{background:#152b24;border-color:#35624f;color:#a8e8c6}.bz-pixel-notice{grid-column:1/-1;padding:14px 16px;border:1px solid #78503d;background:#31221e;border-radius:12px;color:#f4d4b1;overflow-wrap:anywhere}.bz-pixel-notice:empty{display:none}.bz-pixel-panel .event{padding:12px 0;border-bottom:1px solid #392b35;font-size:14px}.bz-pixel-panel .event small{display:block;color:#afa1af;margin-top:4px}.bz-pixel-panel :focus-visible{outline:3px solid #f2a4b6;outline-offset:3px}.bz-pixel-panel [hidden]{display:none!important}.bz-pixel-close{flex:none;min-width:44px}.bz-pixel-scope{font-size:12px!important;color:#b7a9b6!important}.bz-pixel-panel ul{padding-left:19px;color:#bdb2be;font-size:13px}.bz-pixel-panel .tiny{font-size:12px}@media(max-width:680px){.bz-pixel-panel{width:100%;max-height:none;border-radius:0}.bz-pixel-head{padding:8px 0 17px}.bz-pixel-body{padding:18px 0;grid-template-columns:1fr;gap:16px}.bz-pixel-card{padding:18px}.bz-pixel-panel .actions{flex-direction:column}.bz-pixel-entry{width:100%;justify-content:center}.bz-pixel-panel h2{font-size:25px}}`;
document.head.append(css);
const make=(tag,text)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=text;return e};
async function api(path,body){const r=await fetch('/api/pixel/'+path,{credentials:'same-origin',cache:'no-store',...(body?{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)}:{})});const b=await r.json();if(!r.ok)throw Error(b.error||'Não foi possível confirmar agora.');return b}
function open(){const existing=document.querySelector('.bz-pixel-panel');if(existing){existing.scrollIntoView({block:'start'});existing.querySelector('h2').focus({preventScroll:true});return;}const heading=[...document.querySelectorAll('h1,h2')].find(e=>/^(Produtos|Funil|Funis|Meus funis)$/.test(e.textContent.trim()));if(!heading)return;const anchor=heading.closest('.rd-head')||heading.parentElement,d=make('section');d.className='bz-pixel-panel';d.setAttribute('aria-labelledby','bz-pixel-title');
d.innerHTML=`<header class="bz-pixel-head"><div><span class="bz-pixel-eyebrow">Vendas · Mensuração</span><h2 id="bz-pixel-title" tabindex="-1">Pixel e Rastreamento</h2><p>Conecte a Meta e acompanhe suas compras confirmadas.</p></div></header><div class="bz-pixel-body"><div role="status" aria-live="polite" class="bz-pixel-notice"></div><div><section class="bz-pixel-card"><h3>Seu Pixel da Meta</h3><p>Comece pelo ID. Conecte a API de Conversões quando estiver pronto para enviar as compras.</p><label for="bz-px-select">Pixel cadastrado</label><select id="bz-px-select" disabled></select><form id="bz-px-form"><label for="bz-px-name">Nome para identificar</label><input id="bz-px-name" maxlength="80" placeholder="Ex.: Meu negócio"><label for="bz-px-id">ID do Pixel / conjunto de dados</label><input id="bz-px-id" inputmode="numeric" pattern="[0-9]{5,32}" required maxlength="32" placeholder="Digite o ID numérico"><label for="bz-px-page">ID da Página do Facebook (para anúncio de WhatsApp)</label><input id="bz-px-page" inputmode="numeric" pattern="[0-9]{5,32}" maxlength="32" placeholder="ID numérico da Página (opcional)"><details id="bz-px-advanced" open><summary><b>Token da API de Conversões</b> (necessário para a Meta receber suas vendas)</summary><p class="tiny"><b>Como gerar:</b> Gerenciador de Eventos → seu Pixel → Configurações → API de Conversões → “Gerar token de acesso”. Copie o token (ele começa com EAA e só aparece uma vez) e cole abaixo.</p><label for="bz-px-token">Token de acesso</label><input id="bz-px-token" type="password" autocomplete="new-password" maxlength="500" placeholder="Cole o token aqui"><p class="tiny" id="bz-px-token-hint">O token é protegido e não será exibido novamente.</p></details><div class="actions"><button class="primary" type="submit">Salvar configuração</button></div></form><details><summary>Onde encontro o ID e o token?</summary><ol><li>Abra o Gerenciador de Eventos da Meta.</li><li>Selecione seu conjunto de dados e copie o ID em Configurações.</li><li>Na aba Configurações, em API de Conversões, clique em “Gerar token de acesso” (integração direta), copie o token inteiro e cole no campo Token de acesso.</li><li>Para testar, use a aba “Testar eventos” do Gerenciador, copie o código de teste e informe-o ao testar a conexão.</li></ol><a href="https://business.facebook.com/events_manager2/" rel="noopener noreferrer">Abrir Gerenciador de Eventos ↗</a></details></section><section class="bz-pixel-card"><h3>Ativar compras confirmadas</h3><p>Esta configuração vale para as vendas registradas nesta conta. Não é uma configuração independente por produto.</p><label class="check"><input id="bz-px-ack" type="checkbox"><span>Estou autorizado a enviar à Meta os dados de compras e identificadores dos compradores para mensuração de anúncios.</span></label><div class="actions"><button type="button" class="primary" id="bz-px-activate" disabled>Ativar rastreamento</button><button type="button" id="bz-px-disable" disabled>Desativar</button></div></section></div><aside><section class="bz-pixel-card"><h3>Status da conexão</h3><span id="bz-px-state" class="bz-pixel-status">Consultando configuração…</span><p id="bz-px-last" class="tiny"></p><button type="button" id="bz-px-refresh">Atualizar status</button></section><section class="bz-pixel-card"><h3>Testar com a Meta</h3><p>Use o código da aba “Eventos de teste”. Enviaremos um evento técnico, sem compra, valor ou dados de clientes.</p><label for="bz-px-test-code">Código de teste</label><input id="bz-px-test-code" maxlength="40" placeholder="Ex.: TEST12345"><label class="check"><input id="bz-px-test-ack" type="checkbox"><span>Enviar o evento técnico de teste para este Pixel.</span></label><div class="actions"><button type="button" id="bz-px-test" disabled>Testar conexão</button></div><p id="bz-px-test-state" role="status" class="tiny"></p></section><section class="bz-pixel-card"><h3>O que é rastreado</h3><div class="event">Compra confirmada <small>Checkout aprovado ou Pix conferido pelo vendedor no extrato.</small></div><div class="event">Conversa e início de checkout <small>Não enviados por esta integração.</small></div><p class="bz-pixel-scope">Salvar o ID não ativa o envio. Um teste aceito não comprova atribuição de venda a anúncio.</p><a href="/app?view=sales">Ver vendas e eventos →</a></section></aside></div>`;
anchor.after(d);document.querySelector('.bz-pixel-entry')?.setAttribute('aria-expanded','true');const q=id=>d.querySelector('#'+id),notice=d.querySelector('.bz-pixel-notice'),select=q('bz-px-select');let data=null,busy=false,sequence=0;
const tell=t=>notice.textContent=t;const chosen=()=>data?.pixels.find(p=>p.id===select.value);
function controls(){const p=chosen();q('bz-px-activate').disabled=busy||!p?.hasToken;q('bz-px-disable').disabled=busy||!data?.config?.enabled;q('bz-px-test').disabled=busy||!p?.hasToken;select.disabled=busy;d.querySelector('#bz-px-form button').disabled=busy;q('bz-px-refresh').disabled=busy;}
function fill(){const p=chosen();q('bz-px-name').value=p?.name||'';q('bz-px-id').value=p?.pixel_id||'';q('bz-px-page').value=p?.page_id||'';q('bz-px-token').value='';q('bz-px-token-hint').textContent=p?.hasToken?'Token salvo. Deixe vazio para manter ou cole outro para substituir.':'Sem token salvo: a Meta ainda não recebe suas vendas. Cole o token da API de Conversões acima e salve.';controls();}
async function load(wanted){const serial=++sequence;try{const next=await api('settings');if(!d.isConnected||serial!==sequence)return;data=next;const value=wanted||select.value||data.config?.pixel_row;select.replaceChildren(...data.pixels.map(p=>new Option(p.name+' · '+p.pixel_id+(p.hasToken?'':' · SEM TOKEN'),p.id)),new Option('Cadastrar outro Pixel','new'));select.value=data.pixels.some(p=>p.id===value)?value:data.pixels[0]?.id||'new';const on=!!data.config?.enabled;q('bz-px-state').textContent=on?'Envio ativo · '+(data.pixels.find(p=>p.id===data.config.pixel_row)?.name||'Pixel cadastrado'):data.pixels.length?'Configuração salva · envio desativado':'Nenhum Pixel cadastrado';q('bz-px-state').dataset.ok=String(on);const states={sent:'Evento aceito pela Meta',test_sent:'Evento aceito com código de teste',unknown:'Envio incerto · confira na Meta',error:'Evento recusado',queued:'Evento na fila',dispatching:'Enviando evento',cancelled:'Evento cancelado',expired:'Evento expirado',missing_identity:'Falta identificador do comprador',retry:'Nova tentativa programada'};q('bz-px-last').textContent=data.lastEvent?(states[data.lastEvent.state]||'Evento pendente')+' · '+new Date(data.lastEvent.updated_at).toLocaleString('pt-BR'):'Nenhuma compra enviada por esta integração.';if(data.lastTest)q('bz-px-test-state').textContent=data.lastTest.state==='accepted'?'Último teste aceito pela API da Meta. Confira também no Gerenciador de Eventos.':data.lastTest.state==='rejected'?'Último teste recusado. Confira o token, o Pixel e suas permissões.':'Último teste sem confirmação. Confira na Meta antes de repetir.';fill();}catch(e){tell(e.message);q('bz-px-state').textContent='Consulta indisponível';q('bz-px-state').dataset.ok='false';} }
async function action(fn){if(busy)return;busy=true;controls();tell('');try{await fn()}catch(e){if(d.isConnected)tell(e.message)}finally{busy=false;if(d.isConnected)controls()}}
select.onchange=fill;q('bz-px-refresh').onclick=()=>action(()=>load());q('bz-px-form').onsubmit=e=>{e.preventDefault();action(async()=>{const r=await api('draft',{name:q('bz-px-name').value,pixelId:q('bz-px-id').value,pageId:q('bz-px-page').value,token:q('bz-px-token').value});q('bz-px-token').value='';await load(r.pixelRow);tell(data?.config?.enabled?'Configuração salva. O envio de compras continua ativo para o Pixel indicado no status.':'Configuração salva. Ative abaixo para enviar novas compras confirmadas.');})};
q('bz-px-activate').onclick=()=>action(async()=>{if(!q('bz-px-ack').checked)throw Error('Confirme a autorização antes de ativar.');await api('activate',{pixelRow:select.value,acknowledged:true});await load();tell('Rastreamento ativado para novas compras confirmadas desta conta.');});q('bz-px-disable').onclick=()=>action(async()=>{await api('disable',{});await load();tell('Envio de compras à Meta desativado.');});q('bz-px-test').onclick=()=>action(async()=>{if(!q('bz-px-test-ack').checked)throw Error('Confirme o envio do evento técnico de teste.');const r=await api('test',{pixelRow:select.value,testCode:q('bz-px-test-code').value.trim(),requestId:crypto.randomUUID(),acknowledged:true});await load();tell(r.state==='accepted'?'Teste aceito pela API da Meta. Confira o evento no Gerenciador de Eventos.':r.state==='rejected'?'A Meta recusou o teste. Confira o token, o Pixel e suas permissões.':'Não recebemos confirmação do teste. Confira na Meta antes de enviar outro.');});
d.id='bz-pixel-config';d.scrollIntoView({block:'start'});d.querySelector('h2').focus({preventScroll:true});load();}
let scheduled=false;function mount(){scheduled=false;const view=new URL(location.href).searchParams.get('view');if(!['products','funil','funnel'].includes(view)){document.querySelectorAll('.bz-pixel-entry,.bz-pixel-panel').forEach(e=>{const token=e.querySelector('#bz-px-token');if(token)token.value='';e.remove()});return;}const h=[...document.querySelectorAll('h1,h2')].find(e=>/^(Produtos|Funil|Funis|Meus funis)$/.test(e.textContent.trim()));if(!h||document.querySelector('.bz-pixel-entry'))return;const b=make('button','◎  Pixel e Rastreamento');b.type='button';b.className='bz-pixel-entry';b.setAttribute('aria-controls','bz-pixel-config');b.setAttribute('aria-expanded','false');b.onclick=open;h.parentElement.append(b);}
new MutationObserver(()=>{if(!scheduled){scheduled=true;requestAnimationFrame(mount)}}).observe(document.documentElement,{childList:true,subtree:true});mount();
})();
