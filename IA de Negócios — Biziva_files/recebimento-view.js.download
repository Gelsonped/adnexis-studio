fetch("/api/cep?cep="+code,{credentials:"same-origin",signal:abort.signal}).then(function(r){return r.json().then(function(a){if(!r.ok)throw Error(a.error||a.message||"Não foi possível consultar o CEP.");return a})}).then(function(a){if(ticket!==cepSeq||$("zip")!==zipNode||v("zip").replace(/\D/g,"")!==code)return;if(!a.city||!a.state)throw Error("Não foi possível confirmar o endereço.");Object.keys(fields).forEach(function(k){if(v(k)===before[k])$(k).value=String(a[fields[k]]||"")});cepApplied=code;cepStatus.textContent=a.address&&a.province?"Endereço encontrado. Confira os dados e informe o número.":"CEP encontrado. Complete a rua e o bairro se não vieram preenchidos."}).catch(function(e){if(ticket===cepSeq&&$("zip")===zipNode)cepStatus.textContent=e.message+" Você pode preencher o endereço manualmente e tentar novamente ao sair do campo CEP."}).finally(function(){clearTimeout(timer);if(ticket===cepSeq){cepPending="";cepAbort=null}})}
zipNode.oninput=lookupCep;zipNode.onchange=lookupCep;zipNode.onblur=lookupCep;
$("imp").onclick=function(){cancelCep();cepApplied="";var m=$("msg");fetch("/api/recipient/prefill",{credentials:"same-origin"}).then(function(r){return r.json()}).then(function(d){if(!d.ok){m.className="bad";m.textContent=d.message||"Sem cadastro anterior.";return}var x=d.data,S=function(i,val){if(val!=null&&(val!==""||window.__bzIncomeOff)&&$(i))$(i).value=val};S("kind",x.kind);k.onchange();["name","document","email","phone","income","birthdate","occupation","trading_name","founding_date"].forEach(function(f){S(f,x[f])});S("p_name",x.partner.name);S("p_document",x.partner.document);S("p_birthdate",x.partner.birthdate);S("p_occupation",x.partner.occupation);Object.keys(x.address).forEach(function(f){S(f,x.address[f])});S("bank",x.bank.bank);S("branch",x.bank.branch);S("branch_digit",x.bank.branch_digit);S("account",x.bank.account);S("account_digit",x.bank.account_digit);S("btype",x.bank.type);m.className="sub";m.textContent="Dados importados. Revise e envie."})};
