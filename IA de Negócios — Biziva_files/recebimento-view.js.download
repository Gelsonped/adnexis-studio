var STS={none:["Não enviado","Envie seus dados para começar a receber suas vendas e comissões direto na sua conta bancária."],review:["Em análise","Recebemos seus dados. A análise costuma levar até 2 dias úteis e você acompanha tudo por aqui."],approved:["Aprovado","Tudo certo! Suas vendas e comissões no cartão já caem na sua conta bancária."],rejected:["Rejeitado","Seus dados não foram aprovados. Corrija e reenvie para nova análise."]};
function render(d){var m=document.getElementById("rc-m");if(!m)return;var r=d.recipient||{state:"none"},st=STS[r.state]?r.state:"none",s=STS[st];
var lv={none:0,review:2,approved:3,rejected:2}[st];var tl='<div class="rc-tl">'+["Dados enviados","Em análise",st==="rejected"?"Rejeitado":"Aprovado"].map(function(x,i){return'<div class="'+(st==="rejected"&&i===2?"x":(i<lv||(st==="review"&&i===1)?"d":""))+'">'+x+'</div>'}).join("")+'</div>';
var h='<section class="rc-card rc-hero s-'+st+'"><div class="rc-ic">'+SV(IC[st])+'</div><div style="flex:1;min-width:0"><span class="rc-k">Situação do cadastro</span><h2>'+s[0]+'</h2><p class="sub">'+s[1]+'</p>'+(r.name?'<p class="rc-who">'+E(r.name)+(r.document?' · '+E(r.document):'')+'</p>':'')+(st==="rejected"&&r.reason?'<div class="rc-why"><strong>Motivo:</strong> '+E(r.reason)+'</div>':'')+(st!=="none"?tl:'')+(st==="rejected"&&!d._resend?'<div class="row"><button type="button" class="primary-button" id="rc-re">Reenviar dados</button></div>':'')+'</div></section>';
if(st==="review"&&r.can_verify)h+='<section class="rc-card"><h3 style="margin:0">Documentos de identidade</h3><p class="sub">Último passo para concluir a análise.</p><div class="rc-up">'+SV('<path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/>')+'<div style="flex:1"><strong>Documento com foto + selfie</strong><ul><li>RG ou CNH, frente e verso</li><li>Selfie em local iluminado</li></ul></div>'+'<button type="button" class="primary-button" id="rc-kyc">Enviar documentos</button>'+'</div></section>';
var showForm=st==="none"||d._resend;m.innerHTML=h+(showForm?FORM:"");if(showForm)wire();
var re=document.getElementById("rc-re");if(re)re.onclick=function(){d._resend=true;render(d);var f=document.getElementById("rc-form");if(f)f.scrollIntoView({behavior:"smooth"})};
var kb=document.getElementById("rc-kyc");
if(kb)kb.onclick=function(){
  kb.disabled=true;
  P("/api/recipient/kyc",{}).then(function(x){
    if(x.ok&&x.recipient&&x.recipient.verify_url){openKyc(x.recipient.verify_url);return}
    if(x.recipient)render(x);
    showKycMessage(x.message);
  }).catch(function(){showKycMessage()});
}}
function showKycMessage(message){
  var m=document.getElementById("rc-m"),b=document.getElementById("rc-kyc");
  if(!m)return;
  if(b)b.disabled=false;
  var status=document.getElementById("rc-kyc-status");
  if(!status){status=document.createElement("p");status.id="rc-kyc-status";status.className="sub";status.setAttribute("role","status");if(b)b.insertAdjacentElement("afterend",status);else m.appendChild(status)}
  status.textContent=message||"Não foi possível iniciar agora. Tente novamente em instantes.";
}
function openKyc(url){
  try{sessionStorage.setItem("bzKycBack","1")}catch(e){}
  if(location.pathname+location.search!=="/app?view=recebimento")history.replaceState(history.state,"","/app?view=recebimento");
  location.assign(url);
}
function load(){fetch("/api/recipient",{credentials:"same-origin"}).then(function(r){if(!r.ok)throw Error(r.status===401?"Sessão expirada. Entre novamente para consultar seus dados.":"Não foi possível consultar seus dados agora. Tente novamente.");return r.json()}).then(function(d){if(!d||d.ok===false||!d.recipient||!STS[d.recipient.state])throw Error("Não foi possível consultar seus dados agora. Tente novamente.");render(d)}).catch(function(e){var m=document.getElementById("rc-m");if(m){m.innerHTML='<p class="sub" role="status">'+E(e.message||"Não foi possível carregar.")+'</p><button type="button" class="ghost-button" id="rc-retry">Tentar novamente</button>';document.getElementById("rc-retry").onclick=load}})}
function host(){var h=document.getElementById("bz-inshell");if(h)return h;var m=document.querySelector(".workspace-main");if(!m)return null;h=document.createElement("div");h.id="bz-inshell";m.appendChild(h);return h}
function show(push){var h=host();if(!h||!document.querySelector(".workspace-shell"))return setTimeout(function(){show(push)},300);if(push)history.pushState({bzView:"recebimento"},"","/app?view=recebimento");on=true;document.documentElement.classList.remove("bz-fin-on");document.documentElement.classList.add("bz-inshell-on","bz-rcb-on");document.title="Dados para recebimento — Biziva";var wc=document.querySelector(".workspace-content"),pad=wc?getComputedStyle(wc).padding:"";
h.innerHTML='<style>'+css+'</style><div id="bz-rcb" class="page-stack" style="padding:'+(pad&&pad!=="0px"?pad:"28px 32px 64px")+'"><div class="page-title"><div><span class="eyebrow">Financeiro</span><h1>Dados para recebimento</h1><p>Envie seus dados e documentos para receber suas vendas e comissões na sua conta bancária.</p></div></div><div id="rc-m" class="page-stack"><p class="sub">Carregando…</p></div></div>';load()}
function hide(){if(!on)return;on=false;document.documentElement.classList.remove("bz-rcb-on");var h=document.getElementById("bz-inshell");if(h&&h.querySelector("#bz-rcb")){h.innerHTML="";document.documentElement.classList.remove("bz-inshell-on")}}
window.__bzRcbShow=show;
document.addEventListener("click",function(e){if(!on)return;var b=e.target.closest&&e.target.closest("#workspace-context-sidebar button,#workspace-context-sidebar a");if(!b||b.classList.contains("contextual-close")||b.classList.contains("nav-group-toggle"))return;hide()},true);
window.addEventListener("popstate",function(){if(new URLSearchParams(location.search).get("view")==="recebimento")show(false);else hide()});
if(new URLSearchParams(location.search).get("view")==="recebimento")show(false);})();