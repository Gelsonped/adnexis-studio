var css='.bz-rcb-on .workspace-content{display:none!important}#bz-inshell{flex:1;min-height:0;overflow:auto}#bz-rcb{max-width:920px}#bz-rcb .sub{color:var(--bv-muted);font-size:13px;line-height:1.5;margin:4px 0 0}#bz-rcb .rc-card{background:var(--bv-surface,#15161b);border:1px solid var(--bv-line);border-radius:var(--bv-radius,18px);padding:22px 24px}#bz-rcb .rc-hero{display:flex;gap:16px;align-items:flex-start;position:relative;overflow:hidden}#bz-rcb .rc-hero:before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:var(--rc-c,var(--bv-muted))}#bz-rcb .rc-ic{flex:0 0 46px;height:46px;border-radius:14px;display:grid;place-items:center;background:color-mix(in srgb,var(--rc-c,#aba9b3) 16%,transparent);color:var(--rc-c,var(--bv-muted))}#bz-rcb .rc-ic svg{width:22px;height:22px}#bz-rcb .rc-hero h2{margin:2px 0 0;font-size:20px}#bz-rcb .rc-k{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--bv-muted)}#bz-rcb .s-none{--rc-c:#aba9b3}#bz-rcb .s-review{--rc-c:#f0b35a}#bz-rcb .s-approved{--rc-c:#5fd08a}#bz-rcb .s-rejected{--rc-c:#ff6b80}#bz-rcb .rc-who{margin-top:8px;font-size:13px;color:var(--bv-text)}#bz-rcb .rc-why{margin-top:12px;padding:10px 12px;border-radius:10px;background:#ff6b8014;border:1px solid #ff6b8040;color:#ffb3bf;font-size:13px}#bz-rcb .rc-tl{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:18px}#bz-rcb .rc-tl div{font-size:12px;color:var(--bv-muted);padding-top:10px;border-top:3px solid var(--bv-line)}#bz-rcb .rc-tl .d{color:var(--bv-text);border-color:var(--bv-accent,#df2944)}#bz-rcb .rc-tl .x{color:#ff6b80;border-color:#ff6b80}#bz-rcb .rc-steps{display:flex;gap:6px;margin:0 0 18px;padding:0;list-style:none;flex-wrap:wrap}#bz-rcb .rc-steps li{flex:1;min-width:0;display:flex;align-items:center;gap:8px;font-size:12px;color:var(--bv-muted);padding:8px 10px;border-radius:10px;background:var(--bv-raised,#1c1d23);cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#bz-rcb .rc-steps b