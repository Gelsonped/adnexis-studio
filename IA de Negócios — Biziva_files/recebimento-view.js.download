+'<div class="rc-pane" data-p="0"><h3>Quem vai receber</h3><p class="sub">Use os dados do titular. A conta bancária precisa estar no mesmo CPF/CNPJ.</p><select id="rc-kind" hidden><option value="pf">pf</option><option value="pj">pj</option></select><div class="seg"><button type="button" data-k="pf" class="on"><strong>Pessoa física</strong>CPF</button><button type="button" data-k="pj"><strong>Pessoa jurídica</strong>CNPJ</button></div>'
+'<div class="g">'+F("name","Nome completo / Razão social","","",1)+F("document","CPF / CNPJ","000.000.000-00","","","numeric")+F("phone","Celular com DDD","(11) 99999-9999","tel")+F("email","E-mail","voce@email.com","email")+F("income","Renda mensal (PF) / Faturamento anual (PJ)","R$ 5.000,00","","","decimal")+'</div>'
+'<div class="g" id="rc-pf">'+F("birthdate","Data de nascimento","","date")+F("occupation","Profissão")+F("mother_name","Nome da mãe (opcional)","","",1)+'</div>'
+'<div class="g" id="rc-pj" hidden>'+F("trading_name","Nome fantasia")+F("founding_date","Data de abertura","","date")+F("p_name","Representante: nome")+F("p_document","Representante: CPF","","","","numeric")+F("p_birthdate","Representante: nascimento","","date")+F("p_occupation","Representante: profissão")+'</div></div>'
+'<div class="rc-pane" data-p="1" hidden><h3>Endereço</h3><p class="sub">Digite o CEP que a gente completa o resto.</p><div class="rg4">'+F("zip","CEP","00000-000","","rs2","numeric",9)+F("street","Rua","","","rs3")+F("number","Número","","","","numeric")+F("complement","Complemento","Opcional","","rs2")+F("neighborhood","Bairro","","","rs2")+F("city","Cidade","","","rs3")+F("state","UF","SP","","","",2)+'</div></div>'
+'<div class="rc-pane" data-p="2" hidden><h3>Conta bancária</h3><p class="sub">Onde suas vendas e comissões vão cair.</p><div class="rg4">'+F("bank","Banco (código)","Ex.: 260","","rs4","numeric",3)+F("branch","Agência","Sem dígito","","","numeric",5)+F("branch_digit","Dígito","Opcional","","","",1)+F("account","Conta","Sem dígito","","","numeric",13)+F("account_digit","Dígito","0","","","",2)+'<div class="rs4"><label for="rc-btype">Tipo de conta</label><select id="rc-btype"><option value="checking">Corrente</option><option value="savings">Poupança</option></select></div></div><div class="rc-safe">'+SV('<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>').replace('<svg','<svg width="16" height="16"')+'Seus dados ficam protegidos e só são usados para os seus pagamentos.</div></div>'
+'<div class="row"><button type="button" class="ghost-button" id="rc-imp">Usar dados do cadastro anterior</button><span class="sp"></span><button type="button" class="ghost-button" id="rc-back" hidden>Voltar</button><button type="button" class="primary-button" id="rc-next">Continuar</button><button type="button" class="primary-button" id="rc-go" hidden>Enviar para análise</button></div><p id="rc-msg" class="sub"></p></section>';
