var P=function(u,b){return fetch(u,{method:"POST",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify(b)}).then(function(r){return r.json()})};
function body(){return{kind:v("kind"),name:v("name"),document:v("document"),email:v("email"),phone:v("phone"),income:v("income"),birthdate:v("birthdate"),occupation:v("occupation"),mother_name:v("mother_name"),trading_name:v("trading_name"),founding_date:v("founding_date"),partner:{name:v("p_name"),document:v("p_document"),birthdate:v("p_birthdate"),occupation:v("p_occupation")},address:{zip:v("zip"),street:v("street"),number:v("number"),complement:v("complement"),neighborhood:v("neighborhood"),city:v("city"),state:v("state")},bank:{bank:v("bank"),branch:v("branch"),branch_digit:v("branch_digit"),account:v("account"),account_digit:v("account_digit"),type:v("btype")}}}
function moneyOk(x){var t=String(x==null?'':x).slice(0,40).replace(/r\$/gi,'').replace(/\s+/g,'');if(!/^[\d.,]+$/.test(t)||!/\d/.test(t))return false;var i=Math.max(t.lastIndexOf(','),t.lastIndexOf('.')),tail=i>=0?t.slice(i+1):'',dec=i>=0&&tail.length>=1&&tail.length<=2,ip=(dec?t.slice(0,i):t).replace(/[.,]/g,'')||'0',n=Number(ip+(dec?'.'+tail:''));return isFinite(n)&&Math.round(n*100)>=100}
function receiptStepError(n,get){
 var kind=get('kind'),required=n===0?['name','document','phone','email','income'].concat(kind==='pj'?['trading_name','founding_date','p_name','p_document','p_birthdate','p_occupation']:['birthdate','occupation']):n===1?['zip','street','number','neighborhood','city','state']:['bank','branch','account','account_digit'];
 var labels={name:'nome do titular',document:'CPF ou CNPJ',phone:'celular com DDD',email:'e-mail',income:'renda ou faturamento',trading_name:'nome fantasia',founding_date:'data de abertura',p_name:'nome do representante',p_document:'CPF do representante',p_birthdate:'nascimento do representante',p_occupation:'profissão do representante',birthdate:'data de nascimento',occupation:'profissão',zip:'CEP',street:'rua',number:'número',neighborhood:'bairro',city:'cidade',state:'UF',bank:'código do banco',branch:'agência',account:'conta',account_digit:'dígito da conta'};
 for(var id of required){var val=String(get(id)||'').trim();if(!val)return{id:id,message:'Preencha '+labels[id]+' para continuar.'};var digits=val.replace(/\D/g,'');
  if((id==='document'&&digits.length!==(kind==='pj'?14:11))||(id==='p_document'&&digits.length!==11))return{id:id,message:'Confira os dígitos do '+labels[id]+'.'};
  if(id==='phone'&&!/^\d{10,11}$/.test(digits))return{id:id,message:'Informe o celular com DDD.'};
  if(id==='email'&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val))return{id:id,message:'Informe um e-mail válido.'};
  if(id==='zip'&&digits.length!==8)return{id:id,message:'Informe os 8 dígitos do CEP.'};
  if(id==='state'&&!/^(AC|AL|AP|AM|BA|CE|DF|ES|GO|MA|MT|MS|MG|PA|PB|PR|PE|PI|RJ|RN|RS|RO|RR|SC|SP|SE|TO)$/i.test(val))return{id:id,message:'Informe uma UF válida, como SP ou MG.'};
  if(id==='bank'&&!/^\d{3}$/.test(val))return{id:id,message:'Informe os 3 dígitos do banco.'};
  if(id==='income'&&!window.__bzIncomeOff&&!moneyOk(val))return{id:id,message:'Digite só números, ex.: 3000,00'};
 }
 return null;
}
function validateReceiptStep(n){var err=receiptStepError(n,v);if(!err)return true;go(n);var node=$(err.id),m=$('msg');m.className='bad';m.textContent=err.message;m.setAttribute('role','alert');if(node){node.setAttribute('aria-invalid','true');var eid=node.id+'-error',inline=document.getElementById(eid);if(!inline){inline=document.createElement('small');inline.id=eid;inline.className='bad';inline.style.display='block';node.insertAdjacentElement('afterend',inline)}inline.textContent=err.message;node.setAttribute('aria-describedby',eid);node.focus();node.scrollIntoView({block:'center',behavior:'smooth'});}return false;}
function moveReceiptStep(n){if(n>step){for(var i=0;i<n;i++)if(!validateReceiptStep(i))return;}go(n);$('msg').textContent='';}
function go(n){step=n;[].forEach.call(document.querySelectorAll("#rc-form .rc-pane"),function(p){p.hidden=+p.dataset.p!==n});[].forEach.call(document.querySelectorAll("#rc-form .rc-steps li"),function(l){var i=+l.dataset.s;l.className=i===n?"on":(i<n?"ok":"")});$("back").hidden=n===0;$("next").hidden=n===STEPS.length-1;$("go").hidden=n!==STEPS.length-1;var f=document.getElementById("rc-form");if(f&&f.getBoundingClientRect().top<0)f.scrollIntoView({behavior:"smooth"})}
function wire(){document.getElementById("rc-form").addEventListener("input",function(e){e.target.removeAttribute("aria-invalid");var err=document.getElementById(e.target.id+"-error");if(err)err.textContent=""});var k=$("kind");if(!k)return;step=0;k.onchange=function(){$("pf").hidden=k.value!=="pf";$("pj").hidden=k.value!=="pj";[].forEach.call(document.querySelectorAll("#rc-form .seg button"),function(b){b.classList.toggle("on",b.dataset.k===k.value)})};[].forEach.call(document.querySelectorAll("#rc-form .seg button"),function(b){b.onclick=function(){k.value=b.dataset.k;k.onchange()}});[].forEach.call(document.querySelectorAll("#rc-form .rc-steps li"),function(l){l.setAttribute("role","button");l.tabIndex=0;l.onclick=function(){moveReceiptStep(+l.dataset.s)};l.onkeydown=function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();moveReceiptStep(+l.dataset.s)}}});$("next").onclick=function(){moveReceiptStep(step+1)};$("back").onclick=function(){go(step-1)};go(0);
var zipNode=$("zip"),cepSeq=0,cepPending="",cepApplied="",cepAbort=null,cepStatus=document.createElement("p");cepStatus.id="rc-cep-status";cepStatus.className="sub";cepStatus.setAttribute("role","status");cepStatus.setAttribute("aria-live","polite");zipNode.parentNode.appendChild(cepStatus);
function cancelCep(){cepSeq++;cepPending="";if(cepAbort)cepAbort.abort();cepAbort=null;cepStatus.textContent=""}
