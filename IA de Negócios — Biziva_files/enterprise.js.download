
function applyTopupPolicy(policy,input,label){
  if(!policy||!Number.isSafeInteger(policy.minCents)||policy.minCents<2000)return;
  function update(){
    const expired=policy.expiresAt&&Date.now()>=Date.parse(policy.expiresAt);
    const min=policy.minCents;
    const previous=input.min;input.min=String(min/100);
    if(!input.dataset.topupEdited&&(input.value==='100'||input.value===previous))input.value=String(min/100);
    label.textContent='Recarga mínima: R$'+(min/100).toFixed(2).replace('.',',')+'. Máxima: R$5.000,00.';
  }
  if(!input.dataset.topupPolicyBound){input.dataset.topupPolicyBound='1';input.addEventListener('input',()=>{input.dataset.topupEdited='1'},{once:true});}update();
  if(input.__topupPolicyTimer)clearTimeout(input.__topupPolicyTimer);
  if(policy.expiresAt){const delay=Date.parse(policy.expiresAt)-Date.now();if(delay>0&&delay<86400001)input.__topupPolicyTimer=setTimeout(update,delay+50);}
}
(() => {
  if(window.__bizivaEnterprise)return;window.__bizivaEnterprise=true;
  const css=document.createElement('style');css.textContent=`.bz-card-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:8px 0}.bz-card-row a{color:#f6efdf;text-decoration:underline}.bz-pay-m,.bz-card-row select{background:#16161b;color:#f6efdf;border:1px solid #f6efdf33;max-width:100%}.bz-card-row[hidden]{display:none}.bz-pay-m,.bz-card-row select{font:inherit;padding:8px;border-radius:10px}.bz-aff-row{display:flex;gap:8px;margin:10px 0}.bz-aff-row input{flex:1;min-width:0}.bz-aff p{overflow-wrap:anywhere}.bz-pix-st[data-warn]{color:#f2c46d}.bz-doc>div{margin-top:12px;color:rgba(245,236,220,.82);font-size:14px;line-height:1.55}.bz-doc h3{margin:20px 0 8px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#f5ecdc}.bz-doc pre{margin:8px 0;padding:12px 14px;border-radius:12px;background:#0a0a0d;border:1px solid #ffffff14;overflow-x:auto;font-size:12.5px;line-height:1.5}.bz-doc code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12.5px;color:#f5ecdc}.bz-doc p code,.bz-doc td code{padding:1px 5px;border-radius:6px;background:#ffffff10}.bz-doc table{width:100%;border-collapse:collapse;margin:6px 0}.bz-doc td{padding:8px 6px;border-top:1px solid #ffffff12;vertical-align:top}.bz-doc td:first-child{white-space:nowrap;color:#ff6b80;padding-right:14px}@media(max-width:600px){.bz-doc td{display:block;padding:4px 0}.bz-doc td:first-child{border-top:1px solid #ffffff12;padding-top:10px;white-space:normal}.bz-doc tr td:last-child{border-top:0}}.bz-doc-lead{font-size:15px;color:#f5ecdc}.bz-doc pre code{padding:0!important;background:none!important;border:0!important;white-space:pre}.bz-doc table{table-layout:fixed}.bz-doc td{overflow-wrap:anywhere}.bz-doc td code{white-space:normal;overflow-wrap:anywhere}.bz-doc>div{min-width:0;max-width:100%}.bz-doc td,.bz-doc td:first-child{white-space:normal!important}.bz-doc{max-width:100%;min-width:0;box-sizing:border-box;overflow:hidden}@media(max-width:600px){.bz-doc table,.bz-doc tbody,.bz-doc tr{display:block;width:100%}}.enterprise-dialog{width:min(850px,94vw);max-height:88dvh;padding:28px;border:1px solid #ffffff20;border-radius:22px;background:#101014;color:#f6efdf;box-shadow:0 30px 100px #000b;font:15px/1.5 system-ui}.enterprise-dialog::backdrop{background:#000a;backdrop-filter:blur(6px)}.enterprise-dialog h1{font-size:30px;margin:8px 0}.enterprise-dialog h2{font-size:18px;margin:0 0 12px}.enterprise-dialog section{padding:20px 0;border-top:1px solid #ffffff18}.enterprise-dialog p{color:#bcb8bf}.enterprise-dialog button{padding:11px 16px;border-radius:12px;border:1px solid #ffffff24;background:#24242b;color:#f6efdf;font:inherit;cursor:pointer}.enterprise-dialog button[type=submit]{background:#dd1835;border-color:#dd1835}.enterprise-dialog button:disabled{opacity:.5;cursor:default}.enterprise-dialog input,.enterprise-dialog select,.enterprise-dialog textarea{box-sizing:border-box;width:100%;background:#19191f;color:#f6efdf;border:1px solid #ffffff25;border-radius:10px;padding:11px;font:inherit;margin:7px 0 14px}.enterprise-dialog textarea{overflow-wrap:anywhere;resize:vertical}.enterprise-dialog header{display:flex;gap:20px;align-items:flex-start;justify-content:space-between}.enterprise-dialog [role=alert]{color:#ffb9c2}.enterprise-key{padding:14px 0;border-top:1px solid #ffffff15;display:flex;gap:20px;justify-content:space-between;align-items:center}.enterprise-dialog ul{list-style:none;padding:0}.enterprise-dialog :focus-visible{outline:2px solid #ff8799;outline-offset:3px}.enterprise-dialog small{color:#aaa4af}.bz-pix{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:6px}.bz-pix input{width:150px;min-width:110px;margin:0}.enterprise-dialog .bz-pix-go{background:#cc1432;border-color:#cc1432;color:#f6efdf;font-weight:600}.bz-pix-out{display:grid;grid-template-columns:180px 1fr;gap:18px;align-items:start;margin-top:16px;padding:16px;border:1px solid #f6efdf22;border-radius:16px;background:#16161b}.bz-pix-out img{width:180px;height:180px;border-radius:12px;background:#f6efdf;padding:8px;box-sizing:border-box}.bz-pix-out textarea{font:12px/1.4 ui-monospace,monospace;margin:6px 0 10px}.bz-pix-st{color:#f6efdf;font-weight:600}.bz-pix-st[data-ok]{color:#7fe0a0}@media(max-width:600px){.bz-pix-out{grid-template-columns:1fr;justify-items:center}.bz-pix input{flex:1}.enterprise-dialog .bz-pix-go{flex-basis:100%}}@media(max-width:600px){.enterprise-dialog{padding:20px}.enterprise-key{align-items:flex-start;flex-direction:column}}`;
  document.head.append(css);
  const DOC_HTML="<section class=\"bz-ai-guide\" aria-label=\"Guia de integração com sua IA\" style=\"padding:22px;border:1px solid #49434d;border-radius:16px;margin:16px 0;background:#17161c\"><h2 style=\"margin:0 0 10px;font-size:21px\">Integre seu sistema com ajuda da sua IA</h2><p style=\"line-height:1.6;margin:0 0 12px\">Não sabe programar? Baixe o guia e envie ao ChatGPT, Claude, Cursor ou à IA que ajuda você a desenvolver seu sistema. Ele reúne os recursos da API e as instruções para fazer a integração.</p><ol style=\"line-height:1.7;padding-left:22px\"><li>Baixe o PDF abaixo.</li><li>Anexe o arquivo à sua IA e cole o pedido pronto.</li><li>Diga qual é o seu sistema e o que deseja integrar.</li></ol><div style=\"display:flex;gap:10px;flex-wrap:wrap;align-items:center\"><a class=\"button bz-guide-download\" href=\"https://api.biziva.com.br/docs/biziva-api-integracao.pdf\" download=\"BIZIVA-API-integracao.pdf\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:10px 16px;border-radius:10px;background:#cc1432;color:#fff;text-decoration:none;font-weight:600\">Baixar guia para integrar com sua IA</a><button type=\"button\" data-biziva-guide-copy style=\"min-height:44px\">Copiar pedido para a IA</button></div><p role=\"status\" data-biziva-guide-status style=\"margin:10px 0 0\"></p><p style=\"font-size:13px;line-height:1.5;margin:10px 0 0;color:#bbb6c1\">Guia atualizado em 17/10/2026 · 19 páginas · PDF. A IA precisa ter acesso ao projeto ou orientar você nas alterações. Configure sua chave somente no servidor, nunca no chat da IA.</p></section><h3>Conexão técnica</h3><pre><code>Base: https://api.biziva.com.br/v1\\nAuthorization: Bearer SUA_CHAVE_BIZIVA</code></pre><p>Chat: POST /chat/completions. Catálogo: GET /models. Consumo e saldo: GET /usage. Envie Idempotency-Key em operações pagas. Use charged_brl para o consumo fracionário.</p><p>Recursos e exemplos completos: <a href=\"https://api.biziva.com.br/docs\" target=\"_blank\" rel=\"noopener\">abrir documentação atual</a>. Para recursos da Central da empresa, confirme conta, chave e permissões no console da API.</p>";
  const el=(tag,text)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=text;return e;};
  async function request(path,method='GET',data){const response=await fetch(path,{method,credentials:'same-origin',cache:'no-store',headers:data?{'content-type':'application/json'}:{},...(data?{body:JSON.stringify(data)}:{})});const body=await response.json();if(!response.ok)throw Error(typeof body.error==='string'?body.error:'Não foi possível confirmar a operação.');return body;}
  function open(target){
    if(!(target instanceof Element))target=null;
    if(document.getElementById('biziva-enterprise-dialog')){if(!target)return;document.getElementById('biziva-enterprise-dialog').remove();}
    const dialog=el(target?'div':'dialog');if(target){dialog.close=()=>{};dialog.showModal=()=>{};}dialog.id='biziva-enterprise-dialog';dialog.className='enterprise-dialog';dialog.setAttribute('aria-labelledby','enterprise-title');
    const header=el('header'),titles=el('div'),eyebrow=el('small','EMPRESAS E DESENVOLVEDORES'),title=el('h1','API empresarial');title.id='enterprise-title';titles.append(eyebrow,title,el('p','Conecte seus sistemas com acesso individual e consumo registrado.'));
    const close=el('button','Fechar');close.type='button';close.onclick=()=>dialog.close();header.append(titles);if(!target)header.append(close);
    const notice=el('p');notice.setAttribute('role','alert');
    const balance=el('section');balance.className='bz-recharge-card';balance.append(el('h2','Seu saldo disponível'));const amount=el('strong','Consultando saldo…');amount.className='bz-recharge-amount';amount.setAttribute('role','status');balance.append(amount);
    const pixRow=el('form');pixRow.className='bz-pix';/* 22/10 MIN50FIX: aba aberta antes da mudança ficava com min=100 (validação do navegador 'maior ou igual a 100'). Sem validação nativa; o mínimo é reconsultado no envio. Kill window.__BZ_MIN50FIX=0 */if(window.__BZ_MIN50FIX!==0)pixRow.noValidate=true;const pixVal=el('input');pixVal.type='number';pixVal.min='50';pixVal.max='5000';pixVal.step='1';pixVal.value='50';pixVal.required=true;pixVal.setAttribute('aria-label','Valor da recarga em reais');pixVal.inputMode='numeric';const pixGo=el('button','Recarregar com Pix');pixGo.type='submit';pixGo.className='bz-pix-go';const payM=el('select');payM.className='bz-pay-m';payM.setAttribute('aria-label','Forma de pagamento');[['pix','Pix'],['card','Cartão']].forEach(([v,t])=>{const o=el('option',t);o.value=v;payM.append(o);});const valLabel=el('label'),methodLabel=el('label');valLabel.append(el('span','Valor da recarga · R$'),pixVal);methodLabel.append(el('span','Forma de pagamento'),payM);pixRow.append(valLabel,methodLabel,pixGo);const rechargeTitle=el('h3','Adicionar saldo');rechargeTitle.className='bz-recharge-heading';const rechargeLead=el('p','Escolha o valor e a forma de pagamento. Seu saldo será atualizado após a confirmação.');rechargeLead.className='bz-recharge-lead';const presets=el('div');presets.className='bz-recharge-presets';presets.setAttribute('aria-label','Valores sugeridos de recarga');for(const v of [50,100,200,500]){const b=el('button','R$ '+v);b.type='button';b.setAttribute('aria-pressed',String(Number(pixVal.value)===v));b.onclick=()=>{pixVal.value=String(v);pixVal.dispatchEvent(new Event('input',{bubbles:true}));};presets.append(b)}pixVal.addEventListener('input',()=>presets.querySelectorAll('button').forEach((b,i)=>b.setAttribute('aria-pressed',String(Number(pixVal.value)===[50,100,200,500][i]))));balance.append(rechargeTitle,rechargeLead,presets);const cardRow=el('div');cardRow.className='bz-card-row';cardRow.hidden=true;const cardSel=el('select');cardSel.setAttribute('aria-label','Cartão salvo');const cardAdd=el('a','Adicionar cartão');cardAdd.href='/api-biziva/cartao';cardRow.append(cardSel,cardAdd);
    const pixOut=el('div');pixOut.className='bz-pix-out';pixOut.hidden=true;balance.append(pixRow,cardRow,el('small','Recarga mínima: R$50,00. Máxima: R$5.000,00.'),pixOut);const loadCards=async()=>{try{const s=await request('/api/enterprise/autotopup');cardSel.textContent='';(s.cards||[]).forEach(c=>{const o=el('option',c.brand+' final '+c.last4);o.value=c.id;if(c.isDefault)o.selected=true;cardSel.append(o);});const none=!cardSel.options.length;cardSel.hidden=none;cardAdd.textContent=none?'Adicionar cartão para recarregar':'Usar outro cartão';if(s.cardAvailable===false)notice.textContent='Cartão indisponível no momento. Use o Pix.';}catch{notice.textContent='Não conseguimos carregar seus cartões agora.';}};payM.onchange=()=>{const c=payM.value==='card';pixGo.textContent=c?'Recarregar com cartão':'Recarregar com Pix';cardRow.hidden=!c;if(c)void loadCards();};const cardPay=async reais=>{if(!cardSel.value){notice.textContent='Adicione um cartão para recarregar no cartão.';return;}pixGo.disabled=true;notice.textContent='Cobrando no cartão…';const rid=crypto.randomUUID();try{let t=await request('/api/enterprise/autotopup','POST',{action:'cardTopup',amountCents:reais*100,cardId:cardSel.value,requestId:rid});for(let i=0;i<20&&t.status==='pending'&&dialog.isConnected;i++){await new Promise(r=>setTimeout(r,3000));t=await request('/api/enterprise/autotopup','POST',{action:'cardTopupStatus',topupId:t.topupId});}notice.textContent=t.status==='credited'?'Recarga no cartão aprovada. Saldo creditado.':t.status==='pending'?'O pagamento está em análise na operadora. O saldo entra sozinho quando for aprovado.':(t.error||'O cartão não foi aprovado.');if(t.status==='credited')void load();}catch(e){notice.textContent=e.message||'Não foi possível cobrar o cartão agora.';}finally{pixGo.disabled=false;}};
    let pixTimer=0;const stopPix=()=>{clearTimeout(pixTimer);pixTimer=0;};
    const forget=id=>{try{const o=JSON.parse(localStorage.getItem('bzTopupOpen')||'null');if(o&&o.id===id)localStorage.removeItem('bzTopupOpen');}catch{}};
    const FINAL={cancelled:'O Mercado Pago confirmou que este Pix expirou ou foi cancelado. Nada foi cobrado. Pode gerar outro.',rejected:'O Mercado Pago recusou este pagamento. Nada foi creditado. Pode gerar outro.',refunded:'Este Pix foi estornado. O saldo não foi creditado.',charged_back:'Este Pix foi contestado no banco. Fale com o suporte no WhatsApp (33) 99829-1142.',failed:'Este Pix não foi gerado. Nada foi cobrado. Pode gerar outro.'};
    const watchTopup=(id,st,started)=>{let fails=0;const ref=' Código da recarga: '+id.slice(0,8)+'.';
      const poll=async()=>{if(!dialog.isConnected)return;let s=null;try{s=await request('/api/enterprise/topups/'+encodeURIComponent(id));fails=0;}catch{fails++;}
        if(s?.status==='credited'){st.textContent='Saldo creditado';st.dataset.ok='1';delete st.dataset.warn;stopPix();forget(id);void load();return;}
        if(s&&FINAL[s.status]){st.textContent=FINAL[s.status];st.dataset.warn='1';stopPix();forget(id);return;}
        const late=Date.now()-started>31*60e3;
        if(!s)st.textContent='Não conseguimos consultar o Mercado Pago agora. Se você já pagou, não gere outro Pix: o saldo entra assim que o pagamento for confirmado.'+ref;
        else if(late)st.textContent='O Mercado Pago ainda não confirmou este Pix. Se você já pagou, não gere outro: seguimos conferindo e o saldo entra sozinho.'+ref;
        else{st.textContent='Aguardando pagamento…';delete st.dataset.warn;}
        if(!s||late)st.dataset.warn='1';
        if(Date.now()-started>6*3600e3){st.textContent='Ainda sem confirmação do Mercado Pago. Se você pagou, fale com o suporte no WhatsApp (33) 99829-1142 e informe o código da recarga.'+ref;return;}
        pixTimer=setTimeout(poll,!s?Math.min(60e3,4000*2**Math.min(fails,4)):late?30e3:4000);};
      stopPix();pixTimer=setTimeout(poll,1500);};
    pixRow.onsubmit=async event=>{event.preventDefault();const reais=Math.round(Number(pixVal.value));if(window.__BZ_MIN50FIX!==0&&reais<Number(pixVal.min)){try{const d=await request('/api/enterprise');applyTopupPolicy(d.topupPolicy,pixVal,balance.querySelector('small'));}catch{}}const minR=Math.max(1,Number(pixVal.min)||50);if(!(reais>=minR&&reais<=5000)){notice.textContent='Escolha um valor entre R$'+minR.toFixed(2).replace('.',',')+' e R$5.000,00.';return;}if(payM.value==='card'){await cardPay(reais);return;}stopPix();pixGo.disabled=true;notice.textContent='';
      try{const t=await request('/api/enterprise/topups','POST',{amountCents:reais*100});if(!dialog.isConnected)return;
        const img=el('img');img.alt='QR Code do Pix';if(t.qrCodeBase64)img.src='data:image/png;base64,'+t.qrCodeBase64;const box=el('div'),code=el('textarea');code.readOnly=true;code.rows=4;code.value=t.pixCopiaECola||'';code.setAttribute('aria-label','Pix copia e cola');
        const copy=el('button','Copiar código');copy.type='button';copy.onclick=async()=>{try{await navigator.clipboard.writeText(code.value);copy.textContent='Copiado';}catch{code.select();}};
        const st=el('p','Aguardando pagamento…');st.className='bz-pix-st';st.setAttribute('role','status');
        box.append(el('strong',new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(reais)),code,copy,st);pixOut.replaceChildren(img,box);pixOut.hidden=false;
        try{localStorage.setItem('bzTopupOpen',JSON.stringify({id:t.topupId,cents:reais*100,at:Date.now()}));}catch{}watchTopup(t.topupId,st,Date.now());
      }catch(e){if(dialog.isConnected)notice.textContent=e.message;}finally{pixGo.disabled=false;}};
    const formSection=el('section'),form=el('form'),nameLabel=el('label','Nome da integração'),name=el('input');name.required=true;name.maxLength=80;name.placeholder='Ex.: CRM da empresa';nameLabel.append(name);
    const daysLabel=el('label','Validade'),days=el('select');for(const d of [30,90,365]){const o=el('option',d+' dias');o.value=String(d);days.append(o);}days.value='90';daysLabel.append(days);
    const submit=el('button','Criar chave');submit.type='submit';form.append(nameLabel,daysLabel,el('p','Permissões: usar os serviços de IA (cobra do saldo) e consultar consumo. A chave completa aparece uma única vez.'),submit);formSection.append(el('h2','Nova integração'),form);
    const secretSection=el('section');secretSection.hidden=true;const secret=el('textarea');secret.readOnly=true;secret.rows=3;secret.setAttribute('aria-label','Chave recém-criada');const hide=el('button','Já guardei — ocultar');hide.type='button';hide.onclick=()=>{secret.value='';secretSection.hidden=true;};secretSection.append(el('h2','Guarde sua chave'),el('p','Use apenas no servidor da empresa. Não coloque esta chave em sites públicos.'),secret,hide);
    const keysSection=el('section'),list=el('ul');keysSection.append(el('h2','Integrações'),list);const usageSection=el('section'),usage=el('p','Carregando consumo…');usageSection.append(el('h2','Consumo recente'),usage);
    const affSection=el('section');affSection.hidden=true;affSection.className='bz-aff';let onData=()=>{},onErr=()=>{},affFail=()=>{},affOk=()=>{};
    const loadAff=async()=>{affSection.replaceChildren();try{const r=await fetch('/api/enterprise/affiliate',{credentials:'same-origin',cache:'no-store'});if(!r.ok){affFail(r.status);return;}const a=await r.json();if(typeof a.link!=='string'){affFail(-1);return;}const brl=c=>new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format((Number(c)||0)/100);
      const row=el('div');row.className='bz-aff-row';const inp=el('input');inp.readOnly=true;inp.value=a.link;inp.setAttribute('aria-label','Link de indicação');inp.onclick=()=>inp.select();const cp=el('button','Copiar link');cp.type='button';cp.onclick=async()=>{try{await navigator.clipboard.writeText(a.link);}catch{inp.select();document.execCommand('copy');}cp.textContent='Copiado';setTimeout(()=>{cp.textContent='Copiar link'},2000);};row.append(inp,cp);
      const stats=el('p','Indicados: '+a.referred+' · Usando a API: '+a.apiActive+' · Comissão ganha: '+brl(a.totalCents)+' (liberada: '+brl(a.releasedCents)+' · a liberar: '+brl(a.pendingCents)+')');stats.setAttribute('role','status');
      affSection.append(el('h2','Link de indicação'),el('p','Indique a API para outras empresas e acompanhe as comissões geradas pelo consumo elegível no seu extrato. Os valores pendentes e liberados aparecem abaixo.'),row,stats,el('small','Vale para quem criar a conta pelo seu link. A comissão é liberada 30 dias depois do consumo e entra no mesmo saldo das suas indicações para saque por Pix.'));affSection.hidden=false;affOk(a);}catch{affFail(0)}};loadAff();
    const doc=el('details');doc.className='bz-doc';doc.append(el('summary','Como conectar'));const docBody=el('div');docBody.innerHTML=DOC_HTML;doc.append(docBody);
    if(target)bzEntLayout({el,dialog,header,titles,notice,balance,pixVal,affSection,formSection,secretSection,keysSection,usageSection,usage,doc,list,secret,name,target,hook:(d,e,f,o)=>{onData=d;onErr=e;affFail=f;affOk=o;},reload:()=>load(),reloadAff:()=>loadAff()});else dialog.append(header,notice,balance,affSection,formSection,secretSection,keysSection,usageSection,doc);(target||document.body).append(dialog);dialog.addEventListener('close',()=>{stopPix();secret.value='';dialog.remove();});dialog.showModal();
    try{const o=JSON.parse(localStorage.getItem('bzTopupOpen')||'null');if(o&&typeof o.id==='string'&&/^[0-9a-f-]{36}$/.test(o.id)&&Date.now()-o.at<24*3600e3){const st=el('p','Conferindo o Pix anterior…');st.className='bz-pix-st';st.setAttribute('role','status');const box=el('div');box.append(el('strong','Pix anterior · '+new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format((o.cents||0)/100)),st);pixOut.replaceChildren(box);pixOut.hidden=false;watchTopup(o.id,st,o.at);}}catch{}
    let busy=false;
    const setBusy=value=>{busy=value;submit.disabled=value;for(const b of list.querySelectorAll('button'))b.disabled=value||b.dataset.revoked==='true';};
    async function load(){notice.textContent='';try{const data=await request('/api/enterprise');applyTopupPolicy(data.topupPolicy,pixVal,balance.querySelector('small'));if(!Number.isSafeInteger(data.balanceCents)||data.balanceCents<0||!Array.isArray(data.keys)||!Array.isArray(data.reservations))throw Error('Resposta de consumo inválida.');if(!dialog.isConnected)return;amount.textContent=new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(data.balanceCents/100);list.replaceChildren();if(!data.keys.length)list.append(el('li','Nenhuma integração cadastrada.'));for(const key of data.keys){const item=el('li');item.className='enterprise-key';const info=el('div');info.append(el('strong',String(key.name)),el('p',String(key.prefix)+'… · '+(key.revoked?'Revogada':'Expira em '+new Date(key.expiresAt).toLocaleDateString('pt-BR'))));const revoke=el('button','Revogar chave');revoke.type='button';revoke.dataset.revoked=String(!!key.revoked);revoke.disabled=busy||!!key.revoked;revoke.onclick=async()=>{if(busy)return;setBusy(true);try{await request('/api/developer/keys','DELETE',{id:key.id});await load();}catch(e){notice.textContent=e.message;}finally{if(dialog.isConnected)setBusy(false);}};item.append(info,revoke);list.append(item);}usage.replaceChildren();if(!data.reservations.length)usage.textContent='Nenhum consumo registrado.';else for(const row of data.reservations.filter(r=>r.state==='consumed'||r.state==='refunded').slice(0,10)){const SV={'admin_adjust':'Ajuste de saldo','image':'Imagem','image-edit':'Edição de imagem','transcribe':'Transcrição de áudio','tts':'Voz','embed':'Embeddings','juris':'Pesquisa jurídica','chat-vision':'Chat com imagem','chat-easy':'Chat','chat-medium':'Chat','chat-hard':'Chat avançado','chat-strict':'Chat preciso','chat-strict-hard':'Chat preciso avançado','chat-direct':'Chat (modelo escolhido)','chat-pdf':'Chat com PDF'};const svn=String(row.service);const nm=SV[svn]||(svn.startsWith('chat-')?'Chat':svn);const fmt=c=>new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format((Number(c)||0)/100);const st=String(row.state);if(st!=='consumed'&&st!=='refunded')continue;const val=st==='consumed'?fmt(row.charged_cents):'estornado, sem cobrança';const hr=new Date(row.created_at).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});const line=el('div',hr+' · '+nm+' · '+val);usage.append(line);}onData(data);}catch(e){if(dialog.isConnected){notice.textContent=e.message;amount.textContent='Saldo indisponível';usage.textContent='Não foi possível consultar. Feche e abra a tela para tentar novamente.';onErr(e);}}}
    form.onsubmit=async event=>{event.preventDefault();if(busy||!name.value.trim())return;setBusy(true);notice.textContent='';try{const data=await request('/api/developer/keys','POST',{name:name.value.trim(),scopes:['catalog:read','usage:read','services:create'],expiresInDays:Number(days.value)});if(!data.key||!/^bzv_[a-f0-9]{64}$/.test(data.key.secret))throw Error('Não foi possível confirmar a chave. Consulte as integrações antes de criar outra.');if(!dialog.isConnected)return;secret.value=data.key.secret;secretSection.hidden=false;name.value='';await load();}catch(e){if(dialog.isConnected)notice.textContent=e.message;}finally{if(dialog.isConnected)setBusy(false);}};
    void load();
  }
  // Layout em abas da API empresarial (16/10, design Codex). So organiza os elementos reais; handlers e endpoints sao os mesmos.
  function bzEntLayout(o){
    const {el,dialog,header,titles,notice,balance,pixVal,affSection,formSection,secretSection,keysSection,usageSection,usage,doc,list,secret,name,target}=o;
    if(!document.getElementById('bz-ent-css')){const c=document.createElement('style');c.id='bz-ent-css';c.textContent=`#bz-inshell .bz-api:has(.bz-ent){max-width:1120px}
.bz-ent.enterprise-dialog{width:auto;max-height:none;padding:0;border:0;border-radius:0;background:none;box-shadow:none}
.bz-ent *{box-sizing:border-box}.bz-ent [hidden],.bz-ent-dlg [hidden]{display:none!important}.bz-ent>header{align-items:flex-end;flex-wrap:wrap}.bz-ent>header small{color:#ff6b80;letter-spacing:.12em;font-size:11px;font-weight:700}.bz-ent>header h1{margin:6px 0 4px}.bz-ent>header p{margin:0}
.bz-ent button,.bz-ent a.bz-ent-link{min-height:44px}.bz-ent .bz-ent-new{background:#dd1835;border-color:#dd1835;font-weight:600;white-space:nowrap}
.bz-ent-tabs{display:flex;gap:4px;margin:22px 0 20px;border-bottom:1px solid #ffffff18;overflow-x:auto;scrollbar-width:none}.bz-ent-tabs::-webkit-scrollbar{display:none}
.bz-ent .bz-ent-tabs button{background:none;border:0;border-bottom:2px solid transparent;border-radius:0;padding:10px 12px;color:#a9a3ad;white-space:nowrap;font-weight:600}
.bz-ent .bz-ent-tabs button[aria-selected=true]{color:#f6efdf;border-bottom-color:#dd1835}.bz-ent .bz-ent-tabs button:focus-visible{outline:2px solid #ff8799;outline-offset:-2px}
.bz-ent [role=tabpanel]:focus-visible{outline:none}.bz-ent [role=tabpanel]>section,.bz-ent .bz-ent-card{border:1px solid #ffffff14;border-radius:18px;padding:20px;background:linear-gradient(180deg,#ffffff07,#ffffff02);margin:0 0 14px}
.bz-ent [role=tabpanel]>section.bz-at{padding:20px}.bz-ent-grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:14px}.bz-ent-grid>*{margin:0}.bz-ent-side{display:grid;gap:14px}
.bz-ent-bal{border-left:3px solid #dd1835!important;display:flex;flex-direction:column;justify-content:space-between;min-height:200px}.bz-ent-bal small{color:#aaa4af}.bz-ent-bal b{display:block;font-size:44px;line-height:1.1;margin:10px 0;color:#f6efdf;font-weight:600;overflow-wrap:anywhere}
.bz-ent-row{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}.bz-ent-kpi{display:flex;gap:16px;align-items:center}.bz-ent-kpi b{font-size:26px;min-width:56px;color:#f6efdf}.bz-ent-kpi span{display:flex;flex-direction:column;color:#d9d2c6;font-size:14px}.bz-ent-kpi small{color:#9c96a2;font-size:12.5px}
.bz-ent h2{font-size:18px;margin:0 0 10px}.bz-ent ol{margin:6px 0 10px;padding-left:20px;color:#cfc8bc}.bz-ent ol li{margin:6px 0}.bz-ent ol{padding-left:22px!important;list-style:decimal outside!important}.bz-ent ol li{display:list-item!important;list-style:decimal outside!important}
.bz-ent .bz-ent-link{display:inline-flex;align-items:center;background:none;border:0;padding:0 2px;color:#ff8799;font-weight:600;text-decoration:none;cursor:pointer}
.bz-ent .bz-ent-recent{margin:0;color:#cfc8bc;font-size:14px;overflow-wrap:anywhere}.bz-ent-at{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;color:#cfc8bc;font-size:14px}
.bz-ent-empty{color:#9c96a2;font-size:14px}.bz-ent-err{color:#ffb9c2}.bz-ent [role=alert]:empty{display:none}.bz-ent>p[role=alert]{padding:12px 14px;border:1px solid #e3263655;border-radius:12px;background:#e326360d}
.bz-ent .enterprise-key{border-top:1px solid #ffffff12}.bz-ent .enterprise-key:first-child{border-top:0}.bz-ent .enterprise-key p{margin:4px 0 0;font:12.5px ui-monospace,Menlo,monospace;color:#aaa4af;overflow-wrap:anywhere}
.bz-ent .bz-doc summary{cursor:pointer;min-height:44px;display:flex;align-items:center;font-weight:600}
#bz-inshell #biziva-enterprise-dialog.bz-ent{display:block!important;width:auto!important;max-height:none!important;padding:0!important;background:none!important;border:0!important;border-radius:0!important;box-shadow:none!important}
#bz-inshell #biziva-enterprise-dialog.bz-ent>header{display:flex!important;flex-wrap:wrap;gap:16px;align-items:flex-end;justify-content:space-between;padding-bottom:0;border-bottom:0}.bz-ent>header>div{flex:1 1 320px;min-width:0}#bz-inshell #biziva-enterprise-dialog.bz-ent>header>button.bz-ent-new{position:static!important;min-height:44px!important;padding:11px 18px!important}
#bz-inshell #biziva-enterprise-dialog.bz-ent [role=tabpanel]>section{padding:20px!important}
.bz-ent-dlg{width:min(560px,94vw);max-height:90dvh;overflow:auto;padding:24px;border:1px solid #ffffff20;border-radius:22px;background:#101014;color:#f6efdf;box-shadow:0 30px 100px #000b;font:15px/1.5 system-ui}.bz-ent-dlg::backdrop{background:#000a;backdrop-filter:blur(6px)}
.bz-ent-dlg header{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:6px}.bz-ent-dlg h2{font-size:20px;margin:0}.bz-ent-dlg section{padding:8px 0 0}.bz-ent-dlg p{color:#bcb8bf}.bz-ent-dlg [role=alert]{color:#ffb9c2}.bz-ent-dlg [role=alert]:empty{display:none}
.bz-ent-dlg button{min-height:44px;padding:11px 16px;border-radius:12px;border:1px solid #ffffff24;background:#24242b;color:#f6efdf;font:inherit;cursor:pointer}.bz-ent-dlg button[type=submit]{background:#dd1835;border-color:#dd1835;font-weight:600}.bz-ent-dlg button:disabled{opacity:.5;cursor:default}
.bz-ent-dlg label{display:block}.bz-ent-dlg input,.bz-ent-dlg select,.bz-ent-dlg textarea{box-sizing:border-box;width:100%;background:#19191f;color:#f6efdf;border:1px solid #666874;border-radius:10px;padding:11px;font:inherit;font-size:16px;margin:7px 0 14px}.bz-ent-dlg textarea{overflow-wrap:anywhere;font-family:ui-monospace,Menlo,monospace;font-size:13px}.bz-ent-dlg :focus-visible{outline:2px solid #ff8799;outline-offset:3px}
.bz-ent-dlg:not([open]){display:none!important}.bz-ent-dlg[open]{display:block!important}
@media(max-width:600px){.bz-ent-dlg{padding:18px}}
@media(max-width:760px){.bz-ent-grid{grid-template-columns:1fr}.bz-ent-bal b{font-size:36px}.bz-ent>header .bz-ent-new{width:100%}.bz-ent [role=tabpanel]>section,.bz-ent .bz-ent-card{padding:16px}}`;document.head.append(c);}
    dialog.classList.add('bz-ent');
    const nova=el('button','+ Nova integração');nova.type='button';nova.className='bz-ent-new';header.append(nova);
    // dialogo Nova integracao (form e chave reais)
    const dlg=el('dialog');dlg.className='bz-ent-dlg';dlg.setAttribute('aria-labelledby','bz-ent-dlg-t');
    const dh=el('header'),dt=el('h2','Nova integração');dt.id='bz-ent-dlg-t';const dx=el('button','Fechar');dx.type='button';dx.onclick=()=>dlg.close();dh.append(dt,dx);
    const fh=formSection.querySelector('h2');if(fh)fh.remove();
    const dnote=el('p');dnote.setAttribute('role','alert');
    dlg.append(dh,dnote,formSection,secretSection);
    let opener=null;nova.onclick=()=>{opener=document.activeElement;notice.textContent='';dlg.showModal();setTimeout(()=>name.focus(),0);};
    // erros do formulario aparecem dentro do dialogo enquanto aberto
    new MutationObserver(()=>{if(dlg.open&&notice.textContent){dnote.textContent=notice.textContent;notice.textContent='';}}).observe(notice,{childList:true,characterData:true,subtree:true});
    dlg.addEventListener('close',()=>{dnote.textContent='';secret.value='';secretSection.hidden=true;formSection.hidden=false;(opener&&opener.isConnected?opener:nova).focus();});
    new MutationObserver(()=>{formSection.hidden=!secretSection.hidden;}).observe(secretSection,{attributes:true,attributeFilter:['hidden']});
    // abas
    const T=[['ov','Visão geral'],['saldo','Saldo e recargas'],['int','Integrações'],['uso','Consumo'],['ind','Indicações']];
    const tl=el('div');tl.className='bz-ent-tabs';tl.setAttribute('role','tablist');tl.setAttribute('aria-label','Seções da API empresarial');
    const tabs={},panels={};
    for(const [k,lbl] of T){const b=el('button',lbl);b.type='button';b.id='bz-ent-tab-'+k;b.setAttribute('role','tab');b.setAttribute('aria-controls','bz-ent-p-'+k);b.dataset.k=k;tl.append(b);tabs[k]=b;
      const p=el('div');p.id='bz-ent-p-'+k;p.setAttribute('role','tabpanel');p.setAttribute('aria-labelledby',b.id);p.tabIndex=0;p.hidden=true;panels[k]=p;}
    const show=(k,focus)=>{for(const [x] of T){const on=x===k;tabs[x].setAttribute('aria-selected',String(on));tabs[x].tabIndex=on?0:-1;panels[x].hidden=!on;}try{sessionStorage.setItem('bzEntTab',k);}catch{}if(focus)tabs[k].focus();};
    tl.onclick=e=>{const b=e.target.closest('[role=tab]');if(b)show(b.dataset.k);};
    tl.onkeydown=e=>{const ks=T.map(t=>t[0]),i=ks.indexOf(document.activeElement?.dataset?.k);if(i<0)return;let j=null;if(e.key==='ArrowRight')j=(i+1)%ks.length;else if(e.key==='ArrowLeft')j=(i-1+ks.length)%ks.length;else if(e.key==='Home')j=0;else if(e.key==='End')j=ks.length-1;if(j===null)return;e.preventDefault();show(ks[j],true);};
    // Visao geral
    const ovBal=el('section');ovBal.className='bz-ent-card bz-ent-bal';const ovAmt=el('b','Consultando…');ovAmt.setAttribute('aria-live','polite');const ovRetry=el('button','Tentar novamente');ovRetry.type='button';ovRetry.hidden=true;ovRetry.onclick=()=>{ovRetry.hidden=true;o.reload();};
    const ovPix=el('button','Adicionar saldo');ovPix.type='button';ovPix.className='bz-ent-new';ovPix.onclick=()=>{show('saldo');pixVal.focus();};
    const br=el('div');br.className='bz-ent-row';br.append(el('small','Crédito pré-pago para usar os serviços de IA.'),ovPix);
    const btop=el('div');btop.append(el('small','Saldo disponível na API'),ovAmt,ovRetry);ovBal.append(btop,br);
    const kInt=el('section');kInt.className='bz-ent-card bz-ent-kpi';const kN=el('b','–');const kL=el('span');kL.append(el('span','Integrações ativas'),el('small','Chaves individuais por sistema.'));kInt.append(kN,kL);
    const kUse=el('section');kUse.className='bz-ent-card';const kUseT=el('h2','Consumo recente');const kUseP=el('p','Carregando…');kUseP.className='bz-ent-recent';const kUseL=el('button','Ver consumo');kUseL.type='button';kUseL.className='bz-ent-link';kUseL.onclick=()=>show('uso',true);kUse.append(kUseT,kUseP,kUseL);
    const side=el('div');side.className='bz-ent-side';side.append(kInt,kUse);
    const g1=el('div');g1.className='bz-ent-grid';g1.append(ovBal,side);
    const ovKeys=el('section');ovKeys.className='bz-ent-card';const okh=el('div');okh.className='bz-ent-row';const okAll=el('button','Ver todas');okAll.type='button';okAll.className='bz-ent-link';okAll.onclick=()=>show('int',true);okh.append(el('h2','Suas integrações'),okAll);const okP=el('p','Carregando…');okP.className='bz-ent-recent';ovKeys.append(okh,okP,el('small','A chave completa é exibida só na criação.'));
    const ovDoc=el('section');ovDoc.className='bz-ent-card';ovDoc.innerHTML="<section class=\"bz-ai-guide\" aria-label=\"Guia de integração com sua IA\" style=\"padding:22px;border:1px solid #49434d;border-radius:16px;margin:16px 0;background:#17161c\"><h2 style=\"margin:0 0 10px;font-size:21px\">Integre seu sistema com ajuda da sua IA</h2><p style=\"line-height:1.6;margin:0 0 12px\">Não sabe programar? Baixe o guia e envie ao ChatGPT, Claude, Cursor ou à IA que ajuda você a desenvolver seu sistema. Ele reúne os recursos da API e as instruções para fazer a integração.</p><ol style=\"line-height:1.7;padding-left:22px\"><li>Baixe o PDF abaixo.</li><li>Anexe o arquivo à sua IA e cole o pedido pronto.</li><li>Diga qual é o seu sistema e o que deseja integrar.</li></ol><div style=\"display:flex;gap:10px;flex-wrap:wrap;align-items:center\"><a class=\"button bz-guide-download\" href=\"https://api.biziva.com.br/docs/biziva-api-integracao.pdf\" download=\"BIZIVA-API-integracao.pdf\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:10px 16px;border-radius:10px;background:#cc1432;color:#fff;text-decoration:none;font-weight:600\">Baixar guia para integrar com sua IA</a><button type=\"button\" data-biziva-guide-copy style=\"min-height:44px\">Copiar pedido para a IA</button></div><p role=\"status\" data-biziva-guide-status style=\"margin:10px 0 0\"></p><p style=\"font-size:13px;line-height:1.5;margin:10px 0 0;color:#bbb6c1\">Guia atualizado em 17/10/2026 · 19 páginas · PDF. A IA precisa ter acesso ao projeto ou orientar você nas alterações. Configure sua chave somente no servidor, nunca no chat da IA.</p></section>";
    ovDoc.style.marginTop='14px';ovKeys.style.marginTop='14px';
    const atSlot=el('div');atSlot.className='bz-ato-slot';
    panels.ov.append(g1,atSlot,ovDoc,ovKeys);
    // Saldo e recargas (Pix real + recarga automatica/cartoes/historico do api-autotopup-client)
    panels.saldo.append(balance);
    const balRetry=el('button','Tentar novamente');balRetry.type='button';balRetry.hidden=true;balRetry.onclick=()=>{balRetry.hidden=true;o.reload();};balance.querySelector('strong').after(balRetry);
    // Integracoes
    panels.int.append(keysSection,doc);
    // Consumo
    const useRetry=el('button','Tentar novamente');useRetry.type='button';useRetry.hidden=true;useRetry.onclick=()=>{useRetry.hidden=true;usage.textContent='Carregando consumo…';o.reload();};usageSection.append(useRetry);
    panels.uso.append(usageSection);
    // Indicacoes
    const affSt=el('section');affSt.className='bz-ent-card';const affP=el('p','Carregando indicações…');affP.setAttribute('role','status');const affR=el('button','Tentar novamente');affR.type='button';affR.hidden=true;affR.onclick=()=>{affR.hidden=true;affP.textContent='Carregando indicações…';o.reloadAff();};affSt.append(el('h2','Link de indicação'),affP,affR);
    panels.ind.append(affSt,affSection);
    o.hook(
      data=>{const fmt=c=>new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(c/100);ovAmt.textContent=fmt(data.balanceCents);ovRetry.hidden=balRetry.hidden=useRetry.hidden=true;
        const act=data.keys.filter(k=>!k.revoked&&!(k.expiresAt&&new Date(k.expiresAt)<new Date()));kN.textContent=String(act.length);
        okP.replaceChildren();if(!data.keys.length)okP.append(el('span','Nenhuma integração ainda. Use "Nova integração" para criar a primeira chave.'));else{const k=act[0]||data.keys[0];okP.append(el('strong',String(k.name)),el('br'),el('span',String(k.prefix)+'… · '+(k.revoked?'Revogada':'Expira em '+new Date(k.expiresAt).toLocaleDateString('pt-BR'))));}
        const first=usage.firstElementChild;kUseP.textContent=first?first.textContent:'Nenhum consumo registrado.';},
      e=>{if(e instanceof TypeError)notice.textContent='Sem conexão com a BIZIVA agora. Nada foi alterado. Use Tentar novamente.';ovAmt.textContent='Saldo indisponível';ovRetry.hidden=balRetry.hidden=useRetry.hidden=false;kN.textContent='–';okP.textContent='Não foi possível consultar as integrações.';kUseP.textContent='Não foi possível consultar o consumo.';usage.textContent='Não foi possível consultar o consumo agora.';},
      st=>{affSection.hidden=true;affSt.hidden=false;if(st===0||st>=500||st===-1){affP.textContent='Não foi possível carregar suas indicações agora.';affR.hidden=false;}else{affP.textContent='O link de indicação não está disponível para esta conta.';affR.hidden=true;}},
      a=>{affSt.hidden=true;if(!(Number(a.referred)>0)){const e=el('p','Você ainda não tem indicados. Compartilhe o link acima para começar.');e.className='bz-ent-empty';affSection.append(e);}});
    dialog.append(header,tl,notice);for(const [k] of T)dialog.append(panels[k]);dialog.append(dlg);
    let init='ov';try{init=sessionStorage.getItem('bzEntTab')||'ov';}catch{}if(/[?&](cartao|recarga)=/.test(location.search))init='saldo';if(!panels[init])init='ov';show(init);
  }

  function install(){const sidebar=document.getElementById('workspace-context-sidebar');if(!sidebar||sidebar.querySelector('[data-enterprise-entry]'))return;const button=el('button','API empresarial');button.type='button';button.dataset.enterpriseEntry='true';button.className='nav-item';button.onclick=()=>window.__bzInShellOpen?window.__bzInShellOpen('api'):open();const settings=Array.from(sidebar.querySelectorAll('button')).find(b=>b.textContent.trim()==='Configurações');if(settings)settings.before(button);else sidebar.append(button);}
  window.__bizivaEnterpriseOpen=t=>open(t);new MutationObserver(install).observe(document.body,{childList:true,subtree:true});install();
})();

(()=>{let queued=false;function sync(){queued=false;const h=document.querySelector('.bz-api h1,#enterprise-title');if(!h||document.getElementById('bz-current-api-docs'))return;const p=document.createElement('p');p.id='bz-current-api-docs';p.innerHTML='<a href="https://api.biziva.com.br/docs" target="_blank" rel="noopener">Documentação atual: texto, imagem, áudio, vídeo e agentes</a> · <a href="https://api.biziva.com.br/central">Central da empresa</a>';h.after(p)}new MutationObserver(()=>{if(!queued){queued=true;requestAnimationFrame(sync)}}).observe(document.documentElement,{childList:true,subtree:true});sync()})();
(()=>{if(window.__bzGuideCopy)return;window.__bzGuideCopy=true;document.addEventListener('click',async e=>{const b=e.target.closest('[data-biziva-guide-copy]');if(!b)return;const root=b.closest('.bz-ai-guide'),status=root.querySelector('[data-biziva-guide-status]');try{await navigator.clipboard.writeText("Anexei o guia atualizado da API Biziva. Leia o PDF e integre ao meu sistema os recursos que eu solicitar. Primeiro identifique o projeto e o backend; use a base https://api.biziva.com.br/v1 e teste GET /models. Configure BIZIVA_API_KEY somente no servidor: não peça que eu cole a chave neste chat e não a coloque no navegador, código público ou logs. Siga os contratos do PDF para idempotência, cobrança fracionária, tarefas assíncronas e erros. Preserve as integrações existentes. Use testes simulados; antes de um teste pago, informe operação e orçamento. Se faltar acesso ao projeto, explique o próximo passo. Meu sistema é: [descreva aqui]. Quero começar com: [descreva os recursos].");status.textContent='Pedido copiado. Anexe o PDF à sua IA e cole a mensagem.'}catch{let t=root.querySelector('textarea[data-biziva-guide-prompt]');if(!t){t=document.createElement('textarea');t.dataset.bizivaGuidePrompt='';t.setAttribute('aria-label','Pedido pronto para copiar e enviar à sua IA');t.readOnly=true;t.style.cssText='display:block;width:100%;min-height:180px;box-sizing:border-box;margin-top:12px;padding:12px';root.append(t)}t.value="Anexei o guia atualizado da API Biziva. Leia o PDF e integre ao meu sistema os recursos que eu solicitar. Primeiro identifique o projeto e o backend; use a base https://api.biziva.com.br/v1 e teste GET /models. Configure BIZIVA_API_KEY somente no servidor: não peça que eu cole a chave neste chat e não a coloque no navegador, código público ou logs. Siga os contratos do PDF para idempotência, cobrança fracionária, tarefas assíncronas e erros. Preserve as integrações existentes. Use testes simulados; antes de um teste pago, informe operação e orçamento. Se faltar acesso ao projeto, explique o próximo passo. Meu sistema é: [descreva aqui]. Quero começar com: [descreva os recursos].";t.focus();t.select();status.textContent='Selecione e copie o pedido abaixo. Anexe também o PDF.'}})})()
;(()=>{const s=document.createElement("style");s.id="bz-recharge-design";s.textContent=".enterprise-dialog .bz-recharge-card{background:linear-gradient(135deg,#251922,#17131a)!important;border:1px solid #573443!important;border-radius:20px!important;padding:26px!important}.bz-recharge-card>h2{color:#c6b7c4;font-size:14px!important;font-weight:500!important;margin-bottom:8px!important}.bz-recharge-card>.bz-recharge-amount{display:block;font-size:clamp(32px,5vw,44px);font-weight:600;letter-spacing:-1.5px;line-height:1.2;margin:0 0 24px;color:#f5efdf}.bz-recharge-heading{font-size:21px!important;letter-spacing:-.4px;margin:0 0 5px!important}.bz-recharge-lead{font-size:14px!important;margin:0 0 20px!important;max-width:540px;color:#bdb0be!important}.enterprise-dialog .bz-recharge-card .bz-pix{display:grid;grid-template-columns:minmax(150px,1fr) minmax(150px,1fr);gap:16px;margin-top:12px;align-items:end}.bz-recharge-card .bz-pix label{display:block;font-size:13px;font-weight:600;color:#d6cbd6}.bz-recharge-card .bz-pix label>span{display:block;margin-bottom:7px}.bz-recharge-card .bz-pix input,.bz-recharge-card .bz-pix select{width:100%!important;margin:0!important;height:48px;border:1px solid #705565!important;background:#100e13!important;font-size:16px!important}.bz-recharge-card .bz-pix .bz-pix-go{grid-column:1/-1;min-height:50px;width:100%;background:#e1193c!important;border:1px solid #f13a59!important;font-weight:650!important;box-shadow:0 6px 20px #e1193c18}.bz-recharge-card .bz-pix .bz-pix-go:hover{background:#f02749!important}.bz-recharge-presets{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.enterprise-dialog .bz-recharge-presets button{min-height:42px;flex:1;padding:8px 12px;background:#211a23;border:1px solid #513b4b;white-space:nowrap}.enterprise-dialog .bz-recharge-presets button[aria-pressed=true]{border-color:#ed3554;background:#4a1c2b;color:#fff}.bz-recharge-card>small{display:block;margin-top:12px;font-size:12px!important;color:#b8aab9!important}.bz-recharge-card .bz-card-row{margin-top:16px;padding:16px;border-radius:12px;background:#19141d;border:1px solid #4b3544}.bz-recharge-card .bz-pix-out{margin-top:22px;border-color:#655160;background:#19141d}.bz-recharge-card .bz-pix-out>div{min-width:0;width:100%}.bz-recharge-card .bz-pix-out textarea{width:100%;word-break:break-all;font-size:12px!important}.bz-recharge-card .bz-pix-out button{min-height:44px;background:#352331;border-color:#825368}.enterprise-dialog .bz-ent-new{min-height:46px!important;padding:12px 20px!important;border-radius:12px!important}.bz-recharge-card [hidden]{display:none!important}.bz-recharge-card :focus-visible{outline:3px solid #f2a4b6!important;outline-offset:3px}@media(max-width:600px){.enterprise-dialog .bz-recharge-card{padding:20px!important}.enterprise-dialog .bz-recharge-card .bz-pix{grid-template-columns:1fr}.bz-recharge-card .bz-pix-out{grid-template-columns:1fr;padding:15px}.bz-recharge-presets{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.bz-recharge-card>.bz-recharge-amount{font-size:36px}.bz-recharge-card .bz-pix-out img{width:180px;height:180px;justify-self:center}}\n";document.head.append(s)})();

;(() => {
  if (window.__bzAutoTopup) return; window.__bzAutoTopup = true;
  const css = document.createElement('style');
  css.textContent = '.bz-at{border:1px solid #ffffff14;border-radius:18px;padding:20px;background:linear-gradient(180deg,#ffffff06,#ffffff02)}'
   + '.bz-at *{box-sizing:border-box}.bz-at-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.bz-at-head h2{margin:0 0 4px}.bz-at-head p{margin:0;color:rgba(245,236,220,.7);font-size:13.5px;line-height:1.5;max-width:520px}'
   + '.bz-at .bz-sw{all:unset;box-sizing:border-box;position:relative;flex:none;width:52px!important;min-width:52px;height:30px!important;border-radius:999px!important;border:1px solid #ffffff22!important;background:#ffffff14!important;cursor:pointer;padding:0!important;margin:0!important;box-shadow:none!important;transition:background .2s}.bz-at .bz-sw:focus-visible{outline:2px solid #e32636;outline-offset:2px}.bz-sw::after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#f5ecdc;transition:transform .2s}.bz-at .bz-sw[aria-checked=true]{background:#e32636!important;border-color:#e32636!important}.bz-sw[aria-checked=true]::after{transform:translateX(22px)}.bz-sw:disabled{opacity:.5}'
   + '.bz-at-st{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;color:#a1a1aa;margin-top:10px}.bz-at-st i{width:8px;height:8px;border-radius:50%;background:#52525b}.bz-at-st[data-on] i{background:#4ade80;box-shadow:0 0 0 3px #4ade8022}.bz-at-st[data-on]{color:#bbf7d0}'
   + '.bz-at-sub{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#a1a1aa;margin:22px 0 10px;font-weight:600}'
   + '.bz-at-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;align-items:end}.bz-at-grid label{display:flex;flex-direction:column;gap:6px;font-size:12.5px;color:#c9c2b6;margin:0}.bz-at-grid input,.bz-at-grid select{width:100%;margin:0!important}'
   + '.bz-at-money{position:relative}.bz-at-money span{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#8b8b93;font-size:14px;pointer-events:none}.bz-at-money input{padding-left:38px!important}'
   + '.bz-at-cards{display:flex;flex-direction:column;gap:8px}.bz-at .bz-at-c{margin:0!important;display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid #ffffff14;border-radius:14px;background:#0f0f11;cursor:pointer}.bz-at .bz-at-c[data-def]{border-color:#e32636;background:#e3263610}'
   + '.bz-at-c input[type=radio]{width:18px;height:18px;margin:0;accent-color:#e32636;flex:none}.bz-at-brand{flex:none;min-width:46px;height:30px;border-radius:7px;background:#ffffff12;display:grid;place-items:center;font-size:10.5px;font-weight:800;letter-spacing:.04em;color:#f5ecdc;text-transform:uppercase;padding:0 6px}'
   + '.bz-at-ci{flex:1;min-width:0;display:flex;flex-direction:column}.bz-at-ci b{font-size:14.5px;color:#f5ecdc;font-weight:600;display:flex;align-items:center;gap:8px;white-space:nowrap}.bz-at-ci small{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.bz-at-ci small{color:#8b8b93;font-size:12px}.bz-at-pill{font-size:11px;color:#ff8a95;border:1px solid #e3263655;border-radius:999px;padding:2px 8px;white-space:nowrap}'
   + '.bz-at-rm{background:none!important;border:0!important;color:#a1a1aa!important;font-size:13px;cursor:pointer;padding:6px!important;box-shadow:none!important;width:auto!important}.bz-at-rm:hover{color:#ff6b80!important}'
   + '.bz-at-add{display:flex;align-items:center;justify-content:center;gap:8px;padding:13px;border:1px dashed #ffffff2a;border-radius:14px;color:#f5ecdc;text-decoration:none;font-size:14px;font-weight:600}.bz-at-add:hover{border-color:#e32636;color:#fff}'
   + '.bz-at-empty{color:#8b8b93;font-size:13.5px;margin:0 0 8px}.bz-at-foot{display:flex;align-items:center;gap:12px;margin-top:16px;flex-wrap:wrap}.bz-at-foot button{min-width:180px}'
   + '.bz-at-msg{font-size:13.5px;color:#f2c46d;margin:0}.bz-at-msg[data-ok]{color:#7fe0a8}.bz-at-hist{list-style:none;padding:0;margin:0}.bz-at-hist li{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-top:1px solid #ffffff10;font-size:13.5px}.bz-at-hist li:first-child{border-top:0}.bz-at-hist em{font-style:normal;font-size:12px;padding:2px 9px;border-radius:999px;background:#ffffff10;color:#c9c2b6}.bz-at-hist em[data-s=credited]{background:#1f7a4a33;color:#7fe0a8}.bz-at-hist em[data-s=failed]{background:#e3263622;color:#ff8a95}'
   + '.bz-at-note{color:#8b8b93;display:block;margin-top:14px;font-size:12px;line-height:1.5}'
   + '.bz-at-err{margin-top:14px;padding:14px;border:1px solid #e3263655;border-radius:14px;background:#e326360d}.bz-at-err p{margin:0 0 10px;color:#ffb9c2;font-size:13.5px}.bz-at-err button{min-height:44px}'
   + '.bz-ato{position:relative;overflow:hidden;margin-top:14px;border:1px solid #e3263640;border-radius:20px;padding:20px 22px;background:radial-gradient(120% 140% at 100% 0%,#e3263622 0%,transparent 55%),linear-gradient(180deg,#17110f,#0e0c0b);box-shadow:0 18px 40px -24px #e3263688,inset 0 1px 0 #ffffff0d}'
   + '.bz-ato *{box-sizing:border-box}.bz-ato-h{display:flex;align-items:center;justify-content:space-between;gap:14px}.bz-ato-t{display:flex;align-items:center;gap:12px;min-width:0}.bz-ato-ic{flex:none;width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,#e32636,#8f1520);color:#fff;font-size:19px;box-shadow:0 6px 18px -6px #e32636aa}'
   + '.bz-ato h2{margin:0;font-size:16.5px;color:#f5ecdc}.bz-ato-k{display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#ff8a95;font-weight:700;margin-bottom:2px}'
   + '.bz-ato .bz-sw{all:unset;box-sizing:border-box;position:relative;flex:none;width:52px!important;min-width:52px;height:30px!important;border-radius:999px!important;border:1px solid #ffffff22!important;background:#ffffff14!important;cursor:pointer;transition:background .2s}.bz-ato .bz-sw:focus-visible{outline:2px solid #e32636;outline-offset:2px}.bz-ato .bz-sw[aria-checked=true]{background:#e32636!important;border-color:#e32636!important}.bz-ato .bz-sw:disabled{opacity:.45;cursor:not-allowed}'
   + '.bz-ato-g{display:grid;grid-template-columns:1fr 1fr 1.2fr;gap:12px;margin-top:16px;align-items:end}.bz-ato-g label{display:flex;flex-direction:column;gap:6px;font-size:12.5px;color:#c9c2b6;margin:0}.bz-ato-g input{width:100%;margin:0!important;min-height:44px}'
   + '.bz-ato-cd{display:flex;flex-direction:column;gap:6px;font-size:12.5px;color:#c9c2b6}.bz-ato-cd div{display:flex;align-items:center;gap:10px;min-height:44px;padding:0 12px;border:1px solid #ffffff14;border-radius:12px;background:#0b0a0a;color:#f5ecdc;font-size:14px}.bz-ato-cd em{font-style:normal;font-size:10.5px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;padding:3px 7px;border-radius:6px;background:#ffffff12}'
   + '.bz-ato-f{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:14px}.bz-ato-f .bz-ato-mg{background:none!important;border:1px solid #ffffff22!important;color:#f5ecdc!important;box-shadow:none!important}.bz-ato-f p{margin:0;font-size:13px;color:#f2c46d}.bz-ato-f p[data-ok]{color:#7fe0a8}'
   + '@media(max-width:760px){.bz-ato{padding:16px}.bz-ato-g{grid-template-columns:1fr 1fr}.bz-ato-cd{grid-column:1/-1}}@media(max-width:420px){.bz-ato-g{grid-template-columns:1fr}.bz-ato-f button{flex:1}}'
   + '@media(max-width:600px){.bz-at{padding:16px}.bz-at-grid{grid-template-columns:1fr}.bz-at-brand{display:none}.bz-at-foot button{flex:1}}';
  document.head.append(css);
  const el = (t, x, c) => { const e = document.createElement(t); if (x != null) e.textContent = x; if (c) e.className = c; return e; };
  const money = c => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format((Number(c) || 0) / 100);
  async function api(method, body) { const r = await fetch('/api/enterprise/autotopup', { method, credentials: 'same-origin', cache: 'no-store', headers: body ? { 'content-type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined }); let d = null; try { d = await r.json(); } catch {} if (!r.ok) throw Error(d?.error || 'Não foi possível concluir agora.'); return d; }
  const stateLabel = s => !s ? 'Indisponível' : s.processing ? 'Pagamento em andamento' : s.enabled ? 'Ativada' : 'Desativada';
  function summaryText(s) {
    if (!s) return 'Não foi possível consultar a configuração. Tente novamente.';
    const card = (s.cards || []).find(c => c.isDefault) || s.card;
    const reason = s.lastError ? String(s.lastError).slice(0, 240) : s.disabledReason === 'card_failed' ? 'Cartão padrão recusado.' : null;
    return 'Configurado: ' + money(s.amountCents) + ' quando o saldo ficar abaixo de ' + money(s.thresholdCents) + '. Cartão padrão: ' + (card ? (card.brand || 'Cartão') + ' final ' + card.last4 : 'Nenhum cartão padrão definido') + '. ' + (reason ? 'Última falha registrada: ' + reason : 'Nenhuma falha registrada.');
  }
  function updateSummary(dialog, s) {
    dialog.querySelectorAll('[data-bz-auto-summary]').forEach(n => { n.textContent = summaryText(s); });
    dialog.querySelectorAll('[data-bz-auto-open]').forEach(n => { n.textContent = 'Recarga automática · ' + stateLabel(s); });
  }
  function mountAccess(dialog) {
    const balance = dialog.querySelector('.bz-ent-bal > div');
    const prepaid = dialog.querySelector('.bz-pix')?.closest('section');
    for (const target of [balance, prepaid]) {
      if (!target || target.querySelector('[data-bz-auto-open]')) continue;
      const button = el('button', 'Recarga automática · Consultando…'); button.type = 'button'; button.dataset.bzAutoOpen = '1';
      button.style.cssText = 'min-height:44px;margin:10px 0;max-width:100%;white-space:normal';
      button.onclick = () => {
        dialog.querySelector('.bz-ent-tabs [data-k=saldo]')?.click();
        const section = dialog.querySelector('.bz-at');
        if (section) { section.tabIndex = -1; section.scrollIntoView({ block: 'start', behavior: 'smooth' }); section.focus({ preventScroll: true }); }
      };
      const summary = el('p'); summary.dataset.bzAutoSummary = '1'; summary.setAttribute('aria-live', 'polite'); summary.style.cssText = 'font-size:13px;line-height:1.6;overflow-wrap:anywhere;margin:8px 0';
      summary.textContent = 'Consultando configuração da recarga…';
      if (target === prepaid) target.querySelector('strong')?.after(button, summary); else target.append(button, summary);
    }
  }
  const ST = { credited: 'Creditada', pending: 'Processando', failed: 'Recusada' };
  const moneyField = (label, min, max) => { const l = el('label', label), w = el('div', null, 'bz-at-money'), i = el('input'); Object.assign(i, { type: 'number', min, max, step: '1', inputMode: 'numeric' }); w.append(el('span', 'R$'), i); l.append(w); return [l, i]; };
  function build(dialog) {
    const anchor = dialog.querySelector('.bz-pix')?.closest('section'); if (!anchor || dialog.querySelector('.bz-at')) return;
    const sec = el('section', null, 'bz-at'); sec.setAttribute('aria-labelledby', 'bz-at-title');
    const head = el('div', null, 'bz-at-head'), left = el('div'), h = el('h2', 'Recarga automática'); h.id = 'bz-at-title';
    const status = el('span', null, 'bz-at-st'); status.append(el('i'), el('span', 'Desativada'));
    left.append(h, el('p', 'Quando o saldo ficar baixo, cobramos o valor escolhido no cartão padrão e o saldo cai na hora. Opcional, com aviso por e-mail a cada recarga.'), status);
    const sw = el('button', null, 'bz-sw'); sw.type = 'button'; sw.setAttribute('role', 'switch'); sw.setAttribute('aria-checked', 'false'); sw.setAttribute('aria-labelledby', 'bz-at-title');
    head.append(left, sw);
    const grid = el('div', null, 'bz-at-grid');
    const [lA, amount] = moneyField('Valor da recarga', '100', '5000');
    const [lT, thr] = moneyField('Quando o saldo ficar abaixo de', '1', '1000');
    grid.append(lA, lT);
    const cardsT = el('div', 'Cartões salvos', 'bz-at-sub'), cards = el('div', null, 'bz-at-cards');
    const add = el('a', '+ Adicionar cartão', 'bz-at-add'); add.href = '/api-biziva/cartao';
    const foot = el('div', null, 'bz-at-foot'), save = el('button', 'Salvar valores'); save.type = 'button'; const msg = el('p', '', 'bz-at-msg'); msg.setAttribute('role', 'status'); foot.append(save, msg);
    const histT = el('div', 'Histórico', 'bz-at-sub'), hist = el('ul', null, 'bz-at-hist');
    const note = el('small', 'Só cartão de crédito (Pix não é automático). O cartão fica guardado na Pagar.me; a BIZIVA não guarda o número. Se o cartão padrão for recusado, a recarga automática é desativada e avisamos por e-mail.', 'bz-at-note');
    sec.append(head, el('div', 'Valores', 'bz-at-sub'), grid, foot, cardsT, cards, histT, hist, note);
    anchor.after(sec);
    let st = null; const say = (t, ok) => { msg.textContent = t || ''; if (ok) msg.dataset.ok = '1'; else delete msg.dataset.ok; };
    function render() {
      updateSummary(dialog, st);
      sw.setAttribute('aria-checked', String(!!st.enabled)); sw.disabled = !st.cardAvailable;
      status.lastChild.textContent = st.enabled ? (st.processing ? 'Ativada · recarregando agora' : 'Ativada · ' + money(st.amountCents) + ' quando o saldo ficar abaixo de ' + money(st.thresholdCents)) : 'Desativada';
      if (st.enabled) status.dataset.on = '1'; else delete status.dataset.on;
      amount.min = String(st.minCents / 100);
      cards.replaceChildren();
      if (!st.cards.length) cards.append(el('p', 'Nenhum cartão salvo. Adicione um para ativar a recarga automática.', 'bz-at-empty'));
      for (const c of st.cards) {
        const row = el('label', null, 'bz-at-c'); if (c.isDefault) row.dataset.def = '1';
        const r = el('input'); r.type = 'radio'; r.name = 'bz-at-def'; r.checked = c.isDefault; r.setAttribute('aria-label', 'Usar o cartão final ' + c.last4 + ' na recarga');
        r.onchange = async () => { try { st = await api('POST', { action: 'default', cardId: c.id }); render(); say('Cartão final ' + c.last4 + ' agora é o padrão da recarga.', true); } catch (e) { say(e.message); render(); } };
        const info = el('span', null, 'bz-at-ci'); const nm = el('b', '•••• ' + c.last4); if (c.isDefault) nm.append(el('span', 'Padrão', 'bz-at-pill')); info.append(nm, el('small', (c.brand || 'Cartão') + (c.exp ? ' · vence ' + c.exp : '')));
        const rm = el('button', 'Remover', 'bz-at-rm'); rm.type = 'button';
        rm.onclick = async ev => { ev.preventDefault(); if (!confirm('Remover o cartão ' + (c.brand || '') + ' final ' + c.last4 + '?' + (c.isDefault ? ' Ele é o cartão padrão da recarga automática.' : ''))) return; rm.disabled = true; try { st = await api('POST', { action: 'remove', cardId: c.id }); render(); say('Cartão removido.', true); } catch (e) { say(e.message); rm.disabled = false; } };
        row.append(r, el('span', c.brand || 'Cartão', 'bz-at-brand'), info); row.append(rm); cards.append(row);
      }
      if (st.cards.length < 5) cards.append(add);
      hist.replaceChildren(); histT.hidden = hist.hidden = !st.history?.length;
      for (const r of st.history || []) { const li = el('li'), s = el('em', ST[r.status] || r.status); s.dataset.s = r.status; li.append(el('span', new Date(r.createdAt).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) + ' · ' + money(r.amountCents)), s); hist.append(li); }
      if (!st.enabled && st.disabledReason === 'card_failed') say('Desativada porque o cartão padrão foi recusado' + (st.lastError ? ': ' + st.lastError : '.') + ' Escolha ou adicione outro cartão e ative de novo.');
    }
    window.addEventListener('bz-at-change', e => { if (e.detail?.from === 'ov' && sec.isConnected) fill(e.detail.d); });
    const share = d => window.dispatchEvent(new CustomEvent('bz-at-change', { detail: { d, from: 'full' } }));
    function fill(d, keep) { if (!sec.isConnected) return; st = d; if (d && keep !== 'noshare') share(d); if (!keep) { amount.value = String(Math.round(d.amountCents / 100)); thr.value = String(Math.round(d.thresholdCents / 100)); } render(); }
    const vals = () => ({ amountCents: Math.round(Number(amount.value)) * 100, thresholdCents: Math.round(Number(thr.value)) * 100 });
    const after = d => d.ran === 'credited' ? 'Ativada. O saldo estava abaixo do gatilho e já recarregamos ' + money(d.amountCents) + '.' : d.ran === 'failed' ? 'O banco recusou a recarga. Confira o e-mail.' : '';
    sw.onclick = async () => { const on = sw.getAttribute('aria-checked') !== 'true'; sw.disabled = true; say(on ? 'Ativando…' : ''); try { const d = await api('POST', on ? { action: 'on', ...vals() } : { action: 'off' }); fill(d, true); say(after(d) || (on ? 'Recarga automática ativada.' : 'Recarga automática desativada. Seus cartões continuam salvos.'), d.ran !== 'failed'); } catch (e) { say(e.message); } finally { sw.disabled = !st?.cardAvailable; } };
    save.onclick = async () => { save.disabled = true; try { const d = await api('POST', { action: 'save', ...vals() }); fill(d); say(after(d) || 'Valores salvos.', d.ran !== 'failed'); } catch (e) { say(e.message); } finally { save.disabled = false; } };
    const parts = Array.from(sec.children).filter(x => x !== head);
    const err = el('div', null, 'bz-at-err'); err.setAttribute('role', 'alert'); err.hidden = true; const errP = el('p', ''), retry = el('button', 'Tentar novamente'); retry.type = 'button'; err.append(errP, retry); head.after(err);
    const first = () => { err.hidden = true; for (const x of parts) x.hidden = true; sw.disabled = true; status.lastChild.textContent = 'Consultando…'; delete status.dataset.on;
      api('GET').then(d => { for (const x of parts) x.hidden = false; fill(d); if (/[?&]cartao=ok/.test(location.search)) { say('Cartão salvo. Nada foi cobrado.', true); sec.scrollIntoView({ block: 'start' }); } })
        .catch(e => { if (!sec.isConnected) return; updateSummary(dialog, null); st = null; sw.disabled = true; sw.setAttribute('aria-checked', 'false'); status.lastChild.textContent = 'Indisponível no momento'; errP.textContent = 'Não foi possível carregar a recarga automática agora (' + (e instanceof TypeError || !e?.message ? 'falha de conexão' : e.message) + '). Nada foi alterado na sua configuração ou nos seus cartões.'; err.hidden = false; }); };
    retry.onclick = () => { retry.disabled = true; first(); setTimeout(() => { retry.disabled = false; }, 800); }; first();
  }

  function buildOv(dialog) {
    const slot = dialog.querySelector('.bz-ato-slot'); if (!slot || slot.dataset.done) return; slot.dataset.done = '1';
    const sec = el('section', null, 'bz-ato'); sec.setAttribute('aria-labelledby', 'bz-ato-title');
    const h = el('div', null, 'bz-ato-h'), t = el('div', null, 'bz-ato-t'), ic = el('span', '⚡', 'bz-ato-ic'); ic.setAttribute('aria-hidden', 'true');
    const tt = el('div'), h2 = el('h2', 'Recarga automática'); h2.id = 'bz-ato-title';
    const status = el('span', null, 'bz-at-st'); status.append(el('i'), el('span', 'Consultando…'));
    tt.append(el('span', 'Saldo sempre ativo', 'bz-ato-k'), h2, status); t.append(ic, tt);
    const sw = el('button', null, 'bz-sw'); sw.type = 'button'; sw.setAttribute('role', 'switch'); sw.setAttribute('aria-checked', 'false'); sw.setAttribute('aria-labelledby', 'bz-ato-title'); sw.disabled = true;
    h.append(t, sw);
    const g = el('div', null, 'bz-ato-g');
    const [lA, amount] = moneyField('Valor da recarga', '100', '5000');
    const [lT, thr] = moneyField('Quando o saldo ficar abaixo de', '1', '1000');
    const cd = el('div', null, 'bz-ato-cd'), cdv = el('div'); cd.append(el('span', 'Cartão padrão'), cdv);
    g.append(lA, lT, cd);
    const f = el('div', null, 'bz-ato-f'), save = el('button', 'Salvar'); save.type = 'button';
    const mg = el('button', 'Gerenciar cartões', 'bz-ato-mg'); mg.type = 'button';
    mg.onclick = () => { const tab = dialog.querySelector('.bz-ent-tabs [data-k=saldo]'); if (tab) tab.click(); setTimeout(() => { const s = dialog.querySelector('.bz-at-cards'); if (s) s.scrollIntoView({ block: 'center', behavior: 'smooth' }); }, 60); };
    const msg = el('p', ''); msg.setAttribute('role', 'status'); f.append(save, mg, msg);
    const err = el('div', null, 'bz-at-err'); err.setAttribute('role', 'alert'); err.hidden = true; const errP = el('p', ''), retry = el('button', 'Tentar novamente'); retry.type = 'button'; err.append(errP, retry);
    sec.append(h, err, g, f); slot.replaceWith(sec);
    let st = null; const say = (x, ok) => { msg.textContent = x || ''; if (ok) msg.dataset.ok = '1'; else delete msg.dataset.ok; };
    const render = (keep) => {
      updateSummary(dialog, st);
      sw.setAttribute('aria-checked', String(!!st.enabled)); sw.disabled = !st.cardAvailable;
      status.lastChild.textContent = st.enabled ? (st.processing ? 'Ativada · recarregando agora' : 'Ativada') : 'Desativada'; if (st.enabled) status.dataset.on = '1'; else delete status.dataset.on;
      if (!keep) { amount.value = String(Math.round(st.amountCents / 100)); thr.value = String(Math.round(st.thresholdCents / 100)); }
      amount.min = String(st.minCents / 100);
      const c = (st.cards || []).find(x => x.isDefault) || st.card;
      cdv.replaceChildren(); if (c) { cdv.append(el('em', c.brand || 'Cartão'), el('span', '•••• ' + c.last4)); } else cdv.append(el('span', 'Nenhum cartão salvo'));
      if (!st.cardAvailable && !msg.textContent) say('Adicione um cartão em Gerenciar cartões para ativar.');
    };
    const vals = () => ({ amountCents: Math.round(Number(amount.value)) * 100, thresholdCents: Math.round(Number(thr.value)) * 100 });
    const share = d => { if (!sec.isConnected) return; window.dispatchEvent(new CustomEvent('bz-at-change', { detail: { d, from: 'ov' } })); };
    window.addEventListener('bz-at-change', e => { if (e.detail?.from !== 'ov' && sec.isConnected) { st = e.detail.d; err.hidden = true; g.hidden = f.hidden = false; render(); } });
    sw.onclick = async () => { const on = sw.getAttribute('aria-checked') !== 'true'; sw.disabled = true; say(on ? 'Ativando…' : ''); try { const d = await api('POST', on ? { action: 'on', ...vals() } : { action: 'off' }); st = d; render(true); share(d); say(d.ran === 'failed' ? 'O banco recusou a recarga. Confira o e-mail.' : on ? 'Recarga automática ativada.' : 'Recarga automática desativada.', d.ran !== 'failed'); } catch (x) { say(x.message); } finally { sw.disabled = !st?.cardAvailable; } };
    save.onclick = async () => { save.disabled = true; try { const d = await api('POST', { action: 'save', ...vals() }); st = d; render(); share(d); say('Valores salvos.', true); } catch (x) { say(x.message); } finally { save.disabled = false; } };
    const first = () => { err.hidden = true; g.hidden = f.hidden = true; sw.disabled = true; status.lastChild.textContent = 'Consultando…'; delete status.dataset.on;
      api('GET').then(d => { if (!sec.isConnected) return; st = d; g.hidden = f.hidden = false; render(); })
        .catch(x => { if (!sec.isConnected) return; updateSummary(dialog, null); status.lastChild.textContent = 'Indisponível no momento'; errP.textContent = 'Não foi possível carregar a recarga automática agora (' + (x instanceof TypeError || !x?.message ? 'falha de conexão' : x.message) + '). Nada foi alterado.'; err.hidden = false; }); };
    retry.onclick = () => { retry.disabled = true; first(); setTimeout(() => { retry.disabled = false; }, 800); }; first();
  }
  const scan = () => { const d = document.getElementById('biziva-enterprise-dialog'); if (d) { mountAccess(d); build(d); buildOv(d); } };
  new MutationObserver(scan).observe(document.body, { childList: true, subtree: true }); scan();
})();