(()=>{if(window.__bzVoz||!location.pathname.startsWith('/app'))return;window.__bzVoz=1;
const css=document.createElement('style');css.textContent='#bzvoz-b{position:fixed;right:16px;bottom:88px;z-index:9998;border:0;border-radius:24px;padding:10px 14px;background:#e32636;color:#fff;font:600 14px system-ui;box-shadow:0 4px 14px #0003;cursor:pointer}#bzvoz-p{position:fixed;right:16px;bottom:140px;z-index:9999;width:min(360px,92vw);max-height:70vh;overflow:auto;background:#fff;color:#111;border-radius:14px;box-shadow:0 8px 30px #0004;padding:14px;font:14px system-ui;display:none}#bzvoz-p button{border:0;border-radius:8px;padding:8px 10px;margin:4px 4px 0 0;background:#f1f1f1;cursor:pointer;font:600 13px system-ui}#bzvoz-p button.r{background:#e32636;color:#fff}#bzvoz-p select,#bzvoz-p input[type=text]{width:100%;margin:6px 0;padding:7px;border:1px solid #ccc;border-radius:8px}#bzvoz-p .c{border-top:1px solid #eee;padding:6px 0;font-size:13px}#bzvoz-p small{color:#666}';document.head.appendChild(css);
const b=document.createElement('button');b.id='bzvoz-b';b.textContent='🎙️ Áudio';const p=document.createElement('div');p.id='bzvoz-p';document.body.append(b,p);
let blob=null,rec=null,data=null;const $=s=>p.querySelector(s);
const msg=t=>{$('#vz-m').textContent=t};
async function load(){const r=await fetch('/api/voice-clips',{credentials:'include'});data=await r.json();render()}
function render(){const I=data?.intents||{},F=data?.funnels||[],C=data?.clips||[];
p.innerHTML='<b>Áudio</b><div><small>Grave ou escolha um áudio (mp3, m4a, wav, ogg...)</small></div><button id=vz-rec class=r>● Gravar</button><button id=vz-file>Escolher arquivo</button><input id=vz-in type=file accept="audio/*,.mp3,.m4a,.wav,.ogg,.opus,.aac,.webm,.amr" hidden><div id=vz-sel><small>Nenhum áudio ainda</small></div><div id=vz-act style=display:none><button id=vz-ask class=r>Mandar pra BIZIVA</button><div style=margin-top:8px><small>ou salvar pra IA usar no funil:</small><select id=vz-int>'+Object.entries(I).map(([k,v])=>'<option value='+k+'>'+v+'</option>').join('')+'</select><input id=vz-lab type=text maxlength=60 placeholder="Pra que serve? (ex.: garantia)"><select id=vz-fn><option value="">Todos os funis</option>'+F.map(f=>'<option value="'+f.id+'">'+String(f.name).replace(/[<&"]/g,'')+'</option>').join('')+'</select><button id=vz-save>Salvar no funil</button></div></div><div id=vz-m style="margin:6px 0;color:#b00"></div><div><b style=font-size:13px>Áudios do funil ('+C.length+')</b>'+C.map(c=>'<div class=c>'+(I[c.intent]||c.intent)+(c.label?' · '+String(c.label).replace(/[<&]/g,''):'')+' <small>'+(c.funnelId?(F.find(f=>f.id===c.funnelId)?.name||'funil'):'todos os funis')+'</small><br><small>'+String(c.transcript||'').slice(0,90).replace(/[<&]/g,'')+'</small> <button data-del="'+c.id+'">Remover</button></div>').join('')+'</div>';
$('#vz-rec').onclick=toggle;$('#vz-file').onclick=()=>$('#vz-in').click();$('#vz-in').onchange=e=>{const f=e.target.files[0];if(f)pick(f,f.name)};$('#vz-ask').onclick=ask;$('#vz-save').onclick=save;p.querySelectorAll('[data-del]').forEach(x=>x.onclick=async()=>{await fetch('/api/voice-clips?id='+x.dataset.del,{method:'DELETE',credentials:'include'});load()});}
function pick(bl,name){blob=bl;blob.__n=name||'gravacao.webm';$('#vz-sel').innerHTML='<audio controls style=width:100%></audio>';$('#vz-sel audio').src=URL.createObjectURL(bl);$('#vz-act').style.display='';msg('')}
async function toggle(){if(rec){rec.stop();return}try{const s=await navigator.mediaDevices.getUserMedia({audio:true});const ch=[];rec=new MediaRecorder(s);rec.ondataavailable=e=>e.data.size&&ch.push(e.data);rec.onstop=()=>{s.getTracks().forEach(t=>t.stop());const bl=new Blob(ch,{type:rec.mimeType||'audio/webm'});rec=null;$('#vz-rec').textContent='● Gravar';pick(bl,'gravacao.'+(/mp4/.test(bl.type)?'m4a':'webm'))};rec.start();$('#vz-rec').textContent='■ Parar'}catch{msg('O microfone não ficou disponível.')}}
function fd(){const f=new FormData();f.append('file',blob,blob.__n);return f}
function composer(){const a=[...document.querySelectorAll('textarea')].filter(t=>t.offsetParent&&!p.contains(t));return a[a.length-1]}
async function ask(){msg('Transcrevendo...');const r=await fetch('/api/voice-clips/transcribe',{method:'POST',body:fd(),credentials:'include'});const j=await r.json().catch(()=>({}));if(!r.ok)return msg(j.error||'Não deu certo.');const t=composer();if(!t){navigator.clipboard?.writeText(j.text);return msg('Abra o chat da BIZIVA. Copiei o texto: '+j.text)}
const set=Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set;set.call(t,j.text);t.dispatchEvent(new Event('input',{bubbles:!0}));setTimeout(()=>{const f=t.closest('form');const btn=f&&f.querySelector('button[type=submit]');if(btn)btn.click();else t.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',code:'Enter',keyCode:13,bubbles:!0}))},60);p.style.display='none';blob=null}
async function save(){const f=fd();f.append('intent',$('#vz-int').value);f.append('label',$('#vz-lab').value);f.append('funnelId',$('#vz-fn').value);msg('Salvando...');const r=await fetch('/api/voice-clips',{method:'POST',body:f,credentials:'include'});const j=await r.json().catch(()=>({}));if(!r.ok)return msg(j.error||'Não deu certo.');blob=null;await load();msg('');}
b.onclick=()=>{const o=p.style.display==='block';p.style.display=o?'none':'block';if(!o)load()};})();