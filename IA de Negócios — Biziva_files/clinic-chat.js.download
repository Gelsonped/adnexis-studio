(()=>{if(window.__bzClinicPackage)return;window.__bzClinicPackage=true;function mount(){const view=new URLSearchParams(location.search),existing=document.getElementById('bz-clinic-package');if(location.pathname!=='/app'||view.get('system')!=='estetica-laser'||(view.get('view')&&view.get('view')!=='chat')){if(existing)existing.remove();return}const stage=document.querySelector('.chat-stage'),host=stage&&(stage.querySelector('.chat-view')||stage.querySelector('.chat-locked'));if(!host){if(existing)existing.remove();return}if(existing&&existing.parentNode===host)return;if(existing)existing.remove();const card=document.createElement('section');card.id='bz-clinic-package';card.style.cssText='box-sizing:border-box;flex:0 0 auto;align-self:center;width:calc(100% - 24px);min-width:0;min-height:0;height:auto;overflow-wrap:anywhere;padding:14px 16px;margin:12px auto;border:1px solid #f6efdf33;border-radius:12px;max-width:760px;color:#f6efdf;background:#161b23;font:14px/1.5 system-ui';const title=document.createElement('strong');title.textContent='Seu sistema para Estética e Laser';const desc=document.createElement('p');desc.style.cssText='margin:6px 0 12px';desc.textContent='Baixou o pacote? Envie aqui para a IA de Negócios montar seu ambiente de teste.';const download=document.createElement('a');download.href='/sistemas/estetica-laser';download.textContent='Conhecer e baixar';download.style.cssText='color:#f6d5c8;display:inline-flex;align-items:center;min-height:44px';const input=document.createElement('input');input.type='file';input.accept='.txt,text/plain';input.hidden=true;const button=document.createElement('button');button.textContent='Enviar sistema .biziva.txt';button.type='button';button.style.cssText='min-height:44px;max-width:100%;white-space:normal;padding:10px 14px;border-radius:9px;border:0;background:#eac1ae;color:#211815;font-weight:700;cursor:pointer';const result=document.createElement('div');result.setAttribute('role','status');result.style.cssText='margin-top:12px';result.hidden=true;button.onclick=()=>input.click();input.onchange=async()=>{const file=input.files?.[0];if(!file)return;result.hidden=false;if(!file.name.endsWith('.biziva.txt')||file.size>12000){result.textContent='Escolha o arquivo .biziva.txt baixado da Biziva, sem editar.';return}button.disabled=true;result.textContent='Lendo e validando seu pacote…';try{const data=new FormData();data.set('file',file);const upload=await fetch('/api/files',{method:'POST',body:data,credentials:'same-origin'}),f=await upload.json();if(!upload.ok)throw Error(f.error||'Falha ao enviar arquivo.');result.textContent='Montando seu sistema…';const response=await fetch('/api/chat',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({requestId:crypto.randomUUID(),content:'Monte minha clínica com este pacote.',fileId:f.id})}),r=await response.json();if(!response.ok)throw Error(r.error||'Não foi possível confirmar a instalação.');const match=String(r.content||'').match(new RegExp('/app/clinica[?]id=cln_[a-f0-9]{32}'));if(!match)throw Error('A instalação não devolveu um link confirmado.');result.replaceChildren();const message=document.createElement('p');message.textContent='IA de Negócios: seu sistema de demonstração foi montado. A conversa foi salva no histórico. Nenhuma cobrança ou conexão de WhatsApp ocorreu.';const link=document.createElement('a');link.href=match[0];link.textContent='Abrir minha clínica e testar →';link.style.cssText='color:#f6d5c8;font-weight:700';result.append(message,link);}catch(e){result.textContent=e.message}finally{button.disabled=false;input.value=''}};const actions=document.createElement('div');actions.style.cssText='display:flex;align-items:center;gap:8px 16px;flex-wrap:wrap';actions.append(download,button);card.append(title,desc,actions,input,result);host.prepend(card)}new MutationObserver(mount).observe(document.body,{childList:true,subtree:true});addEventListener('popstate',mount);mount();})();