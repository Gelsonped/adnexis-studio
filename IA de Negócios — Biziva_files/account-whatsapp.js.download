window.__bizivaContactCard="<section id=\"biziva-contact-profile\" class=\"settings-card\"><h2>WhatsApp de contato</h2><p>Este número é para atendimento e avisos da sua conta. A conexão do WhatsApp de vendas é configurada separadamente.</p><form data-contact-form><label>WhatsApp<input name=\"whatsapp\" type=\"tel\" inputmode=\"tel\" autocomplete=\"tel\" maxlength=\"64\" placeholder=\"+55 11 99999-9999\" aria-describedby=\"contact-profile-wa-note\"></label><small id=\"contact-profile-wa-note\" style=\"display:block;margin:10px 0 16px\">Ao confirmar seu número, você autoriza boas-vindas, ajuda e avisos da sua conta pelo WhatsApp da Biziva, terminado em 1142. Para parar, responda SAIR.</small><p data-contact-state role=\"status\">Carregando…</p><button type=\"submit\" class=\"button primary\">Salvar WhatsApp</button><button type=\"button\" class=\"button\" data-contact-confirm>Confirmar no WhatsApp</button><p><a data-contact-link target=\"_blank\" rel=\"noopener noreferrer\" hidden>Abrir WhatsApp e enviar confirmação</a></p></form></section>";
(()=>{
let seq=0,card=null,bannerChecked=false;const endpoint='/api/account-whatsapp';
async function api(body){const r=await fetch(endpoint,{method:body?'POST':'GET',credentials:'same-origin',cache:'no-store',headers:body?{'content-type':'application/json'}:{},...(body?{body:JSON.stringify(body)}:{})});const j=await r.json();if(!r.ok)throw Object.assign(Error(j.error||'Não foi possível concluir.'),{status:r.status});return j;}
function status(r){return !r.whatsapp?'Seu WhatsApp ainda não foi informado.':r.whatsappVerified?(r.whatsappConsent?'WhatsApp confirmado e mensagens autorizadas.':'WhatsApp confirmado. Mensagens desativadas.'):'Número salvo. A confirmação pelo WhatsApp é opcional; você já pode usar a Biziva normalmente.';}
function bind(el){const own=++seq,form=el.querySelector('form'),phone=form.elements.whatsapp,state=form.querySelector('[data-contact-state]'),link=form.querySelector('[data-contact-link]'),confirm=form.querySelector('[data-contact-confirm]');let pending=false,dirty=false,failed=false,pairingAvailable=false;
 const live=()=>own===seq&&el.isConnected;const clear=()=>{link.hidden=true;link.removeAttribute('href');};phone.oninput=()=>{dirty=true;clear()};
 const fill=r=>{dirty=false;failed=false;phone.value=r.whatsapp;if(typeof r.pairingAvailable==='boolean')pairingAvailable=r.pairingAvailable;confirm.disabled=pending||!pairingAvailable;state.textContent=r.whatsapp&&!r.whatsappVerified&&!pairingAvailable?'A confirmação do WhatsApp de contato está temporariamente indisponível. Seu número continua salvo. Isso não altera a conexão do WhatsApp de vendas.':status(r);if(r.whatsappVerified){clear();document.getElementById('biziva-contact-reminder')?.remove();}};
 api().then(r=>{if(live())fill(r)}).catch(e=>{if(live())state.textContent=e.message});
 async function run(pair){if(pending||pair&&!pairingAvailable)return;pending=true;[...form.querySelectorAll('button')].forEach(b=>b.disabled=true);clear();try{const r=await api({action:'save',whatsapp:phone.value});if(!live())return;fill(r);if(pair){const p=await api({action:'pair'});if(!live())return;link.href=p.url;link.hidden=false;state.textContent='Envie a mensagem pronta pelo WhatsApp informado. A confirmação expira em 10 minutos.';}}catch(e){if(live()){failed=true;state.textContent=pair&&e.status===503?'A confirmação pelo WhatsApp está pausada no momento e não é obrigatória. Seu número ficou salvo e você já pode usar a Biziva normalmente.':e.message;}}finally{pending=false;if(live()){[...form.querySelectorAll('button')].forEach(b=>b.disabled=false);confirm.disabled=!pairingAvailable;}}}
 form.onsubmit=e=>{e.preventDefault();run(false)};confirm.onclick=()=>run(true);
 const onFocus=()=>{if(live()&&!pending&&!dirty)api().then(r=>{if(live()&&!pending&&!dirty&&document.activeElement!==phone)fill(r)}).catch(()=>{})};window.addEventListener('focus',onFocus);el._contactCleanup=()=>{window.removeEventListener('focus',onFocus);clear();};
}
function sync(){const standalone=document.querySelector('[data-contact-page]'),settings=new URLSearchParams(location.search).get('view')==='settings',host=standalone||settings&&document.querySelector('.workspace-content');if(!host){if(card){seq++;card._contactCleanup?.();card.remove();card=null;}const app=document.querySelector('.workspace-content');if(app&&!bannerChecked){bannerChecked=true;api().then(r=>{if(!app.isConnected||!r.whatsapp||r.whatsappVerified||r.pairingAvailable!==true||document.getElementById('biziva-contact-reminder'))return;const note=document.createElement('section');note.id='biziva-contact-reminder';note.className='settings-card';const text=document.createElement('p');text.textContent='Confirme seu WhatsApp para receber atendimento e avisos da sua conta.';const a=document.createElement('a');a.href='/app?view=settings#biziva-contact-profile';a.className='button primary';a.textContent='Confirmar meu WhatsApp';note.append(text,a);app.prepend(note)}).catch(()=>{})}return;}if(card&&card.isConnected)return;if(card)card._contactCleanup?.();card=document.createElement('div');card.innerHTML=window.__bizivaContactCard;host.appendChild(card);bind(card);}
const refreshReminder=()=>{bannerChecked=false;document.getElementById('biziva-contact-reminder')?.remove();sync()};addEventListener('focus',refreshReminder);document.addEventListener('visibilitychange',()=>{if(!document.hidden)refreshReminder()});
let queued=false;new MutationObserver(()=>{if(queued)return;queued=true;requestAnimationFrame(()=>{queued=false;sync()})}).observe(document.documentElement,{childList:true,subtree:true});addEventListener('popstate',sync);sync();
})();