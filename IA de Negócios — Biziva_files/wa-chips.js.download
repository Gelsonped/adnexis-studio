(function(){if(window.__bzChips)return;window.__bzChips=1;
var st=document.createElement('style');st.textContent='.bzc-card{margin:0 0 18px}.wa-grid>#bzc{margin:0;order:1;align-self:start}.wa-grid>section:nth-child(2):not(#bzc){order:2}.wa-grid.bzc-2col{grid-template-rows:auto 1fr}.wa-grid.bzc-2col>section:first-child{grid-column:1;grid-row:1;align-self:start}.wa-grid.bzc-2col>#bzc{grid-column:1;grid-row:2}.wa-grid.bzc-2col>section:nth-child(2):not(#bzc){grid-column:2;grid-row:1 / span 2}.bzc-list{display:grid;gap:10px;margin-top:12px}.bzc-chip{border:1px solid rgba(245,236,220,.12);border-radius:14px;padding:12px 14px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between}.bzc-chip b{font-size:15px}.bzc-meta{font-size:13px;opacity:.75}.bzc-acts{display:flex;gap:8px;flex-wrap:wrap}.bzc-acts button,.bzc-add{border:0;border-radius:10px;padding:8px 12px;font-weight:600;cursor:pointer;background:rgba(245,236,220,.1);color:inherit}.bzc-add,.bzc-acts .pri{background:#e32636;color:#fff}.bzc-qr{width:100%;text-align:center}.bzc-qr img{width:230px;height:230px;background:#fff;border-radius:12px;padding:8px}.bzc-tag{font-size:12px;padding:2px 8px;border-radius:99px;background:rgba(245,236,220,.1);margin-left:6px}.bzc-tag.on{background:rgba(70,190,110,.2)}.bzc-tag.off{background:rgba(227,38,54,.25)}.bzc-sel{background:transparent;color:inherit;border:1px solid rgba(245,236,220,.2);border-radius:9px;padding:6px}';document.head.appendChild(st);
var D=null,FUN=[],polls={},busy=false;
function api(m,b){return fetch('/api/wa-chips'+(m==='GET'&&b?b:''),{method:m,credentials:'same-origin',headers:{'content-type':'application/json'},body:m==='POST'?JSON.stringify(b):undefined}).then(function(r){return r.json().then(function(j){if(!r.ok){var e=new Error(j.error||'Erro');e.j=j;throw e}return j})})}
function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function brl(c){return 'R$'+(c/100).toFixed(2).replace('.',',')}
function dt(i){try{return new Date(i).toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo'})}catch(e){return ''}}
var SL={unknown:'Verificação indisponível',connected:'Conectado',qr:'Aguardando QR',qr_timeout:'QR expirado',disconnected:'Desconectado',connecting:'Conectando',idle:'Desconectado',blocked:'Bloqueado',logged_out:'Desconectado'};
function host(){if(new URLSearchParams(location.search).get('view')!=='whatsapp')return null;var hs=document.querySelectorAll('.wa-grid h2');for(var i=0;i<hs.length;i++)if(/Conex/.test(hs[i].textContent))return hs[i].closest('.wa-grid');return null}
function chipRow(c){var tag=c.blocked?'<span class="bzc-tag off">'+(c.subStatus==='pending'?'Aguardando pagamento':'Bloqueado')+'</span>':'<span class="bzc-tag '+(c.status==='connected'?'on':'')+'">'+(SL[c.status]||c.status)+'</span>';
 var meta=c.included?'Incluído no plano · conexão no quadro abaixo':(c.subStatus==='pending'?'Pague para liberar o QR Code':c.subStatus==='past_due'?'Mensalidade não paga':(c.autoRenew&&c.subStatus==='active'?'Renova em ':'Ativo até ')+dt(c.paidUntil)+(c.method==='pix'?' · Pix (renovação manual)':''));
 if(c.status==='qr_timeout'&&!c.blocked)meta+=' · O prazo para ler o QR terminou. '+(c.included?'No quadro de conexão abaixo, solicite outro QR e leia pelo celular.':'Toque em Ler QR Code e leia pelo celular.');
 var fsel='';if(c.connectionId&&!c.blocked&&FUN.length){fsel='<select class="bzc-sel" data-fun="'+c.connectionId+'"><option value="">Funil deste chip…</option>'+FUN.map(function(f){return '<option value="'+esc(f.id)+'"'+(f.connection_ids.indexOf(c.connectionId)>=0?' selected':'')+'>'+esc(f.name)+'</option>'}).join('')+'</select>'}
 var a='';if(!c.included){if(c.blocked)a+='<button class="pri" data-pay="'+esc(c.payUrl)+'">'+(c.subStatus==='pending'?'Pagar '+brl(c.payCents||D.priceCents)+(c.packLabel?' · '+esc(c.packLabel):''):'Pagar e desbloquear')+'</button>'+(D.qa?'<button data-act="simulate_pay" data-slot="'+c.slot+'">Simular pagamento (QA)</button>':'');
  else{a+=c.status==='connected'?'<button data-act="disconnect" data-slot="'+c.slot+'">Desconectar</button>':'<button class="pri" data-act="connect" data-slot="'+c.slot+'">Ler QR Code</button>';if(c.method==='pix'||!c.autoRenew)a+='<button data-pay="'+esc(c.payUrl)+'">Renovar</button>';
  a+=c.autoRenew&&c.subStatus==='active'?'<button data-act="cancel_renewal" data-slot="'+c.slot+'">Cancelar renovação</button>':'<button data-act="resume_renewal" data-slot="'+c.slot+'">Reativar renovação</button>';if(D.qa)a+='<button data-act="simulate_expire" data-slot="'+c.slot+'">Simular vencimento (QA)</button>'}
  if(c.subStatus==='pending')a+='<button data-act="cancel_renewal" data-slot="'+c.slot+'">Remover</button>'}
 return '<div class="bzc-chip" data-slot="'+c.slot+'"><div><b>'+esc(c.label)+'</b>'+tag+'<div class="bzc-meta">'+(c.phone?esc(c.phone)+' · ':'')+esc(meta)+'</div></div><div class="bzc-acts">'+fsel+a+'</div><div class="bzc-qr" id="bzc-qr-'+c.slot+'" hidden></div></div>'}
function bzcPlace(g){if(!g)return;g.classList.remove('bzc-2col');var c=getComputedStyle(g).gridTemplateColumns.split(' ').filter(Boolean).length;if(c>=2)g.classList.add('bzc-2col')}
function render(){var g=host();if(!g){var stale=document.getElementById('bzc');if(stale)stale.remove();return}if(!D)return;var el=document.getElementById('bzc');if(!el){el=document.createElement('section');el.id='bzc';el.className='settings-card wa-card bzc-card'}if(el.parentNode!==g)g.appendChild(el);bzcPlace(g)
 var n=D.chips.length,can=n<D.max;el.innerHTML='<div class="wa-card-head"><h2>Chips de WhatsApp</h2><span class="bzc-meta">'+n+'/'+D.max+'</span></div><p class="wa-muted">Conecte até '+D.max+' números. O primeiro está no plano; cada chip extra custa '+brl(D.priceCents)+'/mês. No Prospectar você escolhe o chip ou distribui os envios entre todos. As respostas saem sempre pelo chip da conversa. O mesmo funil pode atender vários chips; cada seleção altera apenas aquele chip.</p><div class="bzc-list">'+D.chips.map(chipRow).join('')+'</div>'+(D.offer?'<button class="bzc-add" id="bzc-pack" style="margin-top:12px;margin-right:8px">Oferta exclusiva · '+D.offer.qty+' chips por '+brl(D.offer.cents)+'/mês</button>':'')+(can?'<button class="bzc-add" id="bzc-add" style="margin-top:12px">+ Adicionar chip · '+brl(D.priceCents)+'/mês</button>':'<p class="wa-muted">Limite de '+D.max+' chips atingido.</p>');
 for(var k in polls)if(polls[k].qr){var q=document.getElementById('bzc-qr-'+k);if(q){q.hidden=false;q.innerHTML='<img alt="QR Code do chip '+k+'" src="'+polls[k].qr+'"><p class="wa-muted">WhatsApp &gt; Aparelhos conectados &gt; Conectar aparelho. O QR muda a cada ~20 s.</p>'}}}
function load(){return Promise.all([api('GET'),fetch('/api/funnel',{credentials:'same-origin'}).then(function(r){return r.ok?r.json():{}}).catch(function(){return{}})]).then(function(a){D=a[0];FUN=(a[1].funnels||[]).map(function(f){return{id:f.id,name:f.name,connection_ids:f.connection_ids||f.connectionIds||[f.connection_id||f.connectionId].filter(Boolean)}});render()}).catch(function(){})}
function poll(slot){if(polls[slot]&&polls[slot].t)return;var n=0;polls[slot]=polls[slot]||{};polls[slot].t=setInterval(function(){if(++n>60){clearInterval(polls[slot].t);delete polls[slot];render();return}api('GET','?part=status&slot='+slot).then(function(s){polls[slot].qr=s.qr;var c=D&&D.chips.find(function(c){return c.slot===slot});if(c)c.status=s.status;if(s.status==='connected'){clearInterval(polls[slot].t);delete polls[slot];load()}else render()}).catch(function(){var c=D&&D.chips.find(function(c){return c.slot===slot});if(c)c.status='unknown';if(polls[slot])polls[slot].qr=null;render()})},3000)}
document.addEventListener('click',function(e){var t=e.target.closest&&e.target.closest('#bzc button');if(!t||busy)return;
 if(t.id==='bzc-pack'){busy=true;api('POST',{action:'add_pack'}).then(function(r){location.href=r.payUrl}).catch(function(x){alert(x.message)}).then(function(){busy=false});return}
 if(t.id==='bzc-add'){busy=true;api('POST',{action:'add'}).then(function(r){location.href=r.payUrl}).catch(function(x){alert(x.message)}).then(function(){busy=false});return}
 if(t.dataset.pay){location.href=t.dataset.pay;return}
 var act=t.dataset.act,slot=+t.dataset.slot;if(!act)return;if(act==='cancel_renewal'&&!confirm('Cancelar a renovação deste chip? Ele continua até o fim do mês pago.'))return;
 busy=true;t.disabled=true;api('POST',{action:act,slot:slot}).then(function(r){if(act==='connect'){polls[slot]={qr:r.qr};poll(slot)}return load()}).catch(function(x){if(x.j&&x.j.payUrl){location.href=x.j.payUrl;return}alert(x.message)}).then(function(){busy=false})});
document.addEventListener('change',function(e){var s=e.target;if(!s.dataset||!s.dataset.fun||busy)return;var old=FUN.find(function(f){return f.connection_ids.indexOf(s.dataset.fun)>=0});if(!s.value&&!old)return;busy=true;s.disabled=true;fetch('/api/funnel',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({action:s.value?'publish':'unpublish_chip',id:s.value||(old&&old.id),connectionId:s.dataset.fun,robot:true})}).then(function(r){return r.json().then(function(j){if(!r.ok&&r.status===409&&s.value&&/^Antes de publicar/.test(j.error||'')&&confirm((j.error||'')+' Conectar este funil ao chip mesmo assim?'))return fetch('/api/funnel',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({action:'publish',id:s.value,connectionId:s.dataset.fun,robot:true,force:true})}).then(function(r2){return r2.json().then(function(j2){if(!r2.ok)throw new Error(j2.error||'Erro');return load()})});if(!r.ok)throw new Error(j.error||'Erro');return load()})}).catch(function(x){alert(x.message);return load()}).finally(function(){busy=false;s.disabled=false})});
var last='';setInterval(function(){var g=host();if(!g){var stale=document.getElementById('bzc');if(stale)stale.remove();last='';return}bzcPlace(g);if(!document.getElementById('bzc')){if(D)render();if(last!==location.search){last=location.search;load()}}},800);
})();
(function(){if(window.__bzAiBlk)return;window.__bzAiBlk=1;var L=[],busy=false;
function api(m,b){return fetch('/api/wa-ai-block',{method:m,credentials:'same-origin',headers:{'content-type':'application/json'},body:b?JSON.stringify(b):undefined}).then(function(r){return r.json().then(function(j){if(!r.ok)throw new Error(j.error||'Erro');return j})})}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function fmt(p){var d=String(p);return d.length>=12?'+'+d.slice(0,2)+' '+d.slice(2,4)+' '+d.slice(4):d}
function draw(){var h=document.getElementById('bzc');if(!h)return;var c=document.getElementById('bzaib');if(!c){c=document.createElement('div');c.id='bzaib';c.className='card';c.style.marginTop='12px';h.appendChild(c)}
c.innerHTML='<b>Números sem IA</b><div style="opacity:.7;font-size:13px;margin:4px 0 8px">A IA não responde estes números em nenhum chip. Você continua respondendo à mão.</div><div style="display:flex;gap:8px"><input id=bzaib-in placeholder="DDD + número" style="flex:1"><button type=button id=bzaib-add>Bloquear IA</button></div>'+(L.length?'<ul style="margin:8px 0 0;padding-left:18px">'+L.map(function(x){return '<li>'+esc(fmt(x.phone))+' <a href=# data-rm="'+esc(x.phone)+'">liberar</a></li>'}).join('')+'</ul>':'')}
function load(){api('GET').then(function(j){L=dedupe(j.items||[]);draw()}).catch(function(){})}
function dedupe(a){var s={};return a.filter(function(x){var k=String(x.phone);if(/^55\d{2}\d{8}$/.test(k))k=k.slice(0,4)+'9'+k.slice(4);if(s[k])return false;s[k]=1;return true})}
document.addEventListener('click',function(e){var t=e.target;if(!t||busy)return;if(t.id==='bzaib-add'){var v=(document.getElementById('bzaib-in')||{}).value||'';busy=true;api('POST',{action:'add',phone:v}).then(function(j){L=dedupe(j.items||[]);draw()}).catch(function(x){alert(x.message)}).then(function(){busy=false});return}
if(t.dataset&&t.dataset.rm){e.preventDefault();busy=true;api('POST',{action:'remove',phone:t.dataset.rm}).then(function(j){L=dedupe(j.items||[]);draw()}).catch(function(x){alert(x.message)}).then(function(){busy=false})}});
setInterval(function(){if(document.getElementById('bzc')&&!document.getElementById('bzaib')){draw();load()}},1000)})();;(function(){if(window.__bzWaAttendance)return;window.__bzWaAttendance=1;var busy=false,seq=0,controller,last=0,items=null;
var style=document.createElement('style');style.textContent='#bz-wa-attendance{margin-top:16px;border-top:1px solid #ffffff20;padding-top:14px;max-width:100%;overflow-wrap:anywhere}#bz-wa-attendance h3{font-size:16px;margin:0 0 8px}#bz-wa-attendance p{font-size:13px;line-height:1.5;margin:5px 0}#bz-wa-attendance ul{padding-left:20px;font-size:13px;line-height:1.5}#bz-wa-attendance .bz-wa-note{border-left:3px solid #e32636;padding:6px 12px;margin:10px 0}';document.head.appendChild(style);
function host(){return new URLSearchParams(location.search).get('view')==='whatsapp'?document.getElementById('bzc'):null}
function draw(){var h=host();if(!h||!items)return;var prior=document.getElementById('bz-wa-attendance');if(prior)prior.remove();var box=document.createElement('div');box.id='bz-wa-attendance';box.setAttribute('role','status');var title=document.createElement('h3');title.textContent='Verificação do atendimento';box.appendChild(title);var labels={connected:'Conectado',unknown:'Verificação indisponível',qr:'Aguardando QR Code',qr_timeout:'QR Code expirado',disconnected:'Desconectado',logged_out:'Desconectado',idle:'Desconectado',blocked:'Bloqueado',connecting:'Conectando'};(items.chips||[]).forEach(function(c){var row=document.createElement('div');row.className='bz-wa-note';var p=document.createElement('p');p.textContent='Chip '+c.slot+' · '+(labels[c.status]||'Verificando')+(c.funnel?' · '+c.funnel:'');row.appendChild(p);if(c.notices&&c.notices.length){var ul=document.createElement('ul');c.notices.forEach(function(n){var li=document.createElement('li');li.textContent=n;ul.appendChild(li)});row.appendChild(ul)}if(c.pending&&c.pending.length){var list=document.createElement('ul');c.pending.forEach(function(chat){var li=document.createElement('li');li.textContent=chat.label+' · '+chat.at+(chat.protected?' · pausa/proteção preservada':' · conferir acompanhamento humano');list.appendChild(li)});row.appendChild(list)}box.appendChild(row)});var note=document.createElement('p');note.textContent=items.coverage||'Não foi possível verificar o atendimento agora.';box.appendChild(note);h.appendChild(box)}
function tick(){var h=host();if(!h||document.hidden){if(controller){seq++;controller.abort();controller=null;busy=false}items=null;last=0;var stale=document.getElementById('bz-wa-attendance');if(stale)stale.remove();return}if(items&&!document.getElementById('bz-wa-attendance'))draw();if(busy||Date.now()-last<30000)return;last=Date.now();busy=true;var my=++seq;controller=new AbortController();fetch('/api/wa-chips?part=attention',{credentials:'same-origin',signal:controller.signal}).then(function(r){if(r.status===401){items=null;var x=document.getElementById('bz-wa-attendance');if(x)x.remove();return null}if(!r.ok)throw Error('unavailable');return r.json()}).then(function(j){if(my!==seq||!host()||!j)return;items=j;draw()}).catch(function(e){if(my!==seq||e.name==='AbortError')return;items={chips:[],coverage:'Não foi possível verificar o atendimento agora. As conexões foram preservadas.'};draw()}).finally(function(){if(my===seq){busy=false;controller=null}})}setInterval(tick,1000);tick();})();