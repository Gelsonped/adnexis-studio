(function(){try{var k="bzRenewHide",x=+localStorage.getItem(k)||0;if(Date.now()-x<3*864e5)return}catch(e){}fetch("/api/lancamento/renovacao",{credentials:"same-origin"}).then(function(r){return r.ok?r.json():null}).then(function(j){if(!j||!j.show)return;var put=function(){var m=document.querySelector(".workspace-main");if(!m)return setTimeout(put,400);if(document.getElementById("bz-renew"))return;var d=new Date(j.until),late=d<new Date(),ds=d.toLocaleDateString("pt-BR",{timeZone:"America/Sao_Paulo"});var b=document.createElement("div");b.id="bz-renew";b.setAttribute("role","status");b.innerHTML='<span class="bz-rn-t"></span><a class="bz-rn-a" href="/lancamento/renovar">Ativar renovação automática</a><button class="bz-rn-x" type="button" aria-label="Fechar">×</button>';b.querySelector(".bz-rn-t").textContent=late?"Seu plano terminou.":"Seu plano vale até "+ds+".";b.querySelector(".bz-rn-x").onclick=function(){try{localStorage.setItem("bzRenewHide",String(Date.now()))}catch(e){}b.remove()};m.insertBefore(b,m.firstChild)};var s=document.createElement("style");s.textContent="#bz-renew{display:flex;align-items:center;gap:12px;margin:10px 16px 0;padding:10px 12px 10px 16px;border-radius:14px;background:rgba(204,20,50,.12);border:1px solid rgba(204,20,50,.45);color:#f5ecdc;font-size:14px}#bz-renew .bz-rn-t{flex:1;min-width:0}#bz-renew .bz-rn-a{flex:none;padding:8px 14px;border-radius:999px;background:#cc1432;color:#fff;font-weight:700;font-size:13px;text-decoration:none;white-space:nowrap}#bz-renew .bz-rn-x{flex:none;width:28px;height:28px;border:0;border-radius:999px;background:transparent;color:rgba(245,236,220,.6);font-size:20px;line-height:1;cursor:pointer}@media(max-width:520px){#bz-renew{flex-wrap:wrap;margin:8px 10px 0;font-size:13px}#bz-renew .bz-rn-t{flex:1 1 calc(100% - 40px)}#bz-renew .bz-rn-a{order:3;flex:1 1 100%;text-align:center}}";document.head.appendChild(s);put()}).catch(function(){})})();
fetch("/api/disparos",{credentials:"same-origin"}).then(function(r){dispOn=r.status!==404}).catch(function(){}).then(function(){return fetch("/api/prospect/enabled",{credentials:"same-origin"})}).then(function(r){prospectOn=r.ok}).catch(function(){}).then(function(){addNfse();badges();if(prospectOn)addProspect();var v=viewOf();if(v)render(v)});
