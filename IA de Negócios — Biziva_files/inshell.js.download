// Presentation adapter: keep the original React controls mounted and dispatch
// to their existing actions. Unknown/new features are retained automatically.
(function(){if(window.__bzProductionMenu)return;window.__bzProductionMenu=1;
var sourceActions=new Map(),serial=0,lastSignature='',pending=false,ownerAdminShortcut=false;
function isOwnerAdminShortcut(user){return !!user&&user.id==='usr_F7KKO8M06hliwYonPFNn-g'&&String(user.email||'').trim().toLowerCase()==='matheuslopesmgo@gmail.com'}
fetch('/api/auth',{credentials:'same-origin',cache:'no-store'}).then(function(r){return r.ok?r.json():null}).then(function(j){ownerAdminShortcut=isOwnerAdminShortcut(j&&j.user);lastSignature='';schedule()}).catch(function(){});
var css=`
#workspace-context-sidebar.bz-menu-2026{background:#0d0c10!important;border-right:1px solid #332b32;padding:24px 20px 20px!important;width:310px;max-width:88vw;box-sizing:border-box;overflow-y:auto;scrollbar-width:thin}
#workspace-context-sidebar.bz-menu-2026>.chat-side-nav,#workspace-context-sidebar.bz-menu-2026>.sidebar-bottom{display:none!important}
#workspace-context-sidebar.bz-menu-2026>.chat-side-brand{padding:0 0 25px!important;flex-shrink:0}
#workspace-context-sidebar.bz-menu-2026 .chat-side-home img{width:38px;height:38px;object-fit:contain}
#workspace-context-sidebar.bz-menu-2026 .chat-side-home span{font-size:24px!important;letter-spacing:.15em;text-transform:uppercase}
#bz-menu-2026{display:grid;gap:7px;color:#d5ccd4;padding-bottom:24px}
#bz-menu-2026 *{box-sizing:border-box}#bz-menu-2026 [hidden]{display:none!important}
#bz-menu-2026 :is(button,a){font:inherit;color:inherit;text-decoration:none;border:1px solid transparent;background:transparent;min-height:46px;padding:12px 14px;display:flex;align-items:center;gap:12px;text-align:left;width:100%;border-radius:10px;cursor:pointer;font-size:13px;line-height:1.45;letter-spacing:0;white-space:normal}
#bz-menu-2026 :is(button,a):hover{background:#211b24;color:#fff;border-color:#46363f}
#bz-menu-2026 :is(button,a):focus-visible{outline:2px solid #e7a7b9;outline-offset:2px}
#bz-menu-2026 .bz-menu-featured{border-color:#74404d;background:linear-gradient(120deg,#3e202a,#231a23);padding:17px 14px;margin:0 0 12px;color:#fff1ee}
#bz-menu-2026 .bz-menu-admin-featured{border-color:#e32636;background:linear-gradient(120deg,#5a1524,#301522);color:#fff;font-weight:700;box-shadow:inset 3px 0 #ff5268}#bz-menu-2026 .bz-menu-admin-featured:hover,#bz-menu-2026 .bz-menu-admin-featured[aria-current=page]{background:#671c2e;border-color:#ff5268}
#bz-menu-2026 .bz-menu-api{border-color:#76556a;background:#281e2b;color:#f5e5ef}
#bz-menu-2026 svg{width:19px;height:19px;flex:none;stroke-width:1.6}
#bz-menu-2026 .bz-menu-label{font-size:9px;letter-spacing:.18em;color:#8b7d8a;text-transform:uppercase;padding:19px 14px 8px}
#bz-menu-2026 .bz-menu-heading{font-weight:550;text-transform:none!important}#bz-menu-2026 .bz-menu-heading:after{content:'⌄';margin-left:auto;color:#ab93a6;font-size:17px;transform:rotate(-90deg)}
#bz-menu-2026 .bz-menu-heading[aria-expanded=true]:after{transform:none}
#bz-menu-2026 .bz-menu-children{border-left:1px solid #382c36;margin:5px 0 7px 24px;padding:0 0 0 12px;display:grid;gap:2px}
#bz-menu-2026 .bz-menu-children :is(button,a){min-height:42px;padding:10px 12px;font-size:12px}
#bz-menu-2026 [aria-current=page]{color:#fff;background:#28202a;border-color:#58414f}
#bz-menu-2026 .bz-menu-featured small{background:none!important;padding:0!important;border:0!important;display:block;color:#bca5b2;font-size:10px;margin-top:4px;font-weight:400}
#bz-menu-2026 .bz-menu-soon{font-size:9px;letter-spacing:.06em;color:#a88c75;margin-left:auto}
@media(max-width:900px){#workspace-context-sidebar.bz-menu-2026{width:310px!important;max-width:88vw!important}#bz-menu-2026 :is(button,a){min-height:48px}#bz-menu-2026 .bz-menu-children :is(button,a){min-height:44px}}
@media(prefers-reduced-motion:reduce){#bz-menu-2026 *{transition:none!important}}
`;
var st=document.createElement('style');st.id='bz-menu-2026-css';st.textContent=css;document.head.appendChild(st);
function menuIcon(label){
 var key=String(label||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
 var name=/ia de negocios|criar negocio/.test(key)?'spark':/api/.test(key)?'code':/assinatura/.test(key)?'card':/dashboard|painel de vendas/.test(key)?'chart':/indique|indicac/.test(key)?'gift':/produt|oferta/.test(key)?'package':/ligac|telefone|canais/.test(key)?'phone':/conectar whatsapp/.test(key)?'qr':/whatsapp/.test(key)?'message':/instagram|direct/.test(key)?'instagram':/prospectar/.test(key)?'target':/disparo/.test(key)?'send':/funil/.test(key)?'funnel':/agenda/.test(key)?'calendar':/clientes/.test(key)?'users':/conversa|atendimento|chamado/.test(key)?'message':/financeiro|saque|saldo|pix/.test(key)?'wallet':/recebimento|recebedor/.test(key)?'bank':/relatorio|extrato|pedido|nota fiscal|meta/.test(key)?'report':/comiss|afiliad/.test(key)?'gift':/biblioteca|arquivo/.test(key)?'folder':/criativo|social media/.test(key)?'image':/trafego|facebook|anuncio/.test(key)?'megaphone':/admin|liberar acesso|aprovac/.test(key)?'shield':/suporte|ajuda/.test(key)?'help':/historico|em breve|follow-up|recuperac/.test(key)?'clock':/configurac/.test(key)?'sliders':'tools';
 var paths={spark:'<path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z"/><path d="M20 3v4M18 5h4"/>',code:'<path d="m8 6-6 6 6 6M16 6l6 6-6 6M14 3l-4 18"/>',card:'<rect x="2" y="4" width="20" height="16" rx="3"/><path d="M2 9h20M6 15h4"/>',chart:'<path d="M3 3v18h18M7 16v-5M12 16V7M17 16v-8"/>',gift:'<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12M12 8H7.5A2.5 2.5 0 1 1 10 5.5Zm0 0h4.5A2.5 2.5 0 1 0 14 5.5Z"/>',package:'<path d="m3 7 9-5 9 5v10l-9 5-9-5ZM3 7l9 5 9-5M12 12v10M7.5 4.5l9 5"/>',phone:'<path d="M22 16.9v3a2 2 0 0 1-2.2 2A20 20 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/>',qr:'<rect x="3" y="3" width="6" height="6" rx="1"/><rect x="15" y="3" width="6" height="6" rx="1"/><rect x="3" y="15" width="6" height="6" rx="1"/><path d="M15 15h3v3h3v3h-6ZM12 3v2M12 9v3H3M12 15v6M18 12h3"/>',message:'<path d="M21 11.5a8.5 8.5 0 0 1-12.2 7.6L3 21l1.9-5.8A8.5 8.5 0 1 1 21 11.5Z"/><path d="M8 9h8M8 13h5"/>',instagram:'<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>',target:'<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>',send:'<path d="m22 2-7 20-4-9-9-4ZM22 2 11 13"/>',funnel:'<path d="M3 3h18l-7 9v7l-4 2V12Z"/>',calendar:'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18M8 15h.01M12 15h.01M16 15h.01"/>',users:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/><circle cx="9" cy="7" r="4"/>',wallet:'<path d="M20 8V5a2 2 0 0 0-2-2H5a3 3 0 0 0-3 3v13a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H5a2 2 0 0 1 0-4"/><path d="M22 12h-5v5h5M18 14.5h.01"/>',bank:'<path d="m3 9 9-6 9 6ZM3 21h18M5 9v8M10 9v8M14 9v8M19 9v8M3 18h18"/>',report:'<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M8 13h8M8 17h5"/>',folder:'<path d="M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v3H8l-5 8ZM3 19v1a1 1 0 0 0 1 1h15l3-10"/>',image:'<rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>',megaphone:'<path d="M3 8h5l12-5v16L8 14H3ZM8 8v6l3 7H7l-3-7M22 8v6"/>',shield:'<path d="m12 2 9 4v6c0 5-9 10-9 10S3 17 3 12V6ZM8 12l3 3 5-6"/>',help:'<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="m5.6 5.6 3.6 3.6m5.6 5.6 3.6 3.6m0-12.8-3.6 3.6m-5.6 5.6-3.6 3.6"/>',clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',sliders:'<path d="M3 6h6M13 6h8M3 18h8M15 18h6"/><circle cx="11" cy="6" r="2"/><circle cx="13" cy="18" r="2"/>',tools:'<path d="M14.7 6.3a5 5 0 0 0-6.4 6.4L3 18a2.1 2.1 0 0 0 3 3l5.3-5.3a5 5 0 0 0 6.4-6.4L14 13l-3-3Z"/>'};
 return '<svg data-bz-menu-icon="'+name+'" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">'+paths[name]+'</svg>';
}

function text(el){return (el.querySelector('span')?.textContent||el.textContent||'').replace(/EM BREVE|Em breve/g,'').trim()}
function sources(side){return Array.from(side.querySelectorAll('.chat-side-nav button,.chat-side-nav a,.sidebar-bottom button,.sidebar-bottom a')).filter(function(b){return !b.classList.contains('nav-group-toggle')})}
function esc(s){return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function build(){pending=false;var side=document.getElementById('workspace-context-sidebar');if(!side)return;var brand=side.querySelector('.chat-side-home img');if(brand&&!brand.dataset.bzBrand2026){brand.dataset.bzBrand2026='1';brand.src='data:image/svg+xml;base64,'}var all=sources(side);if(!all.length)return;var sig=String(window.__BZ_METAS)+'|'+String(ownerAdminShortcut)+'|'+all.map(b=>text(b)+'|'+b.getAttribute('data-view')+'|'+b.getAttribute('data-bz-admin')).join(';');
 var existing=document.getElementById('bz-menu-2026');if(sig===lastSignature&&existing){mark();return}lastSignature=sig;sourceActions.clear();var used=new Set();
 function find(sel,label){return all.find(b=>!used.has(b)&&((sel&&b.matches(sel))||(!sel&&text(b)===label)))}
 function row(el,label,cls){if(!el)return '';used.add(el);var id='m'+(++serial);sourceActions.set(id,el);var icon=el.querySelector('svg');return '<button type="button" data-bz-menu-action="'+id+'" class="'+(cls||'')+'">'+menuIcon(label||text(el))+'<span>'+esc(label||text(el))+(cls==='bz-menu-featured'?'<small>Seu chat principal</small>':'')+'</span></button>'}
 function item(sel,label,cls){return row(find(sel,label),label,cls)}
 function group(label,html){if(!html)return '';var id='bz-menu-group-'+label.toLowerCase().replace(/[^a-z]/g,'');var open=false;try{open=sessionStorage.getItem(id)==='1'}catch{}return '<div class="bz-menu-group"><button type="button" class="bz-menu-heading nav-group-toggle" aria-controls="'+id+'" aria-expanded="'+open+'">'+menuIcon(label)+'<span>'+esc(label)+'</span></button><div id="'+id+'" class="bz-menu-children" '+(open?'':'hidden')+'>'+html+'</div></div>'}
 var h=item('[data-view=chat]','IA de Negócios','bz-menu-featured')+'<div class="bz-menu-label">Seu espaço de trabalho</div>'+item('[data-enterprise-entry]','API Empresarial','bz-menu-api')+(ownerAdminShortcut?row(all.find(function(b){return b.getAttribute('data-bz-admin')==='admin'}),'Painel Admin','bz-menu-admin-featured'):'')+item('.bz-sub-fallback','Minha Assinatura')+item('[data-view=dashboard]','Dashboard')+item('[data-view=indicate]','Indique a Biziva')+group('Produtos',item('[data-view=products]','Meus produtos')+item('[data-view=create]','Criar negócio'));
 h+=group('Funil',item('[data-view=whatsapp]','Conectar WhatsApp · QR Code')+item('[data-view=funil]','Funil WhatsApp · criar com IA')+'<a href="/app/funil/canais">'+menuIcon('Funil de ligações')+'<span>Funil de ligações · canais</span></a>'+item('.bz-instagram','Funil Instagram · Direct')+item('.bz-prospect','Prospectar')+item('.bz-disparos','Disparos'));
 h+=item('.bz-agenda','Agenda');
 h+=group('Clientes e conversas',item('[data-view=inbox]','Conversas')+item('.bz-clientes','Clientes')+item('[data-view=followup]','Follow-up')+item('[data-view=recovery]','Recuperação'));
 var fin=find('.bz-fin-item');var finance='';if(fin){used.add(fin);function finrow(label,tab){var id='m'+(++serial);sourceActions.set(id,{source:fin,tab});return '<button type="button" data-bz-menu-action="'+id+'">'+menuIcon(label)+'<span>'+esc(label)+'</span></button>'}finance=finrow('Dados para recebimento','recipient')+finrow('Extrato','statement')+finrow('Saques','withdrawals')}
 h+=group('Financeiro',finance);
 var commissions='';if(fin){var id='m'+(++serial);sourceActions.set(id,{source:fin,tab:'commissions'});commissions='<button type="button" data-bz-menu-action="'+id+'">'+menuIcon('Comissões e Pix')+'<span>Comissões e Pix</span></button>'}
 var metasBtn=(window.__BZ_METAS===1)?'<button type="button" class="bz-metas" data-bz-metas="1">'+menuIcon('Meta')+'<span>Metas</span></button>':'';
 h+=group('Relatórios',item('[data-view=orders]','Pedidos')+commissions+metasBtn);
 h+=group('Ferramentas',item('[data-view=creatives]','Criativos')+item('[data-view=library]','Biblioteca de mídia')+item('[data-view=files]','Meus arquivos')+item('[data-view=approvals]','Aprovações'));
 h+=group('Em breve',item('[data-view=social]','Social Media')+item('[data-view=traffic]','Tráfego Pago')+item('[data-view=ads]','Facebook Ads')+item('[data-view=spy]','Espião de anúncios')+item('[data-view=agency]','Agência')+item('.bz-nfse','Nota Fiscal'));
 h+=group('Admin',all.filter(b=>b.hasAttribute('data-bz-admin')&&!used.has(b)).map(b=>row(b)).join(''));
 h+=group('Suporte',all.filter(b=>!used.has(b)&&(b.classList.contains('bz-sup')||b.classList.contains('bz-cham')||text(b)==='Ajuda')).map(b=>row(b)).join(''));
 h+='<div class="bz-menu-label">Sua conta</div>'+item(null,'Histórico')+item(null,'Configurações');
 h+=group('Mais ferramentas',all.filter(b=>!used.has(b)).map(b=>row(b)).join(''));
 var nav=existing||document.createElement('nav');nav.id='bz-menu-2026';nav.setAttribute('aria-label','Menu principal Biziva');nav.innerHTML=h;if(!existing)side.insertBefore(nav,side.querySelector('.chat-side-nav'));side.classList.add('bz-menu-2026');mark();
}
function mark(){document.querySelectorAll('[data-bz-menu-action]').forEach(function(b){var x=sourceActions.get(b.dataset.bzMenuAction),o=x?.source||x,active=o?.getAttribute('aria-current')==='page'||o?.classList.contains('active');var view=new URLSearchParams(location.search).get('view')||'chat';var target=o?.getAttribute('data-view');if(target)active=target===view;else if(o?.hasAttribute('data-bz-admin'))active=view==='admin';if(x?.tab)active=x.tab==='recipient'?view==='recebimento':view==='financeiro'&&!!document.querySelector('[data-fin-tab="'+x.tab+'"][aria-selected="true"]');if(o?.hasAttribute('data-enterprise-entry'))active=view==='api';if(active)b.setAttribute('aria-current','page');else b.removeAttribute('aria-current')})}
function schedule(){if(pending)return;pending=true;requestAnimationFrame(build)}
document.addEventListener('click',function(e){var nav=e.target.closest?.('#bz-menu-2026');if(!nav)return;var b=e.target.closest('button');if(!b)return;e.preventDefault();e.stopImmediatePropagation();if(b.classList.contains('bz-menu-heading')){var open=b.getAttribute('aria-expanded')!=='true';b.setAttribute('aria-expanded',String(open));document.getElementById(b.getAttribute('aria-controls')).hidden=!open;try{sessionStorage.setItem(b.getAttribute('aria-controls'),open?'1':'0')}catch{}return}var action=sourceActions.get(b.dataset.bzMenuAction);if(!action)return;var source=action.source||action;if(!source.isConnected){lastSignature='';schedule();return}source.click();if(action.tab){var tries=0;function select(){var target=action.tab==='recipient'?document.getElementById('bzfin-rc'):document.querySelector('[data-fin-tab="'+action.tab+'"]');if(target)target.click();else if(++tries<30)setTimeout(select,100)}select()}schedule();
},true);
new MutationObserver(function(changes){if(changes.every(c=>c.target.closest?.('#bz-menu-2026')))return;schedule()}).observe(document.documentElement,{childList:true,subtree:true});window.addEventListener('popstate',schedule);build();
})();
